@page
@{ 
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>管理中心</title>
    <meta name="admin center" content="admin center" />
    <link href="~/assets/css/pace.css" rel="stylesheet" />
    <script data-pace-options='{ "ajax": true, "document": true, "eventLag": false, "elements": false }' src="~/assets/js/pace.min.js"></script>
    <!-- css -->
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/assets/css/ace-fonts.min.css" rel="stylesheet" />
    <link href="~/assets/css/ace.min.css" rel="stylesheet" class="ace-main-stylesheet" />
    <link href="~/site/site.css" rel="stylesheet" />
</head>
<body class="no-skin">
    @await Html.PartialAsync("shared/_pagenavbar")

    <div class="main-container" id="main-container">
        @await Component.InvokeAsync("Menu")
        <div class="main-content">
            <div class="main-content-inner">
                <div class="breadcrumbs" id="breadcrumbs">
                    <ul class="breadcrumb">
                        <li>
                            <i class="ace-icon fa fa-home home-icon"></i>
                        </li>
                    </ul><!-- /.breadcrumb -->
                    <a href="javascript:location.reload();" data-action="reload">
                        <i class="ace-icon fa fa-refresh"></i>
                    </a>
                </div>
                <div class="page-content">
                    <div class="page-content-area" data-ajax-content="true">
                        <!-- ajax content goes here -->
                    </div>
                </div>
            </div>
        </div>
        @await Html.PartialAsync("shared/_pagefooter")
    </div>
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/ace-elements.js"></script>
    <script src="~/assets/js/ace.js"></script>
    <script src="~/site/site.js"></script>
</body>
</html>