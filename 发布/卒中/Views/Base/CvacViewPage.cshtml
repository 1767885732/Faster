@{
    Layout = null;
}
@using DoCare.Framework.Extension
@using DoCare.ToolKit
@*@model DoCare.CVA.Data.CvacElectronicMedicalRecord*@
<title>患者病案信息</title>

<link href="~/App_Themes/Default/global.css" rel="stylesheet" />
<link href="~/App_Themes/Default/control.css" rel="stylesheet" />
<link href="~/App_Themes/Default/frame.css" rel="stylesheet" />
<link href="~/App_Themes/Default/page.timeline.css" rel="stylesheet" />
<link href="~/App_Themes/Default/page.history.css" rel="stylesheet" />

<script src="~/Scripts/angular/angular.min.js"></script>
<script src="~/Scripts/filterModule.js"></script>
<script src="~/Scripts/directiveModule.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/hover.js"></script>

<script>
    var Model =  @Html.Raw(JsonKit.Serialize(Model));
    $(function () {
        var app = angular.module('ngAppCvac', ['mdsdFilter', 'mdsdDirective']);
        app.controller('ngCvacCtrl', function ($scope) {
            $scope.model = Model;
            $scope.patientRegist = Model.PatientRegist;
            $scope.preHospital = Model.PreHospital;
            $scope.emergency = Model.Emergency;
            $scope.treatment = Model.Treatment;
            $scope.inhospitalTreatment = Model.InhospitalTreatment;
            $scope.Outcome = Model.Outcome;
            $scope.examinations = Model.Examinations;
            $scope.inspections = Model.Inspections;
            $scope.medications = Model.Medications;
            $scope.operations = Model.Operations;

            $scope.GetIatTreatmentDesc = function () {
                var desc = "";
                if ($scope.treatment.PatientTreatment.IatTreatment[0]) {
                    desc += "[支架取栓]";
                }
                if ($scope.treatment.PatientTreatment.IatTreatment[1]) {
                    desc += "[动脉溶栓]";
                }
                if ($scope.treatment.PatientTreatment.IatTreatment[2]) {
                    desc += "[动脉碎栓]";
                }
                if ($scope.treatment.PatientTreatment.IatTreatment[3]) {
                    desc += "[抽吸导管]";
                }
                return desc;
            }

            $scope.GetOtherDrugDesc = function () {
                var desc = "";
                if ($scope.treatment.PatientTreatment.OtherDrug[0]) {
                    desc += "[替罗非班]";
                }
                if ($scope.treatment.PatientTreatment.OtherDrug[1]) {
                    desc += "[抗凝药]";
                }
                if ($scope.treatment.PatientTreatment.OtherDrug[2]) {
                    desc += "[抗血小板药物]";
                }
                return desc;
            }
        });
        angular.bootstrap($("#case")[0], ['ngAppCvac']);
    });
</script>

<body>
    <div id="case" class="case" ngAppCvac" ng-controller="ngCvacCtrl">
        <div class="toolbar">
            <a class="print" title="打印" onclick="return printView();"></a>
            @*<a class="update" title="上报"></a>
                <a class="examine" title="审核"></a>*@
        </div>
        @*患者登记*@
        <div class="column">
            <div class="tit subNav">
                <h3>患者登记信息</h3>
            </div>
            <div class="content navContent">
                <dl>
                    <dt>医院</dt>
                    <dd>{{patientRegist.OrgName}}</dd>
                </dl>
                <dl>
                    <dt>患者姓名</dt>
                    <dd>{{patientRegist.Name}}</dd>
                </dl>
                <dl>
                    <dt>患者年龄</dt>
                    <dd>{{patientRegist.Age}}</dd>
                </dl>
                <dl>
                    <dt>性别</dt>
                    <dd>{{patientRegist.Gender}}</dd>
                </dl>
                <dl>
                    <dt>登记日期</dt>
                    <dd>{{patientRegist.RegistDate | date:'yyyy-MM-dd HH:mm'}}</dd>
                </dl>
                <dl>
                    <dt>患者身份证号</dt>
                    <dd>{{patientRegist.IdcardNo}}</dd>
                </dl>
                <dl>
                    <dt>市民卡号</dt>
                    <dd>{{patientRegist.CitizenCardNo}}</dd>
                </dl>
                <dl>
                    <dt>联系电话</dt>
                    <dd>{{patientRegist.Phone}}</dd>
                </dl>
                <dl>
                    <dt>门诊号</dt>
                    <dd>{{patientRegist.ClinicNo}}</dd>
                </dl>
                <dl>
                    <dt>住院号</dt>
                    <dd>{{patientRegist.MrNo}}</dd>
                </dl>
                <dl>
                    <dt>发病时间/末次正常时间</dt>
                    <dd>{{patientRegist.DiseaseTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                </dl>
                <dl>
                    <dt>发病地址</dt>
                    <dd>{{patientRegist.AttackAddress}}</dd>
                </dl>
                <dl>
                    <dt>来院方式</dt>
                    <dd>{{patientRegist.ComingType}}</dd>
                </dl>
            </div>
        </div>
        @*时间轴*@
        <div class="column">
            <div class="tit subNav">
                <h3>患者就诊活动时间数据集</h3>
            </div>
            <div class="time navContent">
                <ul>
                    <li>时间节点</li>
                    <li>发生时间</li>
                    <li>实际时长</li>
                </ul>
                <div class="time-lines">
                    <div class="time-details">
                        @for (int i = 0; i < Model.timelineModel.timeline.Nodes.Count; i++)
                        {
                            var node = Model.timelineModel.timeline.Nodes[i];
                            var node_pre = i == 0 ? null : Model.timelineModel.timeline.Nodes[i - 1];
                            bool isNewDay = (node_pre == null) || (node.Value == null) || (node_pre.Value == null) || (node.Value.Value.Year != node_pre.Value.Value.Year || node.Value.Value.Month != node_pre.Value.Value.Month || node.Value.Value.Day != node_pre.Value.Value.Day);
                            <dl class="@(node.IsKeyNode ? "material-time" : "")">
                                <dt>@node.Name</dt>
                                <dd>@node.GetTime()</dd>
                                @if (i != 0)
                                {
                                    <dd>@Math.Round(Model.timelineModel.timeline.BackwardOffset(node.Key).TotalMinutes, 0)</dd>
                                }
                                @if (isNewDay)
                                {
                                    <dd class="date">@node.GetDayOfMonth()</dd>
                                }
                            </dl>
                        }
                    </div>
                </div>
            </div>
        </div>
        @*院前急救*@
        <div class="column" ng-show="preHospital != null">
            <div class="tit subNav">
                <h3>院前急救</h3>
            </div>
            <div class="content navContent">
                <dl>
                    <dt>呼救时间</dt>
                    <dd>{{preHospital.PreHospitalAssessment.CallTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                </dl>
                <dl ng-show="patientRegist.ComingType=='2'">
                    <dt>转院出发时间</dt>
                    <dd>{{preHospital.PreHospitalAssessment.DepartureTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                </dl>
                <dl>
                    <dt>医生到达现场时间</dt>
                    <dd>{{preHospital.PreHospitalAssessment.ArrivePatientSideTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                </dl>
                <dl>
                    <dt>120首诊医生</dt>
                    <dd>{{preHospital.PreHospitalAssessment.FmcDoctor}}</dd>
                </dl>
                <dl>
                    <dt>首次医疗接触时间</dt>
                    <dd>{{preHospital.PreHospitalAssessment.FmcTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                </dl>
                <dl>
                    <dt>院前心电图时间</dt>
                    <dd>{{preHospital.PreHospitalAssessment.FmcPhepECGTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                </dl>
                <dl>
                    <dt>心电图诊断时间</dt>
                    <dd>{{preHospital.PreHospitalAssessment.FmcECGDiagnosisTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                </dl>
                <dl>
                    <dt>体温</dt>
                    <dd>{{preHospital.VitalSign.Temperature}}<em>℃</em></dd>
                </dl>
                <dl>
                    <dt>脉搏</dt>
                    <dd>{{preHospital.VitalSign.PulseRate}}<em>次/分钟</em></dd>
                </dl>
                <dl>
                    <dt>呼吸</dt>
                    <dd>{{preHospital.VitalSign.RespiratoryRate}}<em>次/分钟</em></dd>
                </dl>
                <dl>
                    <dt>收缩压</dt>
                    <dd>{{preHospital.VitalSign.Sbp}}<em>mmHg</em></dd>
                </dl>
                <dl>
                    <dt>舒张压</dt>
                    <dd>{{preHospital.VitalSign.Dbp}}<em>mmHg</em></dd>
                </dl>
                <dl>
                    <dt>血氧</dt>
                    <dd>{{preHospital.VitalSign.BloodOxygen}}<em>%</em></dd>
                </dl>
                <dl>
                    <dt>心率</dt>
                    <dd>{{preHospital.VitalSign.HeartRate}}<em>次/分钟</em></dd>
                </dl>
                <dl>
                    <dt>FAST评估</dt>
                    <dd>{{preHospital.Fast}}</dd>
                </dl>
            </div>
        </div>
        @*急诊救治*@
        <div class="column" ng-show="emergency != null">
            <div class="tit subNav">
                <h3>绿通评估</h3>
            </div>
            <div class="content navContent">
                <div class="parent">
                    <div class="level-one">
                        <dl ng-show="patientRegist.ComingType!='4'">
                            <dt>到院时间</dt>
                            <dd>{{emergency.EmergencyTreatment.ArrivedHospitalTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>就诊(挂号)时间</dt>
                            <dd>{{emergency.EmergencyTreatment.RegistrationTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>诊断医生</dt>
                            <dd>{{emergency.EmergencyTreatment.EmergencyDoctor}}</dd>
                        </dl>
                        <dl>
                            <dt>卒中救治专科团队接诊时间</dt>
                            <dd>{{emergency.EmergencyTreatment.StrokeTeamAdmissionTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>进入抢救室时间</dt>
                            <dd>{{emergency.EmergencyTreatment.SalvageTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>开通静脉时间</dt>
                            <dd>{{emergency.EmergencyTreatment.OpenVeinTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>院内首份心电图时间</dt>
                            <dd>{{emergency.EmergencyTreatment.FmcInhospitalECGTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>心电图诊断时间</dt>
                            <dd>{{emergency.EmergencyTreatment.FmcECGDiagnosisTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>心电图诊断描述</dt>
                            <dd>{{emergency.EmergencyTreatment.EcgResult}}</dd>
                        </dl>
                        <dl>
                            <dt>是否通知CT室{{emergency.EmergencyTreatment.BoolNoticeCT}}</dt>
                            <dd>{{emergency.EmergencyTreatment.BoolNoticeCT ? '是' : '否'}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>分诊时间</dt>
                            <dd>{{emergency.EmergencyTreatment.DiagnosisTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>急诊医生到达时间</dt>
                            <dd>{{emergency.EmergencyTreatment.EmergencyDoctorArrivalTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>通知影像学检查时间</dt>
                            <dd>{{emergency.EmergencyTreatment.StrokeTeamAdmissionTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>影像学开单时间</dt>
                            <dd>{{emergency.EmergencyTreatment.CtOpenTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>进入CT室时间</dt>
                            <dd>{{emergency.EmergencyTreatment.CtStartTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>离开CT室时间</dt>
                            <dd>{{emergency.EmergencyTreatment.CtEndTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>影像学报告时间</dt>
                            <dd>{{emergency.EmergencyTreatment.CtResultTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl>
                            <dt>是否出血</dt>
                            <dd>{{emergency.EmergencyTreatment.CtIsHemorrhage == '1' ? '是' : '否'}}</dd>
                        </dl>
                        <dl ng-show="emergency.EmergencyTreatment.TriageResultsList[2] || emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>出血部位</dt>
                            <dd>{{emergency.EmergencyTreatment.DiagnosisType}}</dd>
                        </dl>
                        <dl ng-show="emergency.EmergencyTreatment.TriageResultsList[2] || emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>患者去向</dt>
                            <dd>{{emergency.EmergencyTreatment.OuthosMethod}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>是否通知神经内科</dt>
                            <dd>{{emergency.EmergencyTreatment.BoolNoticeNeurology  ? '是' : '否'}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>进入手术室时间</dt>
                            <dd>{{emergency.EmergencyTreatment.EnterOperatingRoomTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>离开手术室时间</dt>
                            <dd>{{emergency.EmergencyTreatment.LeaveOperatingRoomTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>脑血管造影术</dt>
                            <dd>{{emergency.EmergencyTreatment.CerebralAngiographyTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>尼莫地平预防血管痉挛治疗</dt>
                            <dd>{{emergency.EmergencyTreatment.NimodipineCureType}}</dd>
                        </dl>
                        <dl style="display:none" ng-show="emergency.EmergencyTreatment.NimodipineCureType=='1'">
                            <dt>使用</dt>
                            <dd>每次给药剂量 {{emergency.EmergencyTreatment.NimodipineDose}}<sub>mg，</sub>使用 {{emergency.EmergencyTreatment.NimodipineUsageDays}}<sub>天</sub></dd>
                        </dl>
                        <dl style="display:none" ng-show="emergency.EmergencyTreatment.NimodipineCureType=='2'">
                            <dt>使用</dt>
                            <dd>每次给药剂量{{emergency.EmergencyTreatment.NimodipineDose}}<sub>mg，</sub>频次 {{emergency.EmergencyTreatment.NimodipineFrequency}} 使用 {{emergency.EmergencyTreatment.NimodipineUsageDays}}<sub>天</sub>
                        </dl>
                        <dl style="display:none">
                            <dt>蛛网膜下腔出血致病原因</dt>
                            <dd ng-show="!emergency.EmergencyTreatment.SahEtiology[3]">{{emergency.EmergencyTreatment.SahEtiology}}</dd>
                            <dd ng-show="emergency.EmergencyTreatment.SahEtiology[3]">{{emergency.EmergencyTreatment.SahEtiologyOther}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>动脉瘤治疗方式</dt>
                            <dd>{{emergency.EmergencyTreatment.AneurysmCureType}} {{emergency.EmergencyTreatment.AneurysmCureTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl style="display:none">
                            <dt>脑脊液分流</dt>
                            <dd>{{emergency.EmergencyTreatment.CsfShuntType}} {{emergency.EmergencyTreatment.CsfShuntTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>血常规开单时间</dt>
                            <dd>{{emergency.EmergencyTreatment.ExamineOpenTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>血常规结果报告时间</dt>
                            <dd>{{emergency.EmergencyTreatment.ExamineResultTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>血凝常规开单时间</dt>
                            <dd>{{emergency.EmergencyTreatment.BloodClotOpenTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>血凝结果报告时间</dt>
                            <dd>{{emergency.EmergencyTreatment.BloodClottingResultTime | date:'yyyy-MM-dd HH:mm'}}</dd>
                        </dl>
                        <dl style="height:52px;max-height:54px;" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>血小板计数</dt>
                            <dd>{{emergency.EmergencyTreatment.PlateletCount}}<em>*10<sup>9</sup>/L</em></dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>PT</dt>
                            <dd>{{emergency.EmergencyTreatment.PtResult}}<em>s</em></dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>APTT</dt>
                            <dd>{{emergency.EmergencyTreatment.ApttResult}}<em>s</em></dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>INR</dt>
                            <dd>{{emergency.EmergencyTreatment.InrResult}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>血糖</dt>
                            <dd>{{emergency.EmergencyTreatment.FingertipBloodSugar}}<em>mmol/L</em></dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>主诉</dt>
                            <dd>{{emergency.EmergencyTreatment.ChiefComplaint}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>现病史</dt>
                            <dd>{{emergency.EmergencyTreatment.HistoryPresentIllness}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>个人史</dt>
                            <dd>{{emergency.EmergencyTreatment.PersonalHistories}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]" style="width:100%">
                            <dt>既往史</dt>
                            <dd>{{emergency.EmergencyTreatment.PastMedicalHistories}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>是否使用抗血小板药物</dt>
                            <dd>{{emergency.EmergencyTreatment.IsAntiplatelet=='1'?'是':'否'}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsAntiplatelet=='1'">
                            <dt>抗血小板药物</dt>
                            <dd>{{emergency.Antiplatelet}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsAntiplatelet=='0'">
                            <dt>未用药原因</dt>
                            <dd>{{emergency.EmergencyTreatment.NotUseReasonAntiplatelet}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>是否使用抗凝药物</dt>
                            <dd>{{emergency.EmergencyTreatment.IsAnticoagulation=='1'?'是':'否'}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsAnticoagulation=='1'">
                            <dt>抗凝药物</dt>
                            <dd>{{emergency.Anticoagulant}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsAnticoagulation=='0'">
                            <dt>未用药原因</dt>
                            <dd>{{emergency.EmergencyTreatment.NotUseReasonAnticoagulation}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>是否使用降压药物</dt>
                            <dd>{{emergency.EmergencyTreatment.IsAntihypertensive=='1'?'是':'否'}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsAntihypertensive=='1'">
                            <dt>降压药物</dt>
                            <dd>{{emergency.Hypotensive}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsAntihypertensive=='0'">
                            <dt>未用药原因</dt>
                            <dd>{{emergency.EmergencyTreatment.NotUseReasonAntihyperten}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>是否使用降糖药物</dt>
                            <dd>{{emergency.EmergencyTreatment.IsHypoglycemic=='1'?'是':'否'}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsHypoglycemic=='1'">
                            <dt>降糖药物</dt>
                            <dd>{{emergency.Hypoglycemic}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsHypoglycemic=='0'">
                            <dt>未用药原因</dt>
                            <dd>{{emergency.EmergencyTreatment.NotUseReasonHypoglycemic}}</dd>
                        </dl>
                        <dl ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3]">
                            <dt>是否使用调脂药物</dt>
                            <dd>{{emergency.EmergencyTreatment.IsLipidmodulation=='1'?'是':'否'}}</dd>
                        </dl>
                        <dl style="width:75%" ng-show="!emergency.EmergencyTreatment.TriageResultsList[2] && !emergency.EmergencyTreatment.TriageResultsList[3] && emergency.EmergencyTreatment.IsLipidmodulation=='1'">
                            <dt>调脂药物</dt>
                            <dd>{{emergency.LipidRegulating}}</dd>
                        </dl>
