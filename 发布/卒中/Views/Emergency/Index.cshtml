                                    var patient = JSON.parse($("#Patient").val());
                                    var maskIndex = layer.load();
                                    $.post("/DataManage/BindPatient", {ehrId:$scope.Regist.EhrId,Patient:patient}, function (result) {
                                        if (result.IsSuccess) {
                                            layer.close(maskIndex); // 关闭等待层
