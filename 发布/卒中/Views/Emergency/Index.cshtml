<script type="text/javascript">
    // 初始化用
    var model = @Html.Raw(JsonKit.Serialize(Model));
    var PermissionSave = @Html.Raw((JsonKit.Serialize(ViewBag.PermissionSave)));
    var compare = function (prop) {
        return function (obj1, obj2) {
            var val1 = obj1[prop];
            var val2 = obj2[prop];
            if (!isNaN(Number(val1)) && !isNaN(Number(val2))) {
                val1 = Number(val1);
                val2 = Number(val2);
            }
            if (val1 < val2) {
                return -1;
            } else if (val1 > val2) {
                return 1;
            } else {
                return 0;
            }
        }
    }
    $(function () {
        // 所有时间控件，失去焦点后执行校验方法，校验通过后更新时间轴对应节点
        $("[timeId]").blur(function () {
            if (validator.validateElement($(this))) {
                var timeIdElement = $("#" + $(this).attr("timeId"));
                var dataName = timeIdElement.attr("data-desp");
                var t = $(this).val();
                if (t) {
                    t = t.replace('T', " ");
                    t = t.substr(0, 10);
                } else {
                    t = "";
                }
                timeIdElement.attr("title", dataName + ":" + t);
                timeIdElement.attr("data-value", $(this).val());
                timeIdElement.find("i").html($(this).val());
            }
        });

        // 初始化校验器
        var validator = new MDEValidator("@Model.Regist.Id", "Emergency", $("#divEmergency"));
