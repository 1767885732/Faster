            // 存放键值对象的Array扩展方法 Start
            Array.prototype.ContainsItem = function (id) {
                var idArray = [];
                for (var i = this.length - 1; i >= 0; i--) {
                    idArray.push(this[i].Key);
                }

                return idArray.indexOf(id) >= 0;
            }

            Array.prototype.GetItem = function (id) {
                var idArray = [];
                for (var i = 0; i < this.length; i++) {
                    idArray.push(this[i].Key);
                }

                if (idArray.indexOf(id) >= 0) {
                    return this[idArray.indexOf(id)];
                } else {
                    return null;
                }
            }

            Array.prototype.RemoveItem = function (id) {
                var idArray = [];
                for (var i = 0; i < this.length; i++) {
                    idArray.push(this[i].Key);
                }

                if (idArray.indexOf(id) >= 0) {
                    this.splice(idArray.indexOf(id), 1)
                }
            }

            function KeyValueItem(key, value) {
                this.Key = key;
                this.Value = value;
            }
            // 存放键值对象的Array扩展方法 End

            var getItemArray = function (array, name) {
                var newArray = [];
                for (var item in array) {
                    if (array[item].Name == name) {
                        newArray.push(new KeyValueItem(array[item].Key, array[item].Value));
                    }
                }
                return newArray;
            };

