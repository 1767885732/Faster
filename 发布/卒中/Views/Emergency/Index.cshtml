            $scope.onRelation = function(source){
                if (!$scope.Regist.EhrId ) {
                    layer.alert('您还未绑定患者，请先进行绑定操作！', { icon: 2 });
                    return;
                }
                $("#IsConfirm").val("0");
                $("#Patient").val("");
                $.post('/DataManage/CreatePatient', { source: source,type:"RelationInpatientNo",name:$scope.Regist.Name }, function (str) {
                    layer.open({
                        type: 1,
                        title: '关联患者',
                        maxmin: false,
                        shadeClose: false, //点击遮罩关闭层
                        area: ['1000px', '480px'],
                        content: str,
                        end: function (index, layero) {
                            if($("#IsConfirm").val()=="1"){
