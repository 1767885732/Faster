        function GetMinute(meiosis, minuend) {
            if (meiosis == null || typeof (meiosis) == "undefined" || minuend == null || typeof (minuend) == "undefined") { return 0; }
            else {
                meiosis = new Date(Date.parse(meiosis.replace(/\-/g, "/")));
                minuend = new Date(Date.parse(minuend.replace(/\-/g, "/")));
                var total = (meiosis.getTime() - minuend.getTime()) / 1000/60;
                if (total > 0) { return total; }
                else { return 0; }
            }
        }

        angular.bootstrap($(".content")[0], ["ngEmergency"]);
    });

</script>
<div class="content" ng-app="ngEmergency" ng-controller="EmergencyController">
    <div class="form-tit">
        <a href="">数据管理</a>&gt;&nbsp;绿通评估&nbsp;<span>&#40;注:<b class="bx"></b>必填项&nbsp;<b style='vertical-align: top;color: #F00;'>&#10026;&nbsp;</b>重要项&nbsp;&#41;</span>
        <input type="hidden" id="IsConfirm" value="0">
        <input type="hidden" id="Patient">
        @Html.Partial("../Base/Patient")
        <div class="op-panel">
            <span style="margin:0px 1px;" />
            <button type="button" class="btn-primary" ng-click="Refresh()">同步</button>
            <button type="button" class="btn-primary" ng-if="PermissionSave && !Regist.IsCompleted" ng-click="save()" id="btnSave">保存</button>
            <button type="button" class="btn-primary" ng-if="PermissionSave && !Regist.IsCompleted && Regist.Id" ng-click="complete()" id="btnComplete">提交</button>
            <span style="margin:0px 1px;" />
            @*<button type="button" id="btnLog" onclick="refreshlog()">操作日志</button>*@
        </div>
    </div>

    <form id="divEmergency">
        <fieldset class="medical-record">
            <h4 class="tit-block">主诉及症状</h4>
            <div class="row-box">
                <div class="mr-row-fourth" style="width:100%">
                    <label><b validateSnow="ChiefComplaint"></b>主诉:</label>
                    <input type="text" maxlength="33" name="ChiefComplaint" validateName="ChiefComplaint" ng-model="Emergency.ChiefComplaint">
                </div>
            </div>
            <div class="mr-row">
                <div style="width: 100%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="Symptom"></b>症状：</label><br />
                    <label ng-repeat="x in SymptomDict | orderBy:'Key'">
                        <input name="Symptom" type="checkbox" ng-checked="isSelected($index,Emergency.SymptomList)" ng-click="updateSelection($event,$index,Emergency.SymptomList)" validateName="{{$index == 0 ? 'Symptom' : ''}}">
                        <span>{{x.Value}}</span>
                    </label>
                </div>
            </div>

            <div class="row-box">
                <div class="mr-row-fourth" style="width:100%">
                    <label><b validateSnow="PreliminaryDiagnosis"></b>初步诊断:</label>
                    <input type="text" maxlength="33" name="PreliminaryDiagnosis" validateName="PreliminaryDiagnosis" ng-model="Emergency.PreliminaryDiagnosis">
                </div>
            </div>

            <div class="row-box">
                <div class="mr-row-fourth">
                    <label><b validateSnow="EmergencyDoctor"></b>诊断医生:</label>
                    <input type="text" ng-model="Emergency.EmergencyDoctor" name="EmergencyDoctor" id="EmergencyDoctor" validateName="EmergencyDoctor" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="EmergencyTime"></b>诊断时间:</label>
                    <input type="text" name="EmergencyTime" class="datetime" validateName="EmergencyTime" ng-model="Emergency.EmergencyTime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="EmergencyNurse"></b>绿道护士:</label>
                    <input type="text" ng-model="Emergency.EmergencyNurse" name="EmergencyNurse" id="EmergencyNurse" validateName="EmergencyNurse" />
                </div>
            </div>
            <h4 class="tit-block">绿通响应</h4>
            <div class="row-box">
                <div class="mr-row-fourth">
                    <label><b validateSnow="StrokeTeamAdmissionTime"></b>急诊护士接诊患者时间:</label>
                    <input type="text" name="StrokeTeamAdmissionTime" class="datetime" validateName="StrokeTeamAdmissionTime" timeId=@TimeLineNodes.D020200 ng-model="Emergency.StrokeTeamAdmissionTime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="ArrivedStrokeTime"></b>卒中医生接诊患者时间:</label>
                    <input type="text" name="ArrivedStrokeTime" class="datetime" validateName="ArrivedStrokeTime" timeId=@TimeLineNodes.D020212 ng-model="Emergency.ArrivedStrokeTime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="BloodCollectionTime"></b>采血时间:</label>
                    <input type="text" name="BloodCollectionTime" class="datetime" validateName="BloodCollectionTime" timeId=@TimeLineNodes.D020201 ng-model="Emergency.BloodCollectionTime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>   
                <div class="mr-row-fourth">
                    <label><b validateSnow="InspectionTime"></b>送检时间:</label>
                    <input type="text" name="InspectionTime" class="datetime" validateName="InspectionTime" timeId=@TimeLineNodes.D020202 ng-model="Emergency.InspectionTime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>          
            </div>
            <div class="row-box">  
                <div class="mr-row-fourth">
                    <label><b validateSnow="AcceptanceTime"></b>接收时间:</label>
                    <input type="text" name="AcceptanceTime" class="datetime" validateName="AcceptanceTime" timeId=@TimeLineNodes.D020213 ng-model="Emergency.AcceptanceTime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="BgCompletionTime"></b>血糖检测完成时间:</label>
                    <input type="text" name="BgCompletionTime" class="datetime" validateName="BgCompletionTime" timeId=@TimeLineNodes.D020203 ng-model="Emergency.BgCompletionTime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="EcgDiagnosisTime"></b>心电图检测完成时间:</label>
                    <input type="text" id="EcgDiagnosisTime" name="EcgDiagnosisTime" validateName="EcgDiagnosisTime" timeId=@TimeLineNodes.D020204 ng-model="Emergency.EcgDiagnosisTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="CtOpenTime"></b>开具头颅CT单时间:</label>
                    <input type="text" id="CtOpenTime" name="CtOpenTime" validateName="CtOpenTime" timeId=@TimeLineNodes.D020205 ng-model="Emergency.CtOpenTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>

            </div>

            <div class="mr-row">
                <div style="width: 100%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="PastMedicalHistory"></b>既往史：</label><br />
                    <label ng-repeat="x in PastMedicalHistoryDict | orderBy:'Key'">
                        <input name="PastMedicalHistory" type="checkbox"
                               ng-checked="isSelected($index,Emergency.PastMedicalHistoryList)" ng-click="updateSelection($event,$index,Emergency.PastMedicalHistoryList)" validateName="{{$index == 0 ? 'PastMedicalHistory' : ''}}">
                        <span>{{x.Value}}</span>
                    </label>
                </div>
            </div>

            <div class="row-box">
                <div class="mr-row-fourth" style="width:100%" ng-show="Emergency.PastMedicalHistoryList[10]">
                    <label><b validateSnow="OtherMedicalHistory"></b>其他病史:</label>
                    <input type="text" id="OtherMedicalHistory" name="OtherMedicalHistory" validateName="OtherMedicalHistory" maxlength="500" ng-model="Emergency.OtherMedicalHistory" />
                </div>
            </div>
            <div class="row-box">
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="IsAllergyHistory"></b>有无过敏史:</label><br />
                    <label>
                        <input type="radio" id="IsAllergyHistory" name="IsAllergyHistory" value="1" validateName="IsAllergyHistory" ng-model="Emergency.IsAllergyHistory"><span>有</span>
                    </label>
                    <label>
                        <input type="radio" id="IsAllergyHistory" name="IsAllergyHistory" value="0" ng-model="Emergency.IsAllergyHistory"><span>无</span>
                    </label>
                </div>
                <div class="mr-row-fourth" style="width:75%" ng-show="Emergency.IsAllergyHistory=='1'">
                    <label><b validateSnow="AllergyHistory"></b>过敏史:</label>
                    <input type="text" id="AllergyHistory" name="AllergyHistory" validateName="AllergyHistory" maxlength="500" ng-model="Emergency.AllergyHistory" />
                </div>
            </div>
            <h4 class="tit-block">近期服药史</h4>
            <div class="row-box">
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="IsAspl"></b>是否服用阿司匹林:</label><br />
                    <label>
                        <input type="radio" id="IsAspl" name="IsAspl" value="1" validateName="IsAspl" ng-model="Emergency.IsAspl"><span>是</span>
                    </label>
                    <label>
                        <input type="radio" id="IsAspl" name="IsAspl" value="0" ng-model="Emergency.IsAspl"><span>否</span>
                    </label>
                </div>
                <div class="mr-row-fourth" ng-show="Emergency.IsAspl=='1'">
                    <label><b validateSnow="Aspl"></b>阿司匹林:</label>
                    <input type="text" id="Aspl" maxlength="10" name="Aspl" validateName="Aspl" ng-model="Emergency.Aspl" />
                    <em>mg/日</em>
                </div>
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="IsLpgl"></b>是否服用氯吡格雷:</label><br />
                    <label>
                        <input type="radio" id="IsLpgl" name="IsLpgl" value="1" validateName="IsLpgl" ng-model="Emergency.IsLpgl"><span>是</span>
                    </label>
                    <label>
                        <input type="radio" id="IsLpgl" name="IsLpgl" value="0" ng-model="Emergency.IsLpgl"><span>否</span>
                    </label>
                </div>
                <div class="mr-row-fourth" ng-show="Emergency.IsLpgl=='1'">
                    <label><b validateSnow="Lpgl"></b>氯吡格雷:</label>
                    <input type="text" id="Lpgl" maxlength="10" name="Lpgl" validateName="Lpgl" ng-model="Emergency.Lpgl" />
                    <em>mg/日</em>
                </div>                
            </div>
            <div class="row-box">
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="IsHfl"></b>是否服用华法林:</label><br />
                    <label>
                        <input type="radio" id="IsHfl" name="IsHfl" value="1" validateName="IsHfl" ng-model="Emergency.IsHfl"><span>是</span>
                    </label>
                    <label>
                        <input type="radio" id="IsHfl" name="IsHfl" value="0" ng-model="Emergency.IsHfl"><span>否</span>
                    </label>
                </div>
                <div class="mr-row-fourth" ng-show="Emergency.IsHfl=='1'">
                    <label><b validateSnow="Hfl"></b>华法林:</label>
                    <input type="text" id="Hfl" maxlength="10" name="Hfl" validateName="Hfl" ng-model="Emergency.Hfl" />
                    <em>mg/日</em>
                </div>
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="IsDbjqOrLfsb"></b>是否服用达比加群/利伐沙班:</label><br />
                    <label>
                        <input type="radio" id="IsDbjqOrLfsb" name="IsDbjqOrLfsb" value="1" validateName="IsDbjqOrLfsb" ng-model="Emergency.IsDbjqOrLfsb"><span>是</span>
                    </label>
                    <label>
                        <input type="radio" id="IsDbjqOrLfsb" name="IsDbjqOrLfsb" value="0" ng-model="Emergency.IsDbjqOrLfsb"><span>否</span>
                    </label>
                </div>
                <div class="mr-row-fourth" ng-show="Emergency.IsDbjqOrLfsb=='1'">
                    <label><b validateSnow="DbjqOrLfsb"></b>达比加群/利伐沙班:</label>
                    <input type="text" id="DbjqOrLfsb" maxlength="10" name="DbjqOrLfsb" validateName="DbjqOrLfsb" ng-model="Emergency.DbjqOrLfsb" />
                    <em>mg/日</em>
                </div>
            </div>
            <div class="row-box">
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="IsOtherMedicine"></b>是否服用其他药物:</label><br />
                    <label>
                        <input type="radio" id="IsOtherMedicine" name="IsOtherMedicine" value="1" validateName="IsOtherMedicine" ng-model="Emergency.IsOtherMedicine"><span>是</span>
                    </label>
                    <label>
                        <input type="radio" id="IsOtherMedicine" name="IsOtherMedicine" value="0" ng-model="Emergency.IsOtherMedicine"><span>否</span>
                    </label>
                </div>
                <div class="mr-row-fourth" ng-show="Emergency.IsOtherMedicine=='1'">
                    <label><b validateSnow="OtherMedicine"></b>其他药物:</label>
                    <input type="text" id="OtherMedicine" maxlength="200" name="Aspl" validateName="OtherMedicine" ng-model="Emergency.OtherMedicine" />
                </div>
            </div>
            <h4 class="tit-block" style="margin-top:20px;">评分</h4>
            <div class="row-box">
                <div class="mr-row-fourth">
                    <label class="label-tit">
                        <b validateSnow="NihssScoreValue"></b>NIHSS评分:
                    </label>
                    <input style="width:100px;text-align:center;" ng-model="Emergency.NihssScoreValue" />
                    <button style="height:18px; padding: 0; vertical-align:middle;" type="button" class="btn-warning" ng-click="showNIHSS()">评分</button>
                </div>
            </div>

            <h4 class="tit-block">影像学检查</h4>
            <div class="row-box">
                <div class="mr-row-fourth">
                    <label><b validateSnow="CtStartTime"></b>患者到达CT/MRI室时间:</label>
                    <input type="text" id="CtStartTime" name="CtStartTime" validateName="CtStartTime" timeId=@TimeLineNodes.D020206 ng-model="Emergency.CtStartTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="CtEndTime"></b>CT/MRI检查结束时间:</label>
                    <input type="text" id="CtEndTime" name="CtEndTime" validateName="CtEndTime" timeId=@TimeLineNodes.D020207 ng-model="Emergency.CtEndTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="CtResultTime"></b>CT/MRI报告时间:</label>
                    <input type="text" id="CtResultTime" name="CtResultTime" validateName="CtResultTime" timeId=@TimeLineNodes.D020208 ng-model="Emergency.CtResultTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="BloodTestReportTime"></b>检验科血液化验报告时间:</label>
                    <input type="text" id="BloodTestReportTime" name="BloodTestReportTime" validateName="BloodTestReportTime" ng-model="Emergency.BloodTestReportTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
            </div>
            <div class="row-box">
                <div class="mr-row-fourth">
                    <label><b validateSnow="XcgTime"></b>血常规:</label>
                    <input type="text" id="XcgTime" name="XcgTime" validateName="XcgTime" timeId=@TimeLineNodes.D020209 ng-model="Emergency.XcgTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="NxcgTime"></b>凝血常规:</label>
                    <input type="text" id="NxcgTime" name="NxcgTime" validateName="NxcgTime" timeId=@TimeLineNodes.D020210 ng-model="Emergency.NxcgTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="SgnjdjzTime"></b>肾功能及电解质:</label>
                    <input type="text" id="SgnjdjzTime" name="SgnjdjzTime" validateName="SgnjdjzTime" timeId=@TimeLineNodes.D020211 ng-model="Emergency.SgnjdjzTime" class="input-half left datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm',startDate:'@ViewBag.ReferenceDate'} | json }}" />
                </div>
            </div>

            <div class="row-box">
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="TriageResults"></b>分检诊结果:<button type="button" class="popup-score-ti btn-warning" ng-click="showTreatmentDecision()">溶栓决策</button></label><br />
                    <label ng-repeat="item in TriageResultsDict | orderBy:'Key'">
                        <input type="checkbox" name="TriageResults" ng-checked="isSelected($index,Emergency.TriageResultsList)" ng-click="updateSelection($event,$index,Emergency.TriageResultsList)" validateName="{{$index == 0 ? 'TriageResults' : ''}}" />
                        <span>{{item.Value}}</span>
                    </label>
                </div>
            </div>
            <div class="row-box">
                <div class="mr-row-fourth" style="width:50%">
                    <label><b validateSnow="Diagnosis"></b>诊断:</label>
                    <input type="text" id="Diagnosis" name="Diagnosis" validateName="Diagnosis" ng-model="Emergency.Diagnosis" />
                </div>
                <div class="mr-row-fourth" style="width:50%" ng-show="!Emergency.TriageResultsList[0] || !Emergency.TriageResultsList[1]">
                    <label><b validateSnow="Diagnosis"></b>若未能实施静脉溶栓，动脉取栓，请注明原因（包括禁忌症）:</label>
                    <input type="text" id="Reason" name="Reason" validateName="Reason" ng-model="Emergency.Reason" />
                </div>
            </div>

            <div class="row-box">
                <div class="mr-row-fourth" ng-show="is3h=='1'" style="width:50%">
                    <label>发病3h相对排除标准:</label>
                    <label ng-repeat="x in ThromRelativeExclusionCriteria3HDict" ng-show="isSelected($index,Emergency.RelExclusionCriteria3h,x.Value)" ng-class="isSelected($index,Emergency.RelExclusionCriteria3h,x.Value) ? 'imp-hist':''">
                        <span>{{x.Value}}</span><br />
                    </label>
                </div>
                <div class="mr-row-fourth" ng-show="is3h!='1'" style="width:50%">
                    <label>发病4.5h相对排除标准:</label>
                    <label ng-repeat="x in ThromRelativeExclusionCriteria4_5HDict" ng-show="isSelected($index,Emergency.RelExclusionCriteria45h,x.Value)" ng-class="isSelected($index,Emergency.RelExclusionCriteria45h,x.Value) ? 'imp-hist':''">
                        <span>{{x.Value}}</span><br />
                    </label>
                </div>
                <div class="mr-row-fourth" style="width:50%">
                    <label>入选标准:</label>
                    <label ng-repeat="x in ThromInclusionCriteriaDict" ng-show="isSelected($index,Emergency.InclusionCriteria,x.Value)" ng-class="isSelected($index,Emergency.InclusionCriteria,x.Value)?'imp-hist':''">
                        <span>{{x.Value}}</span><br />
                    </label>
                </div>
            </div>
            <div class="row-box">
                <div class="mr-row-fourth" style="width:100%">
                    <label>排除标准:</label>
                    <label ng-repeat="x in ThromExclusionCriteriaDict" ng-show="isSelected($index,Emergency.ExclusionCriteria,x.Value)" ng-class="isSelected($index,Emergency.ExclusionCriteria,x.Value)?'imp-hist':''">
                        <span>{{x.Value}}</span><br />
                    </label>
                </div>
            </div>

            <div class="row-box" ng-show="Emergency.TriageResultsList[2]">
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="CtIsHemorrhage"></b>是否出血:</label><br />
                    <label>
                        <input type="radio" id="CtIsHemorrhage" name="CtIsHemorrhage" value="1" validateName="CtIsHemorrhage" ng-model="Emergency.CtIsHemorrhage" ng-disabled="Emergency.IsCompleted"><span>是</span>
                    </label>
                    <label>
                        <input type="radio" id="CtNoHemorrhage" name="CtIsHemorrhage" value="0" ng-model="Emergency.CtIsHemorrhage" ng-disabled="Emergency.IsCompleted"><span>否</span>
                    </label>
                </div>
                <div style="width: 25%;float:left;margin-bottom:10px;position:relative;" ng-show="Emergency.CtIsHemorrhage=='1'">
                    <label><b validateSnow="DiagnosisType"></b>出血部位:</label><br />
                    <label ng-repeat="item in DiagnosisTypeDict | orderBy:'Key'" ng-show="item.Key!='1'" style="width:{{item.Key == '2' ? '75px;' : '130px;'}}">
                        <input type="radio" id="DiagnosisType" name="DiagnosisType" value="{{item.Key}}" validateName="{{$index == 1 ? 'DiagnosisType' : ''}}" ng-model="Emergency.DiagnosisType" />
                        <span>{{item.Value}}</span>
                    </label>
                </div>
            </div>
            <div class="row-box" ng-show="Emergency.TriageResultsList[2] || Emergency.TriageResultsList[3]">
                <div class="mr-row-fourth">
                    <label><b validateSnow="AdmissionDepartment"></b>入院科室:</label>
                    <input type="text" id="AdmissionDepartment" name="AdmissionDepartment" validateName="AdmissionDepartment" ng-model="Emergency.AdmissionDepartment" />
                </div>
                <div class="mr-row-fourth">
                    <label><b validateSnow="AdmissionNo"></b>住院号:</label>
                    <input type="text" id="AdmissionNo" name="AdmissionNo" validateName="AdmissionNo" ng-model="Emergency.AdmissionNo" />
                    <button type="button" class="btn-warning btn-extract" ng-click="onRelation('5')">关联</button>
                </div>
            </div>
            <div class="mr-row" ng-show="Emergency.TriageResultsList[2] || Emergency.TriageResultsList[3]">
                <div style="width: 75%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="NoThromReasons"></b>未进行溶栓治疗原因：</label><br />
                    <label ng-repeat="x in NoThromReasonsDict">
                        <input name="NoThromReasons" type="checkbox" ng-checked="isSelected($index,Emergency.NoThromReasonsList)" ng-click="updateSelection($event,$index,Emergency.NoThromReasonsList)" validateName="{{$index == 0 ? 'NoThromReasonsList' : ''}}">
                        <span>{{x.Value}}</span>
                    </label>
                </div>
                <div class="mr-row-fourth" ng-show="Emergency.NoThromReasonsList[6]">
                    <label><b validateSnow="NoThromOtherReasons"></b>其他原因:</label>
                    <input type="text" id="noThromReasons" name="noThromReasons"
                           ng-show="Emergency.NoThromReasonsList[6]"
                           ng-model="Emergency.NoThromOtherReasons" />
                </div>
            </div>

            <div class="mr-row" ng-show="Emergency.TriageResultsList[2] || Emergency.TriageResultsList[3]">
                <div style="width:50%;float:left;margin-bottom:10px;position:relative;">
                    <label><b validateSnow="PatientsWhereabouts"></b>患者去向：</label><br />
                    <label ng-dblclick="cancel()" ng-repeat="item in IatDestinationAfterPciDict | orderBy:'Key'">
                        <input type="radio" name="PatientsWhereabouts" value="{{item.Key}}" ng-model="Emergency.PatientsWhereabouts" validateName="{{$index == 0 ? 'PatientsWhereabouts' : ''}}">
                        <span>{{item.Value}}</span>
                    </label>
                </div>
            </div>
        </fieldset>
    </form>
</div>
