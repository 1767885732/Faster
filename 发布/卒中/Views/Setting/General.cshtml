@using DoCare.ToolKit
@{
    ViewBag.Title = "通用设置";
    Layout = null;
}
<style>
    .sys-setting {
        width: 100%;
        font-size: 12px;
    }

        .sys-setting tr td {
            border: 1px solid #ddd;
            padding: 2px 10px;
            height: 24px;
            line-height: 24px;
        }

    .thCommon {
        background: #f7f7f7;
    }

    .tx {
        display: inline-block;
        width: 100%;
        height: 100%;
        border: none;
        border-bottom: 1px solid #ccc;
    }
</style>
<script>
    var model =  @Html.Raw((JsonKit.Serialize(ViewBag.Model)));
    $(function () {
        var app = angular.module('ngCommonSetting', []);

        app.controller('ngCtrlCommon', function ($scope, $http) {
            $scope.Setting = model.Setting;

            $scope.save = function () {
                debugger;
                $http({
                    method: 'POST',
                    url: '/Setting/SaveGeneral',
                    data: { setting: $scope.Setting }
                }).then(function successCallback(response) {
                    if (response.data.IsSuccess) {
                        layer.alert("保存成功", { icon: 1 });
                    }
                    else {
                        layer.alert(response.data.Message, { icon: 2 });
                    }
                }, function errorCallback(response) {
                    // 请求失败执行代码
                    layer.alert("请求失败！", { icon: 2 });
                });
            }
            
        });

        angular.bootstrap($(".content")[0], ['ngCommonSetting']);
    });
</script>
<div class="content" ng-app="ngCommonSetting" ng-controller="ngCtrlCommon">
    <form id="_common_setting">
        <fieldset class="medical-record">
            <button class="operating-btn medical-save-btn" ng-click="save()" id="btnSave"><img src="~/App_Themes/Default/img/icon/save.png"></button>
            <table class="sys-setting">
                <thead>
                    <tr class="thCommon">
                        <td colspan="2">通用设置</td>
                    </tr>
                </thead>
                <tr>
                    <td style="width:30%;">院前心电图地址</td>
                    <td>
                        <input type="text" class="tx" ng-model="Setting.FirstAidEcgUrl" >
                    </td>
                </tr>
                <tr>
                    <td style="width:30%;">院前电子病历地址</td>
                    <td>
                        <input type="text" class="tx" ng-model="Setting.FirstAidEmrUrl">
                    </td>
                </tr>
                <tr>
                    <td style="width:30%;">急诊心电图地址</td>
                    <td>
                        <input type="text" class="tx" ng-model="Setting.EmergencyEcgUrl">
                    </td>
                </tr>
                <tr>
                    <td style="width:30%;">急诊电子病历地址</td>
                    <td>
                        <input type="text" class="tx" ng-model="Setting.EmergencyEmrUrl">
                    </td>
                </tr>
            </table>
            <br />

        </fieldset>
    </form>
</div>