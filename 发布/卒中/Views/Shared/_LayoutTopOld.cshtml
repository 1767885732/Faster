@model DoCare.CVA.Web.Models.TopMenuModel
@{
    ViewBag.Title = Resources.AppName;
    ViewBag.CopyRight = Resources.CopyRight;
    ViewBag.Version = Resources.AppVersion;
}
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/App_Themes/New/font-awesome.min.css" rel="stylesheet" />
    <link href="~/App_Themes/New/ionicons.min.css" rel="stylesheet" />
</head>
<script>
    /* 二级导航收起展开方式 */
    $(function () {
        //页面中的DOM已经装载完成时，执行的代码
        function domHover(domObj) {
            domObj.hover(function () {
                $(this).children("div").stop(true, true).slideDown("fast");
            }, function () {
                $(this).children("div").stop(true, true).slideUp("fast");
            });
        }
        domHover($(".module-user"));

        //注销登录
        $("#logOut").click(function () {
            window.location.href = "/Account/Logout/";
        });

        //菜单点击
        $("ul.nav_menu li:not(.module-user)").click(function () {
            var url = $(this).attr("url");
            if (typeof url == 'undefined' || url == "") {

            } else if (url.indexOf("http://") == 0) {

                window.open(url);
            } else {
                window.location.href = url;
            }
        });

        //系统消息
        $("#sysMessage").click(function () {
            $.post('/Account/SystemMessage', {}, function (str) {
                layer.open({
                    type: 1,
                    title: '系统消息',
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['800px', '600px'],
                    content: str,
                });
            });

        });

        //修改密码
        $("#modifyPassword").click(function () {
            $.post('/Account/ModifyPasswordView', {}, function (str) {
                layer.open({
                    type: 1,
                    title: '修改密码',
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['400px', '300px'],
                    content: str,
                });
            });

        });

        //帮助
        $("#acrHelp").click(function (e) {
            layer.open({
                type: 2,
                title: false,
                btn: false,
                maxmin: false,
                shadeClose: false, //点击遮罩关闭层
                area: ['340px', '270px'],
                content: '../Account/Help'
            });
        });

        //getUnreadMessageCount();
        //设置定时器，没一分钟刷新一次
        //setInterval(function () {
        //    getUnreadMessageCount();
        //}, 60000);

    });

    //function getUnreadMessageCount() {
    //    var loginName = getCookie("_nk_");
    //    if(!loginName){
    //        console.log("用户长时间未操作，已自动退出，不再获取消息");
    //        return;
    //    }
    //    $.ajax({
    //        type: 'post',
    //        url: '/Account/GetUnreadMessageCount',
    //        data: { loginName: loginName },
    //        cache: false,
    //        dataType: 'json',
    //        async: false,
    //        success: function (data) {
    //            if (data.IsSuccess) {
    //                if (data.Data == 0) {
    //                    $("#messageCount").hide();
    //                    $("#messageTip").hide();
    //                } else {
    //                    $("#messageCount").show();
    //                    $("#messageCount").html(data.Data);
    //                    $("#messageTip").show();
    //                }
    //                console.log("获取消息数量成功：" + data.Data);
    //            } else {
    //                console.log("获取消息数量失败：" + data.Message);
