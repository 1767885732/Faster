</script>
@*<h1 style="display:flex;width:70%">@ViewBag.Title<em>@ViewBag.Version</em>&nbsp;&nbsp;<img style="float:right;width:320px;height:50px;clear:both" src="../App_Themes/Default/img/icon/SDFE.png"/></h1>*@
@*<h1 style="display:flex;width:70%">@ViewBag.Title<em>@ViewBag.Version</em></h1>*@
<div class="nav">
    <ul class="nav_menu">
        @foreach (var menu in Model.MenuList)
        {

            var liClass = "";
            if (Model.Selected == menu.PermissionKey)
            {
                liClass = "selected";
            }
           
            <li class="@liClass" url="@menu.Action" data-menuId="@menu.Id">
                <s class="@menu.Icon"></s>
                <a href="javascript:void(0)">@menu.Name</a>
            </li>



        }
        <li class="module-user">
            <s class="fa fa-user" style="color:white;font-size:22px"></s>
            @*<s class="menu-icon-user"></s>*@
            <a title="@Model.CurrentUser.LoginName"><nobr>@Model.CurrentUser.Name</nobr></a>
            <div>
                <a id="sysMessage">系统消息</a>
                <a id="modifyPassword">修改密码</a>
                <a id="acrHelp" class="help">帮助</a>
                <a id="logOut">退出</a>
            </div>
        </li>
    </ul>
</div>
