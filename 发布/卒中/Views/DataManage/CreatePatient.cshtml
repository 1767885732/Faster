@model DoCare.CVA.Data.TimelineModel
@{
    Layout = null;
}
<script src="~/Scripts/Stroke/DataManage/CreatePatient.js"></script>
<style>
    .child {
        width: 756px;
        height: 80px;
        margin: auto;
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        text-align: center;
    }

    .cp-img {
        line-height: 22px;
        margin-top: 3px;
    }

    .cp-button {
        color: #444;
        border: 1px solid #bbb;
        background: linear-gradient(to bottom,#ffffff 0,#eeeeee 100%);
        height: 22px;
        text-align: center;
        line-height: 22px;
        border-radius: 4px;
        cursor: pointer;
        display: inline-block;
    }

    a:hover {
        color: #444;
    }

    .Wdate {
        height: 22px;
        padding-left: 2px;
        padding-right: 2px;
    }

    .Hospital {
        height: 24px;
        width: 180px;
    }
</style>
<link href="~/App_Themes/Default/img/CreatePatient/BootButton.css" rel="stylesheet" />
<link href="~/App_Themes/Default/style.css" rel="stylesheet" />
<link href="~/App_Themes/Default/add-patient.css" rel="stylesheet" />
<div class="time-record">
    <input type="hidden" id="hdnType" value="@ViewBag.Source">
    <input type="hidden" id="hdnName" value="@ViewBag.Name">
    <div id="_patient_treatment_form">
        <fieldset class="medical-record">
            <div class="operating-btn right-15" style="margin-top:6px;">
                <a href="/DataManage/CreateBlank" target="_blank" class="cp-button" style="width: 110px;"><img class="cp-img" src="~/Scripts/jquery-easyui/themes/icons/export.png" />&nbsp;新增空白病例</a>&nbsp;
                <a id="btnStationSearch" class="cp-button" style="width:60px;"><img class="cp-img" src="~/Scripts/jquery-easyui/themes/icons/search.png" />&nbsp;查询</a>&nbsp;
                @if (ViewBag.Type == "CreatePatient")
                {
                    <a id="btnSynchro" class="cp-button" style="width:60px;"><img class="cp-img" src="~/Scripts/jquery-easyui/themes/icons/submit.png" />&nbsp;确认</a>
                }
                else
                {
                    <a id="btnRelation" class="cp-button" style="width:60px;"><img class="cp-img" src="~/Scripts/jquery-easyui/themes/icons/submit.png" />&nbsp;确认</a>
                }
            </div>
            <div class="tab" id="hospitalized-nav" style="margin-top:5px;">
                @if (ViewBag.Type == "CreatePatient")
                {
                    if (ViewBag.Emergency)
                    {
                        if (ViewBag.Source == "2")
                        {
                            <a source="2" href="javascript:void(0);" class="hover">急诊</a>
                        }
                        else
                        {
                            <a source="2" href="javascript:void(0);">急诊</a>
                        }
                    }
                    if (ViewBag.Outpatient)
                    {
                        if (ViewBag.Source == "3")
                        {
                            <a source="3" href="javascript:void(0);" class="hover">门诊</a>
                        }
                        else
                        {
                            <a source="3" href="javascript:void(0);">门诊</a>
                        }

                    }
                    if (ViewBag.Hospitalization)
                    {
                        if (ViewBag.Source == "5")
                        {
                            <a source="5" href="javascript:void(0);" class="hover">住院</a>
                        }
                        else
                        {
                            <a source="5" href="javascript:void(0);">住院</a>
                        }
                    }
                }
                else if (ViewBag.Type == "RelationClinicNo")
                {
                    <a source="3" href="javascript:void(0);" class="hover">门诊</a>
                }
                else if (ViewBag.Type == "RelationInpatientNo")
                {
                    <a source="5" href="javascript:void(0);" class="hover">住院</a>
                }
            </div>
        </fieldset>
    </div>
    <div id="divbody" style="position: relative; overflow: auto;height: auto; padding: 0px; margin: 0px;">
        <div style="margin: 0 0 10px 10px;">
            <span>医院名称：</span>@Html.DropDownList("sltStationHopitalName", ViewBag.OrgList as List<SelectListItem>, new { @class = "Hospital" })

            <span style="margin-left:10px;">从</span>
            <input type="text" class="Wdate" id="txtStationStartDate" style="width: 120px;" onfocus="WdatePicker({ dateFmt: 'yyyy年M月d日', maxDate: '#F{$dp.$D(\'txtStationEndDate\')}' })" />
            <span style="margin-left:5px;margin-right:5px;">到</span>
            <input type="text" class="Wdate" id="txtStationEndDate" style="width: 120px;" onfocus="WdatePicker({ dateFmt: 'yyyy年M月d日', minDate: '#F{$dp.$D(\'txtStationStartDate\')}' })" />
            <span style="margin-left:10px;">姓名:</span>
            <input type="text" id="patientName" style="width:120px;border:none;border-bottom:1px solid black;" />
            @*<span id="visitIdTitle" style="margin-left:10px;">门诊号:</span>
                <input type="text" id="visitId" style="width:100px;border:none;border-bottom:1px solid black;" />*@
        </div>
    </div>
    <table id="grdSationDataList" singleselect="true" style="height:350px;"></table>
    <div id="divStationPanel"></div>

</div>