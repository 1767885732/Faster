@model DoCare.CVA.Web.Models.CRFViewModel
@using DoCare.Framework.Extension;
@using DoCare.CRF.Form.Data

<link href=@Url.GetCssJsUrl("~/Content/xxg_cz.css") rel="stylesheet" />
<style>
    #tab_list {
        margin: 0;
        padding: 0;
        float: right;
    }

    #tab_list a {
        padding: 0px;
        display: block;
        margin: 0 auto 5px auto;
        clear: both;
        float: right;
        overflow: hidden;
    }

    #tab_list a > i {
        width: 20px;
        height: 20px;
        line-height: 30px;
        display: inline-block;
        vertical-align: middle;
        margin: 5px 5px 0 0;
        float: right;
        z-index: 999;
    }

    .tab_sign {
        background: url(../../Images/icon/tab_sign.png) no-repeat 0 0;
    }

    .tab_sign:hover {
        background: url(../../Images/icon/tab_sign.png) no-repeat 0 -20px;
    }

    .remove_sign {
        background: url(../../Images/icon/tab_sign.png) no-repeat -20px 0;
    }

    .remove_sign:hover {
        background: url(../../Images/icon/tab_sign.png) no-repeat -20px -20px;
    }

    #tab_list a dt {
        width: 150px;
        height: 30px;
        font-size: 14px;
        line-height: 30px;
        color: #666;
        font-weight: normal;
        text-align: left;
        padding-left: 10px;
        margin: 0;
        display: block;
        border-radius: 5px 0 0 5px;
        background-color: #ccc;
    }

    #tab_list a.disabled dt {
        width: 100%;
        height: 30px;
        line-height: 30px;
        padding: 0;
        border-radius: 10px 0 0 10px;
        color: #666;
        background-color: #45a1f6;
    }

    #tab_list a:hover dt {
        color: #ffffff;
        background-color: #1d7fdd;
    }

    #tab_list a.active dt {
        color: #ffffff;
        font-weight: bold;
        background-color: #7ec3ff;
    }

    #tab_list a.disabled dt, #tab_list a:hover.disabled dt {
        color: #666;
        text-decoration: none !important;
        cursor: default;
    }
    .crf_tit {
        font-size:24px;
        line-height:50px;
        font-weight:bold;
        text-align:center;
        color:#333333 !important;
        clear:both;
        overflow:hidden;
    }
    .CategoryGroup p {
        height: 30px;
        font-weight: bold;
        font-size: 16px;
        padding: 10px 0 0 10px;
        margin: 0;
        overflow: hidden;
        line-height: 30px;
    }
    .CategoryGroup span {
        font-size:14px;
        line-height:20px;
    }
     .CategoryGroup span.tit {
        width: auto;
        text-align: left;
        vertical-align:top;
        padding-left:20px;
        display: inline-block;
    }
    .CategoryGroup span.info {
        text-align: left;
        padding-left: 10px;
        color: #ff0000;
        display: inline-block;
    }
    .CategoryGroup_line {
        border-bottom:1px #ededed dashed;
        margin:0 10px 10px 10px;
        padding-top:10px;
    }
</style>


<div id="container">
    @using (Html.BeginForm("", "", FormMethod.Post, new { @id = "_content_modify_form", @class = "form_block" }))
    {
        @Html.HiddenFor(m => m.ID);
        <div class="content mg_10" style="overflow:hidden; min-width:1200px;">
            <div id="container line_b">
                <div class="form_tit">查看病例</div>
                <div class="crf_tit">
                    @Model.Title
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="container_inst">
                <div class="menu_block fl">
                    <dl id="tab_list">
                        @foreach (MDCRFCategory Category in Model.Categorys.Keys)
                        {
                            <a href="#@Category.ItemCategoryCode" name="Category">
                                <dt>@Category.ItemCategoryName</dt>
                            </a>  
                        }
                    </dl>
                </div>

                <div class="box_block">
                    <div class="bg">
                        <div id="_formItems" class="box_block" style="background-color:#ffffff;margin:10px;">
                            @foreach (MDCRFCategory Category in Model.Categorys.Keys)
                            {
                                var Items = Model.Categorys[Category];
                                <div id="@Category.ItemCategoryCode" class="CategoryGroup" >
                                    <p>@Category.ItemCategoryName</p>
                                    @foreach (MDCRFItem Item in Items)
                                    {
                                        <span class="tit">@Item.Title</span><span class="info">@Html.Raw(@Item.Text == null ? "" : @Item.Text.Replace("/r/n", "</br>"))</span>
                                        <br>
                                    }
                                    <div class="CategoryGroup_line"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>
