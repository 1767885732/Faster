@{
    Layout = null;
}
<style>
    .panel-body {
        overflow-x: hidden !important;
    }

    .pop_login {
        margin: 0 auto;
        padding: 0;
    }

        .pop_login td {
            line-height: 40px;
        }

    .pop_login_tit {
        width: 115px;
        font-weight: bold;
        text-align: right;
    }

    .pop_login td input[type="password"] {
        height: 24px;
    }

    .err_msg {
        font-weight: normal;
        color: Red;
        height: 20px;
        line-height: 20px;
        margin-top: -5px;
    }
</style>

<script>
    $(function () {
        var currentIndex = layer.index;

        var validate = $("#modifyForm").validate({
            rules: {
                oldPassword: {
                    required: true,
                    minlength: 3,
                    maxlength: 16,
                },
                newPassword: {
                    required: true,
                    minlength: 3,
                    maxlength: 16,
                },
                confirmPassword: {
                    required: true,
                    minlength: 3,
                    maxlength: 16,
                    equalTo: newPassword,
                },
            },
            messages: {
                oldPassword: {
                    required: "请输入旧密码",
                    minlength: "密码长度不能小于 3 个字母",
                    maxlength: "密码长度不能大于 16 个字母"
                },
                newPassword: {
                    required: "请输入新的密码",
                    minlength: "密码长度不能小于 3 个字母",
                    maxlength: "密码长度不能大于 16 个字母"
                },
                confirmPassword: {
                    required: "请输入确认密码",
                    minlength: "密码长度不能小于 3 个字母",
                    maxlength: "密码长度不能大于 16 个字母",
                    equalTo: "两次输入的密码不一致"
                },
            },
            errorPlacement: function (error, element) {
                $(error).addClass('err_msg').insertAfter(element);
            },
            errorElement: "div",
        });

        //保存
        $("#btnSave").click(function () {
            if (!validate.form()) {
                return;
            }
            var oldPassword = $.trim($("#oldPassword").val());
            var newPassword = $.trim($("#newPassword").val());
            var confirmPassword = $.trim($("#comfirmPassword").val());
            //检验长度及确认密码

            $.ajax({
                type: 'POST',
                data: { oldPassword: oldPassword, newPassword: newPassword },
                datatype: "json",
                url: "/Account/ModifyPassword/",
                success: function (data) {
                    if (data.IsSuccess) {
                        layer.alert("修改成功,请重新登录", { icon: 1 }, function (index) {
                            layer.close(index);
                            layer.close(currentIndex); //先关闭修改密码页面
                            window.location.href = "/Account/Logout/";
                        });
                    } else {
                        layer.alert(data.Message, { icon: 2 });
                    }
                },
            });
        });

        //关闭
        $("#btnClose").click(function () {
            layer.close(currentIndex);
        });
    });
</script>
<div style="overflow-x:hidden">
    @using (Html.BeginForm("", "", FormMethod.Post, new { @id = "modifyForm" }))
    {
        <table cellpadding="0" cellspacing="0" align="center" style="margin:10px;width:98%;" class="pop_login">
            <tr>
                <td class="pop_login_tit" style="line-height:20px;">用户名：</td>
                <td style="line-height:20px;">
                    @ViewBag.LoginName
                </td>
            </tr>
            <tr>
                <td class="pop_login_tit">旧密码：</td>
                <td>
                    <input type="password" id="oldPassword" name="oldPassword" />
                </td>
            </tr>
            <tr>
                <td class="pop_login_tit">新密码：</td>
                <td>
                    <input type="password" id="newPassword" name="newPassword" />
                </td>
            </tr>
            <tr>
                <td class="pop_login_tit">确定密码：</td>
                <td>
                    <input type="password" id="comfirmPassword" name="confirmPassword" />
                </td>
            </tr>
            <tr>
                <td align="center" colspan="2">
                    <button type="button" id="btnSave" name="btnSave" class="btn-primary" style="margin-right:5px;padding:0 10px;">保 存</button>
                    <button type="button" id="btnClose" name="btnClose" style="margin-left:5px;padding:0 10px;">关 闭</button>
                </td>
            </tr>
        </table>
    }
</div>
