<script>
    var model = @Html.Raw(JsonKit.Serialize(Model));
    var app = angular.module('DoctorApp', ['mdsdFilter', 'mdsdDirective']);
    app.controller('DoctorController', function ($scope, $filter, $http) {
        $scope.model = model;
        console.log(model);
        $scope.getByIndex = function(index,id)
        {
            $scope.model.ActiveId = id;
        }

        $scope.save = function(item)
        {
            var index = layer.load();
            $http.post('/FollowUpManage/SaveDoctor', {
                detail: item
            }).then(function (json) {
                if (json.data.IsSuccess) {
                    layer.alert("保存成功", { icon: 1 });
                } else {
                    layer.alert("保存失败:" + json.data.Message, { icon: 2 });
                }
                layer.close(index);
            }, function (error) {
                layer.alert("保存失败:" + error, { icon: 2 });
                layer.close(index);
            });
        }

        $scope.clearNoNum = function (obj, attr) {
            debugger;
            //先把非数字的都替换掉，除了数字和.
            obj[attr] = obj[attr].replace(/[^\d.]/g, "");
            //必须保证第一个为数字而不是.
            obj[attr] = obj[attr].replace(/^\./g, "");
            //保证只有出现一个.而没有多个.
            obj[attr] = obj[attr].replace(/\.{2,}/g, "");
            //保证.只出现一次，而不能出现两次以上
            obj[attr] = obj[attr].replace(".", "$#$").replace(/\./g, "").replace("$#$", ".");
        }

        function isNumber(val) {

            var regPos = /^\d+(\.\d+)?$/; //非负浮点数
            var regNeg = /^(-(([0-9]+\.[0-9]*[1-9][0-9]*)|([0-9]*[1-9][0-9]*\.[0-9]+)|([0-9]*[1-9][0-9]*)))$/; //负浮点数
            if (regPos.test(val) || regNeg.test(val)) {
                return true;
            } else {
                return false;
            }
        }

        function getWabScore(FollowupXml) {
            var fluencyScore = FollowupXml.FluencyA != null && FollowupXml.FluencyB != null ? FollowupXml.FluencyA * 1 + FollowupXml.FluencyB * 1 : null;
            var listeningComprehensionScore = FollowupXml.ListeningComprehensionA != null && FollowupXml.ListeningComprehensionB != null && FollowupXml.ListeningComprehensionC != null ? (FollowupXml.ListeningComprehensionA * 1 + FollowupXml.ListeningComprehensionB * 1 + FollowupXml.ListeningComprehensionC * 1) / 20 : null;
            var retellScore = FollowupXml.Retell != null ? FollowupXml.Retell * 1 / 10 : null;
            var namedScore = FollowupXml.NamedA != null && FollowupXml.NamedB != null && FollowupXml.NamedC != null && FollowupXml.NamedD != null ? (FollowupXml.NamedA * 1 + FollowupXml.NamedB * 1 + FollowupXml.NamedC * 1 + FollowupXml.NamedD * 1) / 10 : null;
            return { fluencyScore: fluencyScore, listeningComprehensionScore: listeningComprehensionScore, retellScore: retellScore, namedScore: namedScore};
        }

        $scope.CalcAQScore = function (FollowupXml) {
            var scores = getWabScore(FollowupXml);

            if (scores.fluencyScore != null && scores.listeningComprehensionScore != null && scores.retellScore != null && scores.namedScore != null
                && isNumber(scores.fluencyScore) && isNumber(scores.listeningComprehensionScore) && isNumber(scores.retellScore) && isNumber(scores.namedScore)) {
                if (FollowupXml.WabType != "0") { // 已选中无失语时不需要获取失语类型
                    // 根据失语评分获取失语类型
                    GetWabType(FollowupXml,scores.fluencyScore, scores.listeningComprehensionScore, scores.retellScore, scores.namedScore);
                }
                FollowupXml.Aq = ((scores.fluencyScore + scores.listeningComprehensionScore + scores.retellScore + scores.namedScore) * 2).toFixed(2);
                return FollowupXml.Aq;
            } else {
                FollowupXml.Aq = null;
                return null;
            }
        }

        function GetWabType(FollowupXml,fluencyScore, listeningComprehensionScore, retellScore, namedScore) {
            $http.post('/FollowUpManage/GetWabType', { fluencyScore: fluencyScore, listeningComprehensionScore: listeningComprehensionScore, retellScore: retellScore, namedScore: namedScore
            }).then(function (json) {
                if (json.data.IsSuccess) {
                    FollowupXml.WabType = json.data.Data;
                } else {
                    console.log(json.data.Message);
                }
            }, function (error) {
                console.log("请求失败!"+error);
            });
        }

        $scope.noWabClick = function ($event,FollowupXml) {
            var checkbox = $event.target;
            if (checkbox.checked) {
                FollowupXml.WabType = "0";
            } else {
                FollowupXml.WabType = null;
                var scores = getWabScore(FollowupXml);
                if (scores.fluencyScore != null && scores.listeningComprehensionScore != null && scores.retellScore != null && scores.namedScore != null
                    && isNumber(scores.fluencyScore) && isNumber(scores.listeningComprehensionScore) && isNumber(scores.retellScore) && isNumber(scores.namedScore)) {

                    // 根据失语评分获取失语类型
                    GetWabType(FollowupXml,scores.fluencyScore, scores.listeningComprehensionScore, scores.retellScore, scores.namedScore);
                }
            }
        }

        // 选择变化
        $scope.updateSelection = function ($event, index, object) {
            var checkbox = $event.target;
            object[index] = checkbox.checked;
        }

        // 是否选中
        $scope.isSelected = function (index, data) {
            if (data != null) {
                if (data.length > 0) {
                    return data[index];
                }
                else { return false; }
            }
            return false;
        }
        
        $scope.showNihss = function (FollowupXml) {
            $.post('/Estimate/EstimateNIHSS', { registId: $scope.model.RegistId, recordId: FollowupXml.NihssRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                FollowupXml.NihssScore = layero.find("#score").html();
                                FollowupXml.NihssRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }
        $scope.showPhq9 = function (FollowupXml) {
