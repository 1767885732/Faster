                                FollowupXml.IqCodeScore = layero.find("#score").html();
                                FollowupXml.IqCodeRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }
    });

    angular.bootstrap($("#Doctor")[0], ['DoctorApp']);
</script>
<div class="content" style="overflow-x:unset;overflow-y:unset;" id="Doctor" ng-app="DoctorApp" ng-controller="DoctorController">
    <fieldset class="medical-record">
        <div class="content1">
            <div class="main-content1">
                <div class="stats-block">
                    <div class="tab-months">
                        <input ng-repeat="item in model.FollowupDocDetails" type="button" value="{{item.FollowupCalendar.EventDesc}}" class="btn-months" ng-class="item.FollowupCalendar.Id==model.ActiveId?'active':''" ng-click="getByIndex($index,item.FollowupCalendar.Id)" />
                    </div>
                    <div ng-repeat="detail in model.FollowupDocDetails" ng-if="detail.FollowupCalendar.Id==model.ActiveId">
                        <button type="button" class="operating-btn medical-save-btn" ng-click="save(detail)" id="btnSave"><img src="~/App_Themes/Default/img/icon/save.png"></button>
                        <div class="basic-info">
                            <div class="info-label">随访基本信息</div>
                            <hr />
                            <div class="basic-content1">
                                <div style="width:25%;">
                                    <span class="info-label">随访时间</span>
                                    <input class="basic-input" style="width:60%" ng-model="detail.FollowupXml.FollowupDate" id="dFollowupDate" name="FollowupDate" type="datetime" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm'} | json }}">
                                </div>
                                <div style="width:30%;">
                                    <span class="info-label">随访人</span>
                                    <input class="basic-input" style="width:70%" type="text" ng-model="detail.FollowupXml.FollowupDoc" id="FollowupDoc" name="FollowupDoc">
                                </div>
                                <div style="width:25%">
                                </div>
                                <div style="width:25%">
                                </div>
                            </div>
                            <div>
                                <div style="width:100%">
                                    <span class="info-label">是否失访</span>
                                    <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                        <input type="radio" name="IsLossFollowup" ng-model="detail.FollowupXml.IsLossFollowup" value="{{item.Key}}"><span>{{item.Value}}</span>
                                    </label>
                                    <label ng-show="detail.FollowupXml.IsLossFollowup=='1'">
                                        <span style="">失访原因</span>
                                        <label ng-repeat="item in model.LossToVisitCauseDict">
                                            <input type="radio" name="LossToVisitCause" ng-model="detail.FollowupXml.LossToVisitCause" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                        <label>
                                            <input ng-show="detail.FollowupXml.LossToVisitCause=='99'" type="text" name="LossFollowupReasons" ng-model="detail.FollowupXml.LossFollowupReasons" class="txtBorder" style="width:42%;" />
                                        </label>
                                    </label>
                                </div>
                                <div style="width:100%">
                                    <span class="info-label">是否死亡</span>
                                    <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                        <input type="radio" name="IsDie" ng-click="IsDie(item.Key,'1')" ng-model="detail.FollowupXml.IsDie" value="{{item.Key}}"><span>{{item.Value}}</span>
                                    </label>
                                    <label ng-show="detail.FollowupXml.IsDie=='1'">
                                        <span>死亡时间：<input type="datetime" ng-model="detail.FollowupXml.DieTime" id="dDieTime" name="DieTime" class="txtBorder" style="width:150px" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm'} | json }}"></span>
                                    </label>
                                    <label class="info-label">
                                        <span ng-show="detail.FollowupXml.IsDie=='1'">
                                            死亡原因：
                                            <label ng-repeat="item in model.DieCauseDict">
                                                <input type="radio" name="DieCause" ng-model="detail.FollowupXml.DieCause" value="{{item.Key}}"><span>{{item.Value}}</span>
                                            </label>
                                        </span>
                                    </label>
                                </div>
                                <div>
                                    <span class="info-label">是否再次入院</span>
                                    <label>
                                        <input type="radio" value="0" name="IsAgainHospitalized" ng-model="detail.FollowupXml.IsAgainHospitalized" />&nbsp;否&nbsp;&nbsp;
                                    </label>
                                    <label>
                                        <input type="radio" value="1" name="IsAgainHospitalized" ng-model="detail.FollowupXml.IsAgainHospitalized" />&nbsp;是&nbsp;&nbsp;
                                    </label>
                                </div>
                                @*<div style="width:100%">
                                    <span class="info-label">是否结束流程</span>
                                    <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                        <input type="radio" name="IsEnd" ng-change="IsEnd(item.Key,'1')" ng-model="detail.FollowupXml.IsEnd" value="{{item.Key}}"><span>{{item.Value}}</span>
                                    </label>
                                    <label ng-show="detail.FollowupXml.IsEnd=='1'">
                                        结束原因：
                                        <label ng-repeat="item in model.EndCauseDict">
                                            <input type="radio" name="EndCause" ng-model="detail.FollowupXml.EndCause" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </label>
                                </div>*@
                                <div style="width:100%">
                                    <span class="info-label">是否完成本次随访</span>
                                    <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                        <input type="radio" name="IsComplete" ng-model="detail.FollowupXml.IsComplete" value="{{item.Key}}"><span>{{item.Value}}</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="score-table" style="border:1px solid #ededed;overflow: hidden;" ng-show="detail.FollowupXml.IsLossFollowup=='0' && detail.FollowupXml.IsDie=='0' && detail.FollowupXml.IsAgainHospitalized =='0'">
                            <div class="info-label">随访详细信息&nbsp;&nbsp;&nbsp;&nbsp;@*<span class="btn-primary" style="border-radius: 3px;color:white;height: 35px;font-size: 10px;" ng-click="ShowDocScore('1')" ng-show="$scope.patient.Stage !='3'">  评分</span>*@</div>
                            <hr />
                            <div lass="row-box">
                                <h4 class="tit-block">吞咽功能</h4>
                                <div class="row-box">
                                    <div style="width: 25%;float:left;">
                                        <label><b validateSnow="IsTia"></b>缺血性卒中/TIA复发：</label><br />
                                        <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                            <input type="radio" name="IsTia" ng-model="detail.FollowupXml.IsTia" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </div>
                                    <div style="width: 25%;float:left;">
                                        <label><b validateSnow="IsIschemicEvents"></b>其他缺血性事件：</label><br />
                                        <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                            <input type="radio" name="IsIschemicEvents" ng-model="detail.FollowupXml.IsIschemicEvents" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </div>
                                    <div style="width: 25%;float:left;">
                                        <label><b validateSnow="PulmonaryInfection"></b>肺部感染：</label><br />
                                        <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                            <input type="radio" name="PulmonaryInfection" ng-model="detail.FollowupXml.PulmonaryInfection" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </div>
                                    <div style="width: 25%;float:left;">
                                        <label><b validateSnow="DisturbanceConsciou"></b>意识障碍：</label><br />
                                        <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                            <input type="radio" name="DisturbanceConsciou" ng-model="detail.FollowupXml.DisturbanceConsciou" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="mr-row" style="margin-bottom:5px;" ng-show="detail.FollowupXml.DisturbanceConsciou=='0'">
                                    <label class="label-tit" style="text-align:left;min-width:120px;"><b></b>饮水:</label>
                                    <label ng-repeat="item in model.DringkingDict">
                                        <input type="radio" name="Dringking" ng-model="detail.FollowupXml.Dringking" value="{{item.Key}}"><span>{{item.Value}}</span>
                                    </label>
                                </div>
                                <div ng-show="(detail.FollowupXml.Dringking == '2' || detail.FollowupXml.Dringking == '3' || detail.FollowupXml.Dringking == '4' || detail.FollowupXml.Dringking == '5' || detail.FollowupXml.Dringking == '6') && detail.FollowupXml.DisturbanceConsciou=='0'">
                                    <div class="mr-row" style="margin-bottom:5px;">
                                        <label class="label-tit" style="text-align:left;min-width:120px;"><b></b>饮食指导:</label>
                                        <label ng-repeat="item in model.DietaryGuidanceDict">
                                            <input type="radio" name="DietaryGuidance" ng-model="detail.FollowupXml.DietaryGuidance" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </div>
                                    <div id="diet-mouth" ng-show="detail.FollowupXml.DietaryGuidance == '1'">
                                        <div class="mr-row" style="margin-bottom:5px;">
                                            <label class="label-tit" style="text-align:left;min-width:120px;"><b></b>稠度:</label>
                                            <label ng-repeat="item in model.ConsistencyDict">
                                                <input type="radio" name="Consistency" ng-model="detail.FollowupXml.Consistency" value="{{item.Key}}"><span>{{item.Value}}</span>
                                            </label>
                                        </div>
                                        <div class="mr-row" style="margin-bottom:5px;">
                                            <label class="label-tit" style="text-align:left;min-width:120px;"><b></b>一口量:</label>
                                            <label ng-repeat="item in model.BiteSizeDict">
                                                <input type="radio" name="BiteSize" ng-model="detail.FollowupXml.BiteSize" value="{{item.Key}}"><span>{{item.Value}}ml</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="depressed" ng-show="detail.FollowupXml.DisturbanceConsciou=='0'">
                                <h4 class="tit-block">卒中后抑郁</h4>
                                <div class="row-box" style="margin-bottom:5px;">
                                    <div style="width: 25%;float:left;">
                                        <label>是否再次发病：</label><br />
                                        <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                            <input type="radio" name="IsReadmission" ng-model="detail.FollowupXml.IsReadmission" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </div>
                                    <div style="width: 25%;float:left;">
                                        <label><b validateSnow="IsIschemicEvents"></b>是否再次住院：</label><br />
