                                                </td>
                                                <td class="withbg">A 呼名</td>
                                                <td><input type="text" ng-model="detail.FollowupXml.NamedA" ng-keyup="clearNoNum(detail.FollowupXml,'NamedA')" ng-change="CalcAQScore(detail.FollowupXml)"><em style="top:5px;">分</em></td>
                                            </tr>
                                            <tr>
                                                <td>B 语联想</td>
                                                <td><input type="text" ng-model="detail.FollowupXml.NamedB" ng-keyup="clearNoNum(detail.FollowupXml,'NamedB')" ng-change="CalcAQScore(detail.FollowupXml)"><em style="top:5px;">分</em></td>
                                            </tr>
                                            <tr>
                                                <td>C 句子完成</td>
                                                <td><input type="text" ng-model="detail.FollowupXml.NamedC" ng-keyup="clearNoNum(detail.FollowupXml,'NamedC')" ng-change="CalcAQScore(detail.FollowupXml)"><em style="top:5px;">分</em></td>
                                            </tr>
                                            <tr>
                                                <td>D 回答问题</td>
                                                <td><input type="text" ng-model="detail.FollowupXml.NamedD" ng-keyup="clearNoNum(detail.FollowupXml,'NamedD')" ng-change="CalcAQScore(detail.FollowupXml)"><em style="top:5px;">分</em></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="conclusion">
                                        <span class="reuslt">AQ</span>
                                        <div style="position:relative;display:inline;"><input type="text" ng-model="detail.FollowupXml.Aq" style="text-align:center;width:100px;padding-right:15px;" ng-keyup="clearNoNum(detail.FollowupXml,'Aq')" /><em style="position:absolute;top:0;right:10px;">分</em></div>
                                        <div style="margin-left:10px;display:inline;"><input type="checkbox" id="NoWab" name="NoWab" ng-model="detail.FollowupXml.WabType" ng-click="noWabClick($event,detail.FollowupXml)" ng-checked="detail.FollowupXml.WabType=='0'" /><label for="NoWab">无失语</label></div>
                                        <table class="table_wab">
                                            <tr>
                                                <th>失语类型</th>
                                                <th>流畅性</th>
                                                <th>听理解</th>
                                                <th>复述</th>
                                                <th>命名</th>
                                            </tr>
                                            <tr ng-class="detail.FollowupXml.WabType=='1'?'actived':''" ng-click="detail.FollowupXml.WabType='1'">
                                                <td>完全性失语</td>
                                                <td>0--4</td>
                                                <td>0--3.9</td>
                                                <td>0--4.9</td>
                                                <td>0--6</td>
                                            </tr>
                                            <tr ng-class="detail.FollowupXml.WabType=='2'?'actived':''" ng-click="detail.FollowupXml.WabType='2'">
                                                <td>运动性失语</td>
                                                <td>0--5</td>
                                                <td>4--10</td>
                                                <td>0--7.9</td>
                                                <td>0--8</td>
                                            </tr>
                                            <tr ng-class="detail.FollowupXml.WabType=='3'?'actived':''" ng-click="detail.FollowupXml.WabType='3'">
                                                <td>感觉性失语</td>
                                                <td>5--10</td>
                                                <td>0--6.9</td>
                                                <td>0--7.9</td>
                                                <td>0--9</td>
                                            </tr>
                                            <tr ng-class="detail.FollowupXml.WabType=='4'?'actived':''" ng-click="detail.FollowupXml.WabType='4'">
                                                <td>命名性失语</td>
                                                <td>5--10</td>
                                                <td>7--10</td>
                                                <td>7--10</td>
                                                <td>0--9</td>
                                            </tr>
                                            <tr ng-class="detail.FollowupXml.WabType=='5'?'actived':''" ng-click="detail.FollowupXml.WabType='5'">
                                                <td>经皮质混合性失语</td>
                                                <td>0--4</td>
                                                <td>0--3.9</td>
                                                <td>5--10</td>
                                                <td>0--6</td>
                                            </tr>
                                            <tr ng-class="detail.FollowupXml.WabType=='6'?'actived':''" ng-click="detail.FollowupXml.WabType='6'">
                                                <td>经皮质运动性失语</td>
                                                <td>0--4</td>
                                                <td>4--10</td>
                                                <td>8--10</td>
                                                <td>0--8</td>
                                            </tr>
                                            <tr ng-class="detail.FollowupXml.WabType=='7'?'actived':''" ng-click="detail.FollowupXml.WabType='7'">
                                                <td>经皮质感觉性失语</td>
                                                <td>5--10</td>
                                                <td>0--6.9</td>
                                                <td>8--10</td>
                                                <td>0--9</td>
                                            </tr>
                                            <tr ng-class="detail.FollowupXml.WabType=='8'?'actived':''" ng-click="detail.FollowupXml.WabType='8'">
                                                <td>传导性失语</td>
                                                <td>5--10</td>
                                                <td>7--10</td>
                                                <td>0--6.9</td>
                                                <td>0--9</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div class="row-box">
                                    <div style="width: 25%;float:left;margin-top:10px;">
                                        <label><b validateSnow="IsIntervene"></b>是否干预：</label><br />
                                        <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                            <input type="radio" name="IsIntervene" ng-model="detail.FollowupXml.IsIntervene" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </div>
                                    <div style="width: 75%;float:left;margin-top:10px;" ng-show="detail.FollowupXml.IsIntervene=='1'">
                                        <label><b validateSnow="InterveneWay"></b>干预方法：</label><br />
                                        <label ng-repeat="x in model.InterveneWayDict">
                                            <input name="InterveneWay" type="checkbox" ng-checked="isSelected($index,detail.FollowupXml.InterveneWay)" ng-click="updateSelection($event,$index,detail.FollowupXml.InterveneWay)">
                                            <span>{{x.Value}}</span>
                                        </label>
                                        <label>
                                            <input type="text" id="InterveneOther" name="InterveneOther" ng-model="detail.FollowupXml.InterveneOther" ng-show="detail.FollowupXml.InterveneWay[4]" />
                                        </label>
                                    </div>
                                </div>
                                <div class="row-box">
                                    <div style="width: 25%;float:left;margin-top:10px;">
                                        <label><b validateSnow="IsEvaluate"></b>fMRI：</label><br />
                                        <label ng-repeat="item in model.YesOrNoDict.slice().reverse()">
                                            <input type="radio" name="IsFmri" ng-model="detail.FollowupXml.IsFmri" value="{{item.Key}}"><span>{{item.Value}}</span>
                                        </label>
                                    </div>
                                    <div style="width: 25%;float:left;margin-top:10px;" ng-show="detail.FollowupXml.IsFmri == '1'">
                                        <label>影像号:</label><br />
                                        <label><input type="text" ng-model="detail.FollowupXml.ImageNo" style="margin-top:5px;"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
</div>

