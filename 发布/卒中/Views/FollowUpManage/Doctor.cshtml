<style>
    .table_wab {
        width: 100%;
    }

        .table_wab tr {
            height: auto;
            line-height: 24px;
        }

            .table_wab tr th {
                padding: 6px 8px;
                text-align: center;
                border: 1px solid #ddd;
            }

            .table_wab tr td {
                height: auto;
                text-align: center;
                line-height: 22px !important;
                border: 1px solid #ddd;
                padding: 2px 10px;
                line-height: 24px;
                position: relative;
            }

