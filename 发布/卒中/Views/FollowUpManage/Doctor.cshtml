                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                FollowupXml.HamdScore = layero.find("#score").html();
                                FollowupXml.HamdRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }
        $scope.showBi = function (FollowupXml) {
            $.post('/Estimate/EstimateBI', { registId: $scope.model.RegistId, recordId: FollowupXml.BiRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                FollowupXml.BiScore = layero.find("#score").html();
                                FollowupXml.BiRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }
        $scope.showMmse = function (FollowupXml) {
            $.post('/Estimate/EstimateMMSE', { registId: $scope.model.RegistId, recordId: FollowupXml.MmseRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                FollowupXml.MmseScore = layero.find("#score").html();
                                FollowupXml.MmseRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }
        $scope.showMoca = function (FollowupXml) {
            $.post('/Estimate/EstimateMOCA', { registId: $scope.model.RegistId, recordId: FollowupXml.MocaRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                FollowupXml.MocaScore = layero.find("#score").html();
                                FollowupXml.MocaRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }
        $scope.showIqCode = function (FollowupXml) {
            $.post('/Estimate/EstimateIQCODE', { registId: $scope.model.RegistId, recordId: FollowupXml.IqCodeRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
