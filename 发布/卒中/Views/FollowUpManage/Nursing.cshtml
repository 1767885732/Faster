@model DoCare.CVA.Business.Model.FollowupNursingModel
@using DoCare.ToolKit
@using DoCare.Framework.Extension
@{
    Layout = null;
    ViewBag.Title = "Nursing";
}
<style>
    .table_wab {
        width: 100%;
    }

        .table_wab tr {
            height: auto;
            line-height: 24px;
        }

            .table_wab tr th {
                padding: 6px 8px;
                text-align: center;
                border: 1px solid #ddd;
            }

            .table_wab tr td {
                height: auto;
                text-align: center;
                line-height: 22px !important;
                border: 1px solid #ddd;
                padding: 2px 10px;
                line-height: 24px;
                position: relative;
            }

            .table_wab tr:hover td, .table_wab tr.actived td {
                background-color: #dbf0ff !important;
            }


             .check-up {
            margin-left: 0.5%;
            width: 99%;
            font-size: 12px;
        }

            .check-up tr td {
                border: 1px solid #ddd;
                padding: 2px 10px;
                height: 24px;
                line-height: 24px;
            }

                .check-up tr td:nth-child(2n+1) {
                    text-align: right;
                }

                .check-up tr td:nth-child(2n):hover {
                    background-color: #dbf0ff;
                }

                .check-up tr td:nth-child(1) {
                    width: 55%;
                }

                .check-up tr td:nth-child(2) {
                    width: 35%;
                }

                .check-up tr td:nth-child(3) {
                    width: 10%;
                }

                    .check-up tr td:nth-child(2) select, .check-up tr td:nth-child(3) select {
                        width: 100%;
                    }

        h2 {
            margin: 10px 0px 10px 0.5%;
        }

        label {
            color: black;
        }

        .txtBorder {
            border-left: none;
            border-right: none;
            border-top: none;
            width: 50px;
        }
</style>
<link href=@Url.GetCssJsUrl("~/App_Themes/Default/global.css") rel="stylesheet" />
<link href=@Url.GetCssJsUrl("~/App_Themes/Default/frame.css") rel="stylesheet" />
<link href=@Url.GetCssJsUrl("~/App_Themes/Default/control.css") rel="stylesheet" />
<link href="~/Scripts/jquery-easyui/themes/icon.css" rel="stylesheet" />
<link href="~/Scripts/jquery-easyui/themes/default/easyui.css" rel="stylesheet" />
<link href="~/Scripts/ui-grid/ui-grid.min.css" rel="stylesheet" />
<link href=@Url.GetCssJsUrl("~/Scripts/pagination/tm.pagination.css") rel="stylesheet" />
<link href=@Url.GetCssJsUrl("~/App_Themes/Default/page.records.css") rel="stylesheet" />
<link href=@Url.GetCssJsUrl("~/App_Themes/Default/page.followup.css") rel="stylesheet" />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/DatePicker/WdatePicker.js"></script>
<script src="~/Scripts/DoCareMVCComm.js"></script>
<script src="~/Scripts/jquery-ajaxSetup.js"></script>
<script src="~/Scripts/moment.js"></script>
<script src="~/Scripts/layer/layer.js"></script>
<script src="~/Scripts/cookieKit.js"></script>
<script src="~/Scripts/angular/angular.min.js"></script>
<script src="~/Scripts/filterModule.js"></script>
<script src="~/Scripts/directiveModule.js"></script>

<script>
    var model = @Html.Raw(JsonKit.Serialize(Model));
    var app = angular.module('NursingApp', ['mdsdFilter', 'mdsdDirective']);
    app.controller('NursingController', function ($scope, $filter, $http) {
        $scope.model = model;
        $scope.getByIndex = function(index,id)
        {
            $scope.model.ActiveId = id;
        }

        $scope.save = function(item)
        {
            $http.post('/FollowUpManage/SaveNursing', {
                detail: item
            }).then(function (json) {
                if (json.data.IsSuccess) {
                    layer.alert("保存成功", { icon: 1 });
                } else {
                    layer.alert("保存失败:" + json.data.Message, { icon: 2 });
                }
            }, function (error) {
                layer.alert("保存失败:" + error, { icon: 2 });
            });
        }

        // 选择变化
        $scope.updateSelection = function ($event, index, object) {
            var checkbox = $event.target;
            object[index] = checkbox.checked;
        }

        // 是否选中
        $scope.isSelected = function (index, data) {
            if (data != null) {
                if (data.length > 0) {
                    return data[index];
                }
                else { return false; }
            }
            return false;
        }

        $scope.showNihss = function (detail) {
            $.post('/Estimate/EstimateNIHSS', { registId: detail.RegistId, recordId: detail.FollowupNursing.FlupScore.NihssRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                detail.FollowupNursing.FlupScore.NihssScore = layero.find("#score").html();
                                detail.FollowupNursing.FlupScore.NihssRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }

        $scope.showMrs = function (detail) {
            $.post('/Estimate/EstimateMRS', { registId: detail.RegistId, recordId: detail.FollowupNursing.FlupScore.MrsRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                detail.FollowupNursing.FlupScore.MrsScore = layero.find("#score").html();
                                detail.FollowupNursing.FlupScore.MrsRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }

        $scope.showPadua = function (detail) {
            $.post('/Estimate/EstimatePADUA', { registId: detail.RegistId, recordId: detail.FollowupNursing.Dvt.PaduaRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                detail.FollowupNursing.Dvt.PaduaScore = layero.find("#score").html();
                                detail.FollowupNursing.Dvt.PaduaRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }

        $scope.showGcs = function (detail) {
            $.post('/Estimate/EstimateGCS', { registId: detail.RegistId, recordId: detail.FollowupNursing.NeurogenicBladder.GcsRecordId }, function (str) {
                layer.open({
                    id: 'insert-form',
                    type: 1,
                    title: "评分明细",
                    maxmin: false,
                    shadeClose: false, //点击遮罩关闭层
                    area: ['1100px', '560px'],
                    content: str,
                    cancel: function (index, layero) {
                        $scope.$apply(function () {
                            if (layero.find("#scoreChanged").val() == "1") {
                                // 更新分值
                                detail.FollowupNursing.NeurogenicBladder.GcsScore = layero.find("#score").html();
                                detail.FollowupNursing.NeurogenicBladder.GcsRecordId = layero.find("#recordId").val();
                            }
                        });
                    }
                });
            });
        }
    });

    angular.bootstrap($("#Nursing")[0], ['NursingApp']);
</script>
<div class="content" style="overflow-x:unset;overflow-y:unset;" id="Nursing" ng-app="NursingApp" ng-controller="NursingController">
    <fieldset class="medical-record">
        <div class="content1">
            <div class="main-content1">
                <div class="stats-block">
                    <div class="tab-months">
                        <input ng-repeat="item in model.FollowupDetails" type="button" value="{{item.EventDesc}}" class="btn-months" ng-class="item.Id==model.ActiveId?'active':''" ng-click="getByIndex($index,item.Id)" />
                    </div>
                    <div ng-repeat="detail in model.FollowupDetails" ng-if="detail.Id == model.ActiveId">
                        <button type="button" class="operating-btn medical-save-btn" ng-click="save(detail)" id="btnSave"><img src="~/App_Themes/Default/img/icon/save.png"></button>
                        <div class="basic-info">
                            @*<div class="info-label">随访基本信息&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="btn-primary" style="border-radius: 3px;color:white;height: 35px;font-size: 10px;" ng-click="Export()">导出</span></div>*@
                            <div class="basic-content1" style="justify-content:flex-start;">
                                <div style="width:30%">
                                    <span class="info-label">是否完成本次随访</span>
                                    <label>
                                        <input type="radio" name="IsComplete" ng-model="detail.FollowupNursing.FlupBaseInfo.IsComplete" value="1">&nbsp;<span>是</span>
                                    </label>
                                    <label>
                                        <input type="radio" name="IsComplete" ng-model="detail.FollowupNursing.FlupBaseInfo.IsComplete" value="0">&nbsp;<span>否</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="score-table" style="border:1px solid #ededed">
                            <div id="divMain" class="score-detail">
                                <fieldset class="medical-record">
                                    <div style="width:100%;">
                                        <div class="info-label">随访详细信息</div>
                                        <table class="check-up">
                                            <tr>
                                                <td style="width:20%;">
                                                    <strong>本次随访时间：</strong>
                                                </td>
                                                <td style="width:75%;">
                                                    <label>
                                                        <input type="datetime" ng-model="detail.FollowupNursing.FlupBaseInfo.FollowupDate" id="FollowupDate" name="FollowupDate" class="txtBorder" style="width:150px" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm'} | json }}">
                                                        &nbsp;&nbsp;随访人（医生/护士）：<input type="text" ng-model="detail.FollowupNursing.FlupBaseInfo.FollowupDoc" name="FollowupDoc" class="txtBorder" style="width:200px;" />
                                                    </label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:20%;">
                                                    <strong>随访方式：</strong>
                                                </td>
                                                <td style="width:75%;">
                                                    <label>
                                                        <input type="radio" value="1" name="FollowUpType" ng-model="detail.FollowupNursing.FlupBaseInfo.FollowUpType" />&nbsp;电话&nbsp;&nbsp;
                                                    </label>
                                                    <label>
                                                        <input type="radio" value="2" name="FollowUpType" ng-model="detail.FollowupNursing.FlupBaseInfo.FollowUpType" />&nbsp;网络&nbsp;&nbsp;
                                                    </label>
                                                    <label>
                                                        <input type="radio" value="99" name="FollowUpType" ng-model="detail.FollowupNursing.FlupBaseInfo.FollowUpType" />&nbsp;其他&nbsp;&nbsp;
                                                    </label>
                                                    <label>
                                                        <input ng-show="detail.FlupBaseInfo.FollowUpType=='99'" type="text" ng-model="detail.FollowupNursing.FlupBaseInfo.FollowUpTypeOther" name="FollowUpTypeOther" class="txtBorder" style="width:100px;" />
                                                    </label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:20%;">
                                                    <strong>是否失访：</strong>
                                                </td>
                                                <td style="width:75%;">
                                                    <label>
                                                        <input type="radio" value="0" name="IslossToVisit" ng-model="detail.FollowupNursing.FlupBaseInfo.IslossToVisit" />&nbsp;否&nbsp;&nbsp;
                                                    </label>
                                                    <label>
                                                        <input type="radio" value="1" name="IslossToVisit" ng-model="detail.FollowupNursing.FlupBaseInfo.IslossToVisit" />&nbsp;是
                                                    </label>
                                                    <label ng-show="detail.FollowupNursing.FlupBaseInfo.IslossToVisit=='1'">
                                                        &nbsp;&nbsp;&nbsp;&nbsp;失访原因：
                                                        <label>
                                                            <input type="radio" value="1" name="LossToVisitCause" ng-model="detail.FollowupNursing.FlupBaseInfo.LossToVisit.LossToVisitCause" />&nbsp;失去联系&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input type="radio" value="2" name="LossToVisitCause" ng-model="detail.FollowupNursing.FlupBaseInfo.LossToVisit.LossToVisitCause" />&nbsp;拒绝参加调查&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input type="radio" value="99" name="LossToVisitCause" ng-model="detail.FollowupNursing.FlupBaseInfo.LossToVisit.LossToVisitCause" />&nbsp;其他&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input ng-show="detail.FollowupNursing.FlupBaseInfo.LossToVisit.LossToVisitCause=='99'" type="text" name="LossToVisitOther" ng-model="detail.FollowupNursing.FlupBaseInfo.LossToVisit.LossToVisitOther" class="txtBorder" style="width:100px;" />
                                                        </label>
                                                    </label>
                                                </td>
                                            </tr>
                                            <tr ng-show="detail.FollowupNursing.FlupBaseInfo.IslossToVisit=='0'">
                                                <td style="width:20%;">
                                                    <strong>是否死亡：</strong>
                                                </td>
                                                <td style="width:75%;">
                                                    <label>
                                                        <input type="radio" value="0" name="IsDie" ng-click="IsDie('0','2')" ng-model="detail.FollowupNursing.FlupBaseInfo.IsDie" />&nbsp;否&nbsp;&nbsp;
                                                    </label>
                                                    <label>
                                                        <input type="radio" value="1" name="IsDie" ng-click="IsDie('1','2')" ng-model="detail.FollowupNursing.FlupBaseInfo.IsDie" />&nbsp;是
                                                        <span ng-show="detail.FollowupNursing.FlupBaseInfo.IsDie=='1'">
                                                            ，死亡原因：
                                                            <label><input type="radio" value="1" name="DieCause" ng-model="detail.FollowupNursing.FlupBaseInfo.Die.DieCause" />&nbsp;脑卒中&nbsp;&nbsp;</label>
                                                            <label><input type="radio" value="2" name="DieCause" ng-model="detail.FollowupNursing.FlupBaseInfo.Die.DieCause" />&nbsp;冠心病&nbsp;&nbsp;</label>
                                                            <label><input type="radio" value="3" name="DieCause" ng-model="detail.FollowupNursing.FlupBaseInfo.Die.DieCause" />&nbsp;恶性肿瘤&nbsp;&nbsp;</label>
                                                            <label><input type="radio" value="4" name="DieCause" ng-model="detail.FollowupNursing.FlupBaseInfo.Die.DieCause" />&nbsp;呼吸系统疾病&nbsp;&nbsp;</label>
                                                            <label><input type="radio" value="5" name="DieCause" ng-model="detail.FollowupNursing.FlupBaseInfo.Die.DieCause" />&nbsp;损伤和中毒&nbsp;&nbsp;</label>
                                                            <label><input type="radio" value="6" name="DieCause" ng-model="detail.FollowupNursing.FlupBaseInfo.Die.DieCause" />&nbsp;其他&nbsp;&nbsp;</label>
                                                            <label><input type="radio" value="7" name="DieCause" ng-model="detail.FollowupNursing.FlupBaseInfo.Die.DieCause" />&nbsp;不详</label><br />
                                                        </span>
                                                        <span ng-show="detail.FollowupNursing.FlupBaseInfo.IsDie=='1'">死亡时间：<input type="datetime" ng-model="detail.FollowupNursing.FlupBaseInfo.Die.DieTime" id="DieTime" name="DieTime" class="txtBorder" style="width:150px" date-picker="{{ {dateFmt:'yyyy-MM-dd HH:mm'} | json }}"></span>
                                                    </label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:20%;">
                                                    <strong>是否再次入院：</strong>
                                                </td>
                                                <td style="width:75%;">
                                                    <label>
                                                        <input type="radio" value="0" name="IsAgainHospitalized" ng-model="detail.FollowupNursing.FlupBaseInfo.IsAgainHospitalized" />&nbsp;否&nbsp;&nbsp;
                                                    </label>
                                                    <label>
                                                        <input type="radio" value="1" name="IsAgainHospitalized" ng-model="detail.FollowupNursing.FlupBaseInfo.IsAgainHospitalized" />&nbsp;是&nbsp;&nbsp;
                                                    </label>
                                                </td>
                                            </tr>
                                        </table>
                                        <div ng-show="detail.FollowupNursing.FlupBaseInfo.IsDie=='0' && detail.FollowupNursing.FlupBaseInfo.IslossToVisit=='0' && detail.FollowupNursing.FlupBaseInfo.IsAgainHospitalized=='0'">
                                            <div class="info-label">随访期间基本情况</div>
                                            <table class="check-up">
                                                <tr>
                                                    <td style="width:20%;">
                                                        <strong>随访期间就诊信息：</strong>
                                                    </td>
                                                    <td style="width:75%;">
                                                        <label>
                                                            门诊就诊次数：
                                                            <input type="text" ng-model="detail.FollowupNursing.FlupBaseSituation.OutpatientVisits" name="OutpatientVisits" class="txtBorder" style="width:10%" />次，急诊就诊次数：
                                                            <input type="text" ng-model="detail.FollowupNursing.FlupBaseSituation.EmergencyVisits" name="EmergencyVisits" class="txtBorder" style="width:10%" />次，住院次数：
                                                            <input type="text" ng-model="detail.FollowupNursing.FlupBaseSituation.HospitalizationCount" name="HospitalizationCount" class="txtBorder" style="width:10%" />次，
                                                            月均门诊医疗费用：<input type="text" ng-model="detail.FollowupNursing.FlupBaseSituation.OutpatientMedExpenses" name="OutpatientMedExpenses" class="txtBorder" style="width:10%" />元
                                                        </label>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:20%;">
                                                        <strong>随访期间护理人员：</strong>
                                                    </td>
                                                    <td style="width:75%;">
                                                        <label>
                                                            <input type="checkbox" value="1" name="NursingStaff" ng-checked="isSelected(0,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" ng-click="updateSelection($event,0,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" />&nbsp;家属&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input type="checkbox" value="2" name="NursingStaff" ng-checked="isSelected(1,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" ng-click="updateSelection($event,1,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" />&nbsp;医疗机构护理人员&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input type="checkbox" value="3" name="NursingStaff" ng-checked="isSelected(2,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" ng-click="updateSelection($event,2,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" />&nbsp;保姆&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input type="checkbox" value="4" name="NursingStaff" ng-checked="isSelected(3,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" ng-click="updateSelection($event,3,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" />&nbsp;自我照顾&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input type="checkbox" value="99" name="NursingStaff" ng-checked="isSelected(4,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" ng-click="updateSelection($event,4,detail.FollowupNursing.FlupBaseSituation.NursingStaff)" />&nbsp;其他
                                                        </label>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width:20%;">
                                                        <strong>随访期间工作情况：</strong>
                                                    </td>
                                                    <td style="width:75%;">
                                                        <label>
                                                            <input type="radio" ng-model="detail.FollowupNursing.FlupBaseSituation.WorkSituation" value="1" name="WorkSituation" />&nbsp;正常工作&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input type="radio" ng-model="detail.FollowupNursing.FlupBaseSituation.WorkSituation" value="2" name="WorkSituation" />&nbsp;出勤减少&nbsp;&nbsp;
                                                        </label>
                                                        <label>
                                                            <input type="radio" ng-model="detail.FollowupNursing.FlupBaseSituation.WorkSituation" value="3" name="WorkSituation" />&nbsp;不工作
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                            <div class="info-label">随访期间新发事件</div>
                                            <table class="check-up">
                                                <tr>
                                                    <td colspan="2"><strong>随访期间新发疾病事件（期间存在多次发作的，发病时间填写第一次发病时间）</strong></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="2">
                                                        <label>
                                                            <input type="checkbox" ng-checked="isSelected(0,detail.FollowupNursing.FlupNewDisease.NewDisease)" ng-click="updateSelection($event,0,detail.FollowupNursing.FlupNewDisease.NewDisease)" value="1" name="NewDisease" />&nbsp;卒中
                                                            <label ng-show="detail.FollowupNursing.FlupNewDisease.NewDisease[0]">
                                                                <label>
                                                                    ，卒中类型：
                                                                    <input type="checkbox" ng-checked="isSelected(0,detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaType)" ng-click="updateSelection($event,0,detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaType)" value="1" name="CvaType" />&nbsp;脑梗死&nbsp;&nbsp;
                                                                </label>
                                                                <label>
                                                                    <input type="checkbox" ng-checked="isSelected(1,detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaType)" ng-click="updateSelection($event,1,detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaType)" value="2" name="CvaType" />&nbsp;脑出血&nbsp;&nbsp;
                                                                </label>
                                                                <label>
                                                                    <input type="checkbox" ng-checked="isSelected(2,detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaType)" ng-click="updateSelection($event,2,detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaType)" value="3" name="CvaType" />&nbsp;蛛网膜下腔出血&nbsp;&nbsp;
                                                                </label>
                                                                <label>
                                                                    <input type="checkbox" ng-checked="isSelected(3,detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaType)" ng-click="updateSelection($event,3,detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaType)" value="4" name="CvaType" />&nbsp;其他未分类卒中，发病时间：
                                                                </label>
                                                                <label>
                                                                    <input type="text" name="CvaYear" ng-model="detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaYear" class="txtBorder" />年
                                                                    <input type="text" name="CvaMonth" ng-model="detail.FollowupNursing.FlupNewDisease.CvaDisease.CvaMonth" class="txtBorder" />月
                                                                </label>
                                                            </label>
                                                        </label><br />

                                                        <label>
                                                            <input type="checkbox" ng-checked="isSelected(1,detail.FollowupNursing.FlupNewDisease.NewDisease)" ng-click="updateSelection($event,1,detail.FollowupNursing.FlupNewDisease.NewDisease)" value="2" name="NewDisease" />&nbsp;TIA
                                                            <label ng-show="detail.FollowupNursing.FlupNewDisease.NewDisease[1]">
