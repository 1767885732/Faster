<ul class="path" ng-if="Treatment.TreatmentDecision==1&&Treatment.IsThrom=='1'">
    <li>
        <span ng-class="emergency.RegistrationTime!=null ? 'done' : ''"></span>
        <h5>分诊挂号<i>{{emergency.RegistrationTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="emergency.OpenVeinTime!=null ? 'done' : ''"></span>
        <h5>开通静脉<i>{{emergency.OpenVeinTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="inspectionItems.BloodCollectionTime!=null ? 'done' : ''"></span>
        <h5>采血<i>{{inspectionItems.BloodCollectionTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="vitalSign.CollectionTime!=null ? 'done' : ''"></span>
        <h5>生命体征采集<i>{{vitalSign.CollectionTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="emergency.EcgTime!=null ? 'done' : ''"></span>
        <h5>心电图检查<i>{{emergency.EcgTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="emergency.CtOpenTime!=null ? 'done' : ''"></span>
        <h5>CT开单时间<i>{{emergency.CtOpenTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="emergency.ExamineOpenTime!=null ? 'done' : ''"></span>
        <h5>检验开单时间<i>{{emergency.ExamineOpenTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="Ass.ScoringTime!=null ? 'done' : ''"></span>
        <h5>NIHSS评分{{Ass.ScoreValue}}<i>{{Ass.ScoringTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="emergency.CtStartTime!=null ? 'done' : ''"></span>
        <h5>CT扫描时间<i>{{emergency.CtStartTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="emergency.CtEndTime!=null ? 'done' : ''"></span>
        <h5>出CT室时间<i>{{emergency.CtEndTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
    <li>
        <span ng-class="emergency.ExamineResultTime!=null ? 'done' : ''"></span>
        <h5>检验结果<i>{{emergency.ExamineResultTime | date:"yyyy-MM-dd HH:mm"}}</i></h5>
    </li>
</ul>

