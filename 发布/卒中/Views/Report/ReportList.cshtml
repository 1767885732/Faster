<div class="content">
    <!--搜索条件-->
    <div class="form-common qc-search">
        <fieldset>
            <div class="row-box">
                <label>医院名称</label>
                @Html.DropDownList("hospital", ViewBag.HospitalList as List<SelectListItem>, new { onchange = "loadChart('slide1')" })
            </div>
            <div class="row-box">
                <label>卒中统计</label>
                @Html.TextBox("sTime", "", new { @class = "Wdate", @onfocus = @"WdatePicker({skin:'whyGreen',dateFmt:'yyyy年M月', maxDate: '#F{$dp.$D(\'eTime\')}'})", @onchange = "loadChart('slide1');", @style = "width:40%; float:left" }) ~
                @Html.TextBox("eTime", "", new { @class = "Wdate", @onfocus = @"WdatePicker({skin:'whyGreen',dateFmt:'yyyy年M月', minDate: '#F{$dp.$D(\'sTime\')}'})", @onchange = "loadChart('slide1');", @style = "width:40%; float:right" })

                <span id="month1" class="left" onclick="setTime(6); setSelected('month', 1, 3);">最近六月</span>
                <span id="month2" class="selected" onclick="setTime(3); setSelected('month', 2, 3);">最近三月</span>
                <span id="month3" class="right" onclick="setTime(1); setSelected('month', 3, 3);">最近一月</span>
            </div>
            <div class="row-box">
                <label>报表类型</label>
                <select id="reportType">
                    <option value="1">月报表</option>
                    <option value="2">周报表</option>
                </select>
            </div>
        </fieldset>
    </div>
    <!--图表-列表切换-->
    <div class="change">
        <a onclick="setTab('change',1,2)" id="change1" class="hover"><img src="~/App_Themes/Default/img/qc/chart.png" width="80" height="80"></a>
        <a onclick="setTab('change',2,2)" id="change2"><img src="~/App_Themes/Default/img/qc/list.png" width="80" height="80"></a>
    </div>
