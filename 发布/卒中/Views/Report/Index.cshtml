@using DoCare.Framework.Extension;
<link rel="stylesheet" type="text/css" href=@Url.GetCssJsUrl("~/App_Themes/Default/global.css")>
<link rel="stylesheet" type="text/css" href=@Url.GetCssJsUrl("~/App_Themes/Default/frame.css")>
<link rel="stylesheet" type="text/css" href=@Url.GetCssJsUrl("~/App_Themes/Default/control.css")>
<link rel="stylesheet" type="text/css" href=@Url.GetCssJsUrl("~/App_Themes/Default/page.qc.css")>

<script type="text/javascript">
    function changeMenu(event) {
        $(event).siblings().removeClass("active");
        $(event).addClass("active");

        $.post($(event).attr("url"), {}, function (viewHtml) {
            $('#container').html();
            $('#container').html(viewHtml);
        });
    }

    $(function () {
        var mainId = $('.nav_menu').find("li[class='selected']").attr('data-menuId');

        // 获取功能菜单
        $.get('/Report/GetFuncMenu', { mainId: mainId }, function (data) {
            var html = "";
            for (var i in data) {
                html += "<a url='" + data[i].Action + "' href='javascript:void(0)' onclick='changeMenu(this)'><i class='" + data[i].Icon + "'></i>" + data[i].Name + "</a>";
            }
            $('#nav-list').html(html);

            $("#nav-list").find("a").first().click();
        });
    });

    var tempData = { isEdit: false };
</script>

<div class="layout-sidebar-menu left">
    <div class="menu-block">
        <span id="nav-list">

        </span>
    </div>
</div>
<div id="container" class="layout-container layout-container-box left">

</div>
