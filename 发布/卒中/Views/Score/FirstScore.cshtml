
@using DoCare.ToolKit
@{
    ViewBag.Title = "卒中评分";
    Layout = null;
}

<script src="~/Scripts/hover.js"></script>
<script src="~/Scripts/echarts.js"></script>
<script src="~/Scripts/JSLINQ.js"></script>
<script>
    var patient =  @Html.Raw((JsonKit.Serialize(ViewBag.Patient)));
    var templateList =  @Html.Raw((JsonKit.Serialize(ViewBag.TemplateList)));
    var PermissionSave = @Html.Raw((JsonKit.Serialize(ViewBag.PermissionSave)));
    $(function () {
        var app = angular.module('ScoreApp', []);

        // 日期控件指令
        app.directive('wdatePicker', function () {
            return {
                restrict: "A",
                link: function (scope, element, attr) {
                    element.bind('click', function () {
                        window.WdatePicker({
                            onpicked: function () { element.change() },
                            oncleared: function () { element.change() },
                            dateFmt: 'yyyy-MM-dd HH:mm'
                        })
                    });
                }
            }
        });
        // controller
        app.controller('ScoreController', function ($scope, $filter, $http) {
            $scope.PermissionSave = PermissionSave;
            // 患者信息
            $scope.patient = patient;
            // 评分模板列表
            $scope.registId = patient.Id;
            // 默认评分次数选项卡，默认选择第一次
            $scope.defaultIndex = 0;
            $scope.ManualTotalScore = 0;
            $scope.ShowScoreValue = 0;
            // 评分配置
            $scope.templateList = templateList;
            if($scope.templateList==null ||$scope.templateList.length==0)
            {
                return ;
            }
            var RootList = JSLINQ($scope.templateList).Distinct(function(item){ return item.Root; }).items;
            var typeMenu = new Array();
            for (var i = 0; i < RootList.length; i++) {
                typeMenu.push({Root:RootList[i],BgC:JSLINQ($scope.templateList).Where(function(item){return item.Root==RootList[i]}).Select(function(item){ return item; }).FirstOrDefault().BgC})
            }
            $scope.typeMenu = typeMenu;

            // 选择小类（评分模板）
            $scope.getTemplate = function (index)
            {
                // 默认选中第一个模板
                $scope.templateIndex = index;
                // 第一个评分模板基本信息
                $scope.template = $scope.templateList[$scope.templateIndex];
                // 评分类型 默认为第一个评分类型
                $scope.recordType = $scope.template.ScoreType;
            }

            // 默认选择第一个小类
            $scope.getTemplate(0);

            // 获取患者评分列表（根据类型）
            $scope.getScoreList = function(recordId){
                $scope.defaultIndex = 0;
                $http({
                    method: 'GET',
                    url: '/Score/GetScoreList?registId=' + $scope.registId + '&recordType=' + $scope.recordType + '&takeFirst=true'
                }).then(function successCallback(response) {
                    if(response.data.IsSuccess){
                        $scope.scoreList = response.data.Data;
                        if($scope.scoreList != null && $scope.scoreList.length > 0)
                        {
                            $scope.defaultIndex = $scope.scoreList.length - 1;
                            // 默认会加载第一次数据
                            if(recordId == null ||recordId == "")
                            {
                                recordId = $scope.scoreList[$scope.defaultIndex].ScoreRecordId
                            }
                            for (var i = 0; i <= $scope.scoreList.length; i++)
                            {
                                if ($scope.scoreList[i].ScoreRecordId == recordId)
                                {
                                    $scope.ManualTotalScore = parseInt($scope.scoreList[i].ScoreValue) | 0;
                                    break;
                                }
                            }                            
                            $scope.getRecord(recordId);
                        }
                        else{
                            $scope.record = {};
                        }
                    }
                    else
                    {
                        layer.alert(response.data.Message, { icon: 2 });
                    }
                }, function errorCallback(response) {
                    // 请求失败执行代码
                    layer.alert("请求失败！", { icon: 2 });
                });
            }
            // 获取某一次评分记录
            $scope.getRecord = function(recordId)
            {
                $scope.record = {};
                $http({
                    method: 'GET',
                    url: '/Score/GetRecord?registerID=' + $scope.registId + '&scoreRecordID=' + recordId
                }).then(function successCallback(response) {
                    if(response.data.IsSuccess){
                        $scope.record = response.data.Data;
                        if($scope.record!=null && $scope.record.ScoringTime!=null &&$scope.record.ScoringTime!='')
                        {
                            // 对时间格式：/Date(1448864369815)/ 的格式化
                            $scope.record.ScoringTime = $filter("date")($scope.record.ScoringTime.replace(/\/Date\((\d+)\)\//, "$1"), "yyyy-MM-dd HH:mm");
                        }
                    }
                    else
                    {
                        layer.alert(response.data.Message, { icon: 2 });
                    }
                }, function errorCallback(response) {
                    // 请求失败执行代码
                    layer.alert("请求失败！", { icon: 2 });
                });
            }

            // 获取当前时间
            $scope.getCurrentTime = function()
            {
                //类型：HAT = 1, LADS = 2, NIHSS = 3, STAF = 4
                if($scope.record!=null){
                    $scope.record.ScoringTime = $filter('date')(new Date(),'yyyy-MM-dd HH:mm');
                }
                $scope.saveRecord();
            }

            // 文本框输入分值
            $scope.changeScore = function($event,score,key,oldValue,title,enumItems){
                if($scope.template.ScoreType==6)
                {
                    return;
                }
                var hasScore = false; // 是否有此分值的选项
                var value;
                for (var i = 0; i < enumItems.length; i++) {
                    var enumItem = enumItems[i];
                    if(enumItem.ScoreValue == score)
                    {
                        value = enumItem.Value;
                        hasScore = true;
                    }
                }
                if(hasScore)
                {
                    $scope.updateSelection(key,value,score,oldValue,title);
                }
                else
                {
                    var msg = "没有"+score+"分值的选项";
                    layer.tips(msg, $event.target, {
                        tips: [2, '#ed4e2a'],
                        time: 3000
                    });
                }
            }
            // 单选变化
            $scope.updateSelection = function (key, value, score, oldValue, title) {
                $scope.ShowScoreValue = 1;
                if(value!=oldValue){
                    // 特殊情况如果NiHiss 1a评分为3分，其中1b, 1c默认2分
                    var special = false;
                    if($scope.recordType==3 && title.indexOf("1a")>-1 && score == "3")
                    {
                        special = true;
                    }
                    $scope.itemKeyValueList = new Array();
                    $scope.record.ScoreValue = 0;
                    for (var i = 0; i < $scope.record.ItemCategories[0].Items.length; i++) {
                        var item = $scope.record.ItemCategories[0].Items[i];
                        if(special && (item.Title.indexOf("1b")>-1 || item.Title.indexOf("1c")>-1 || item.Title.indexOf("8")>-1 || item.Title.indexOf("10")>-1 || item.Title.indexOf("11")>-1))
                        {
                            item.Score = 2;
                            item.Value = "3";
                            $scope.itemKeyValueList.push({Key:item.ID,Value:item.Value});
                        }
                        else if(special && (item.Title.indexOf("4")>-1 || item.Title.indexOf("9")>-1))
                        {
                            item.Score = 3;
                            item.Value = "4";
                            $scope.itemKeyValueList.push({Key:item.ID,Value:item.Value});
                        }
                        else if(special && (item.Title.indexOf("5")>-1 || item.Title.indexOf("6")>-1) )
                        {
                            item.Score = 4;
                            item.Value = "5";
                            $scope.itemKeyValueList.push({Key:item.ID,Value:item.Value});
                        }
                        else if(item.ID==key)
                        {
                            item.Score = parseInt(score);
                            item.Value = value;
                            $scope.itemKeyValueList.push({Key:item.ID,Value:value});
                        }
                        // NHISS评分9分不计总分
                        if($scope.template.ScoreType==3)
                        {
                            $scope.record.ScoreValue += (item.Score!=null && item.Score!=9)?item.Score:0;
                        }
                        else
                        {
                            $scope.record.ScoreValue += (item.Score!=null)?item.Score:0;
                        }
                    }
                    $scope.saveMultiData(JSON.stringify($scope.itemKeyValueList),$scope.record.ScoreValue);
                }
            }
            // 多选变化
            $scope.multiSelect = function ($event, key, value, score, oldValue) {
                $scope.ShowScoreValue = 1;
                var checkbox = $event.target;
                for (var i = 0; i < $scope.record.ItemCategories[0].Items.length; i++) {
                    var item = $scope.record.ItemCategories[0].Items[i];

                    if(item.ID==key)
                    {
                        if(checkbox.checked){
                            item.Score = item.Score - parseInt(score);
                            $scope.record.ScoreValue =  $scope.record.ScoreValue - parseInt(score);
                            item.Value = addValue(item.Value,value);
                            value = item.Value;
                        }
                        else
                        {
                            item.Score = item.Score + parseInt(score);
                            $scope.record.ScoreValue =  $scope.record.ScoreValue + parseInt(score);
                            item.Value = delValue(item.Value,value);
                            value = item.Value;
                        }
                    }
                }
                var data = {Key:key,Value:value};
                $scope.saveSingleData(JSON.stringify(data),$scope.record.ScoreValue);
            }
            // 多选变化
            $scope.multiSelectAdd = function ($event, key, value, score, oldValue) {
                $scope.ShowScoreValue = 1;
                var checkbox = $event.target;
                for (var i = 0; i < $scope.record.ItemCategories[0].Items.length; i++) {
                    var item = $scope.record.ItemCategories[0].Items[i];

                    if(item.ID==key)
                    {
                        if(checkbox.checked){
                            item.Score = item.Score + parseInt(score);
                            $scope.record.ScoreValue =  $scope.record.ScoreValue + parseInt(score);
                            item.Value = addValue(item.Value,value);
                            value = item.Value;
                        }
                        else
                        {
                            item.Score = item.Score - parseInt(score);
                            $scope.record.ScoreValue =  $scope.record.ScoreValue - parseInt(score);
                            item.Value = delValue(item.Value,value);
                            value = item.Value;
                        }
                    }
                }
                var data = {Key:key,Value:value};
                $scope.saveSingleData(JSON.stringify(data),$scope.record.ScoreValue);
            }
            // 下拉框选择
            $scope.selectChanged = function(key,value,score)
            {
                $scope.record.ScoreValue = 0;
                for (var i = 0; i < $scope.record.ItemCategories[0].Items.length; i++) {
                    var item = $scope.record.ItemCategories[0].Items[i];

                    if(item.ID==key)
                    {
                        item.Score =  score|0;
                        item.Value = value;
                    }
                    $scope.record.ScoreValue += item.Score|0;
                }

                var data = {Key:key,Value:value};
                $scope.saveSingleData(JSON.stringify(data),$scope.record.ScoreValue);
            }
            // 文本框输入
            $scope.textChanged = function(key,value)
            {             
                $scope.record.ScoreValue = 0;
                for (var i = 0; i < $scope.record.ItemCategories[0].Items.length; i++) {
                    var item = $scope.record.ItemCategories[0].Items[i];

                    if(item.ID==key)
                    {
                        item.Score =  parseInt(value)|0;
                        item.Value = parseInt(value)|0;
                    }
                    $scope.record.ScoreValue += item.Value|0;
                }
                $scope.ManualTotalScore = parseInt($scope.record.ScoreValue) | 0;
                var data = {Key:key,Value:parseInt(value)};
                $scope.saveSingleData(JSON.stringify(data),$scope.record.ScoreValue);
            }

            // 第几次tab选择样式
            $scope.getClass = function(index)
            {
                if(index == $scope.defaultIndex)
                {
                    return "hover";
                }
                else
                {
                    return null;
                }
            }
            // 第几次tab选择变化
            $scope.changeTab = function(index,recordId)
            {
                if($scope.defaultIndex != index)
                {
                    if(recordId == null)
                    {
                        recordId = $scope.scoreList[index].ScoreRecordId;
                    }
                    $scope.getRecord(recordId);
                    $scope.defaultIndex = index;
                }
            }
            // 保存评分
            $scope.saveSingleData = function(itemKeyValue,totalScore)
            {
                if(!$scope.PermissionSave)
                {
                    return;
                }
                $http({
                    method: 'POST',
                    url: '/Score/SaveSingleScore',
                    data: { registId: $scope.registId,recordId:$scope.record.ID,itemValue:itemKeyValue,totalScore:totalScore}
                }).then(function successCallback(response) {
                    if(response.data.IsSuccess){
                    }
                    else
                    {
                        layer.alert(response.data.Message, { icon: 2 });
                    }
                }, function errorCallback(response) {
                    // 请求失败执行代码
                    layer.alert("请求失败！", { icon: 2 });
                });
            }
            // 保存评分
            $scope.saveMultiData = function(itemKeyValue,totalScore)
            {
                if(!$scope.PermissionSave)
                {
                    return;
                }
                $http({
                    method: 'POST',
                    url: '/Score/SaveMultiScore',
                    data: { registId: $scope.registId,recordId:$scope.record.ID,itemValue:itemKeyValue,totalScore:totalScore}
                }).then(function successCallback(response) {
                    if(response.data.IsSuccess){
                    }
                    else
                    {
                        layer.alert(response.data.Message, { icon: 2 });
                    }
                }, function errorCallback(response) {
                    // 请求失败执行代码
                    layer.alert("请求失败！", { icon: 2 });
                });
            }

            $scope.SaveScore = function(tScore)
            {
                $scope.ManualTotalScore = parseInt(tScore) | 0;;
                $scope.ShowScoreValue = 0;

                $http({
                    method: 'POST',
                    url: '/Score/SaveScore',
                    data: {
                        registId: $scope.registId,
                        recordId: $scope.record.ID,
                        totalScore: tScore
                    }
                }).then(function successCallback(response) {
                    if (!response.data.IsSuccess) {
                        layer.alert(response.data.Message, { icon: 2 });
                    }
                }, function errorCallback(response) {
                    // 请求失败执行代码
                    layer.alert("请求失败！", { icon: 2 });
                });
            }

            // 保存记录（评分时间、评分医生）
            $scope.saveRecord = function(showSuccessTip)
            {
                if($scope.record == null)
                {
                    return;
                }
                if(!$scope.PermissionSave)
                {
                    return;
                }
                $http({
                    method: 'POST',
                    url: '/Score/SaveRecord',
                    data: {
                        recordType:$scope.recordType
                        ,recordId:$scope.record.ID
                        ,scoringTime:$scope.record.ScoringTime
                        ,doctor:$scope.record.Doctor
                    }
                }).then(function successCallback(response) {
                    if(response.data.IsSuccess){
                        if(showSuccessTip)
                        {
                            layer.alert("保存成功", { icon: 1 });
                        }
                    }
                    else
                    {
                        layer.alert(response.data.Message, { icon: 2 });
                    }
                }, function errorCallback(response) {
                    // 请求失败执行代码
                    layer.alert("请求失败！", { icon: 2 });
                });
            }
            // 保存
            $scope.save = function()
            {
                $scope.saveRecord(true);
            }
            // 获取所以评分key-value值
            $scope.getItemKeyValue = function()
            {
                $scope.itemKeyValueList = new Array();
                for (var i = 0; i < $scope.record.ItemCategories[0].Items.length; i++) {
                    var item = $scope.record.ItemCategories[0].Items[i];
                    $scope.itemKeyValueList.push({Key:item.ID,Value:item.Value});
                }
            }
            // 是否选中
            $scope.isSelected = function (key, value, checkedValue) {
                return $.inArray( value, checkedValue==null?null:checkedValue.split(";")) >= 0;
            }
            // 首次加载评分
            $scope.getScoreList();
            // 评分模板tab选择
            $scope.setTab = function(index)
            {
                $scope.ShowScoreValue = 1;
                $scope.getTemplate(index);
                $scope.getScoreList();
            };
            // 评分模板tab样式
            $scope.getTabClass = function(index)
            {
                if(index == $scope.templateIndex)
                {
                    return "hover";
                }
                else
                {
                    return null;
                }
            }
            // 评分模板tab选择
            $scope.setRoot = function(Root,index)
            {
                // 根据index获取模板列表
                $scope.getTemplateList(index);
                $scope.getTemplate(0);
                $scope.getScoreList();
            };
            // 评分模板tab样式
            $scope.getRootClass = function(index)
            {
                if(index == $scope.rootIndex)
                {
                    return "hover";
                }
                else
                {
                    return null;
                }
            }
        });

        // 自定义过滤器
        app.filter('NoShowNull', function() { //可以注入依赖
            return function(text) {
                return text=="null"?"":text;
            }
        });

        angular.bootstrap($("#divScore")[0], ['ScoreApp']);
    });
</script>
<script>
    // 字符中添加值 demo:"1;2;3" 添加"4"
    function addValue(total,value)
    {
        // 判断原有数据是否为null，如果为null直接赋值
        //if(total!=null)
        if(total)
        {
            // 转换成数组
            var totalArr = total.split(";");
            // 没有直接添加，有则忽略
            if($.inArray(value, totalArr)==-1)
            {
                // 添加
                totalArr.push(value);
                // 重新转换成字符串
                total = totalArr.join(";");
            }
        }
        else
        {
            total = value;
        }
        return total;
    }

    // 字符中去除值  demo:"1;2;3" 删除"2"
    function delValue(total,value)
    {
        // 转换成数组
        var totalArr = total.split(";");
        // 查找位置
        var index = $.inArray(value, totalArr);
        // 存在直接去除
        if(index>-1)
        {
            // 删除
            totalArr.splice(index,1);
            // 重新转换成字符串
            total = totalArr.join(";");
        }
        return total;
    }
</script>
<div id="divScore" ng-app="ScoreApp" ng-controller="ScoreController">
    <button class="operating-btn medical-save-btn" ng-click="save()" ng-if="false" id="btnSave"><img src="~/App_Themes/Default/img/icon/save.png"></button>
    <span class="score-sign">
        <span ng-repeat-start="x in typeMenu" class="{{x.BgC}}"></span>
        <strong ng-repeat-end>{{x.Root}}</strong>
    </span>
    <ul class="tab m-t-10">
        <li ng-repeat="t in templateList" ng-class="t.BdC">
            <a ng-click="setTab($index)" id="score{{$index}}" ng-class="getTabClass($index)">{{t.Name}}</a>
        </li>
    </ul>
    <div id="con-score" class="con-score" ng-if="scoreList.length>0">
        <div class="tab-with-btn m-b-10">
            <a id="ASPECT-{{$index}}" ng-repeat="x in scoreList" ng-class="getClass($index)" ng-click="changeTab($index,x.ScoreRecordId)">
                首次评分
            </a>
        </div>
        <div class="score-box">
            @Html.Partial("../Score/_Record")
        </div>
    </div>
</div>
<script>
    function subNav(obj) {
        $(obj).toggleClass("currentDd").siblings(".subNav").removeClass("currentDd");
        // 修改数字控制速度， slideUp(0)控制卷起速度
        $(obj).next(".navContent").slideToggle(100).siblings(".navContent").slideUp(100);
    }
</script>


