@{
    Layout = "~/Views/Shared/_LayoutIframe.cshtml";
}
@using DoCare.ToolKit;
<link href="~/App_Themes/Default/page.check.css" rel="stylesheet" />
<script src="~/Scripts/DoCareMVCComm.js"></script>
<style>
    .ClassOne {
        background-color: #e8e8e8 !important;
    }

    .ClassTwo {
        background-color: white !important;
    }
</style>

<script>
    var lastTag = "";
    var lastClass = "";
    var org = @Html.Raw(JsonKit.Serialize(ViewBag.Org));
    var patientNo = @Html.Raw(JsonKit.Serialize(ViewBag.PatientNo));
    var app = angular.module('ngMedication', ['mdsdFilter']);

    app.controller('MedicationController', function ($scope, $filter, $http) {
        //$scope.Medications = medicationInfo.Medications;

        //medicationInfo.Medications.forEach(function (e) {
        //    e.Items.forEach(function (x) {
        //        if (x.OrderNo == lastTag) {
        //            x.class = lastClass;
        //        } else {
        //            if (lastClass == "ClassOne") {
        //                x.class = "ClassTwo";
        //            } else {
        //                x.class = "ClassOne";
        //            }
        //            lastClass = x.class;
        //        }
        //        lastTag = x.OrderNo;
        //    });
        //    lastClass = "";
        //    lastTag = "";
        //});

        $scope.Medications = null;
        $scope.HasData = false;
        $scope.IsLoaded = false;
        $scope.Refresh = function () {
            var index = layer.load(2);

            $.ajax({
                url: '/ExtendView/RefreshMedication?patientNo='+patientNo+'&org='+org,
                type: "get",
                success: function (result) {
                    if (result.IsSuccess) {
                        $scope.$apply(function () {
                            layer.close(index);
                            //layer.msg("刷新成功！");
                            $scope.Medications = result.Data.Medications;
                            $scope.HasData = result.Data.Medications && result.Data.Medications.length > 0;
                            $scope.IsLoaded = true;
                        });
                    }
                }
            });
        }

        $scope.Refresh();
    });
</script>

<div ng-app="ngMedication" ng-controller="MedicationController" style="margin-bottom: 50px;">
    <div ng-if="HasData&&IsLoaded" class="event" ng-repeat="me in Medications">
        <div class="tit">
            <h1>用药单</h1>
            <span class="right">
                <img src="~/App_Themes/Default/img/icon/refresh.png" style="width:29px;cursor:pointer;" ng-click="Refresh()" />
            </span>
        </div>
        <div class="event-info">
            <dl>
                <dt>姓名</dt>
                <dd>{{me.PatientName|emptyReplace}}</dd>
            </dl>
            <dl>
                <dt>性别</dt>
                <dd>{{me.PatientGender|emptyReplace}}</dd>
            </dl>
            <dl>
                <dt>年龄</dt>
                <dd>{{me.PatientAge|emptyReplace}}</dd>
            </dl>

        </div>
        <div class="event-con">
            <table class="basic-table">
                <tr>
                    <th>序号</th>
                    <th>组</th>
                    <th>长临</th>
                    <th>药品名</th>
                    <th>规格</th>
                    <th>剂量</th>
                    <th>单位</th>
                    <th>途径</th>
                    <th>频次</th>
                    <th>总量</th>
                </tr>
                <tr ng-repeat="item in me.Items" class="{{item.class}}">
                    <td>{{$index+1}}</td>
                    <td>{{item.OrderSubNo|emptyReplace}}</td>
                    <td>{{item.RepeatIndicator|emptyReplace}}</td>
                    <td>{{item.DrugName|emptyReplace}}</td>
                    <td>{{item.DrugSpec|emptyReplace}}</td>
                    <td>{{item.DailyDose|emptyReplace}}</td>
                    <td>{{item.Units|emptyReplace}}</td>
                    <td>{{item.Administration|emptyReplace}}</td>
                    <td>{{item.Ddds|emptyReplace}}</td>
                    <td>{{item.TotalDose|emptyReplace}}</td>
                </tr>
            </table>
        </div>
        <!--
            <div class="event-foot">
                <dl>
                    <dt>开药医生</dt>
                    <dd>{{me.Doctor|emptyReplace}}</dd>
                </dl>
                <dl>
                    <dt>开药时间</dt>
                    <dd>{{me.Time|dateFmt:'YYYY-MM-DD HH:mm:ss'|emptyReplace}}</dd>
                </dl>
            </div>
        -->
    </div>
    <div ng-if="!HasData&&IsLoaded">
        @{ Html.RenderPartial("NoCollect");}
    </div>
</div>
