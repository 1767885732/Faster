<?xml version="1.0" encoding="utf-8"?>
<Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Template Name="NIHSS" Title="美国国立卫生研究院卒中量表" >
    <Group>
      <RadioBox Code="NIHSS001" Title="1a 意识水平" Desc="即使不能全面评价（如气管插管、语言障碍、气管创伤、绷带包扎等），检查者也必须选择1个反应。只在病人对有害刺激无反应时（不是反射），方记录3分。">
        <Option Id="01" Text="清醒，反应灵敏" Score="0"/>
        <Option Id="02" Text="嗜睡，轻微刺激能唤醒，可回答问题，执行指令" Score="1"/>
        <Option Id="03" Text="昏睡或反应迟钝，需反复刺激、强烈或疼痛刺激才有非刻板的反应" Score="2"/>
        <Option Id="04" Text="昏迷，仅有反射性活动或自发性反应或完全无反应、软瘫、无反射" Score="3"/>
      </RadioBox>
      <RadioBox Code="NIHSS002" Title="1b 意识水平提问:（仅对最初回答评分，检查者不要提示）" Desc="询问月份，年龄。回答必须正确，不能大致正常。失语和昏迷者不能理解问题记2分，病人因气管插管、气管创伤、严重构音障碍、语言障碍或其他任何原因不能说话者（非失语所致）记1分。">
        <Option Id="01" Text="两项均正确" Score="0"/>
        <Option Id="02" Text="一项正确" Score="1"/>
        <Option Id="03" Text="两项均不正确" Score="2"/>
      </RadioBox>
      <RadioBox Code="NIHSS003" Title="1c 意识水平指令" Desc="要求睁眼、闭眼：非瘫痪手握拳、张手。若双手不能检查，用另一个指令（伸舌）。仅对最初的反应评分，有明确努力但未完成也给评分。若对指令无反应，用动作示意，然后记录评分。对创伤、截肢或其他生理缺陷者，应给予一个适宜的指令。">
        <Option Id="01" Text="两项均正确" Score="0"/>
        <Option Id="02" Text="一项正确" Score="1"/>
        <Option Id="03" Text="两项均不正确" Score="2"/>
      </RadioBox>
      <RadioBox Code="NIHSS004" Title="2 凝视" Desc="只测试水平眼球运动。对自主或反射性（眼头）眼球运动记分。若眼球恻视能被自主或反射性活动纠正，记录1分。若为孤立性外周神经麻痹（Ⅲ、Ⅳ、Ⅴ），记1分。在失语病人中，凝视是可测试的。眼球创伤、绷带包扎、盲人或有视觉或视野疾病的患者，由检查者选择一种反射性运动来测试。建立与眼球的联系，然后从一侧向另一侧运动，偶能发现凝视麻痹。">
        <Option Id="01" Text="正常" Score="0"/>
        <Option Id="02" Text="部分凝视麻痹（单眼或双眼凝视异常，但无被动凝视或完全凝视麻痹）" Score="1"/>
        <Option Id="03" Text="被动凝视或完全凝视麻痹（不能被眼头动作克服）" Score="2"/>
      </RadioBox>
      <RadioBox Code="NIHSS005" Title="3 视野" Desc="用手指数或视威胁方法检测上、下象限视野。如果病人能看到侧面的手指，记录正常。如果单眼盲或眼球摘除，检查另一只眼。明确的非对称盲（包括象限盲），记1分。病人全盲（任何原因）记3分，同时刺激双眼。若人濒临死亡记1分，结果用于回答问题11。">
        <Option Id="01" Text="无视野缺失" Score="0"/>
        <Option Id="02" Text="部分偏盲" Score="1"/>
        <Option Id="03" Text="完全偏盲" Score="2"/>
        <Option Id="04" Text="双侧偏盲" Score="3"/>
      </RadioBox>
      <RadioBox Code="NIHSS006" Title="4 面瘫" Desc="言语指令或动作示意，要求病人示齿、扬眉和闭眼。对反应差或不能理解的病人，根据有害刺激时表情的对称情况评分。有面部创伤/绷带、经口气管插管、胶布或其他物理障碍影响面部检查时，应尽可能移至可评估的状态。">
        <Option Id="01" Text="正常" Score="0"/>
        <Option Id="02" Text="最小（鼻唇沟变平、微笑时不对称）" Score="1"/>
        <Option Id="03" Text="部分（下面部完全或几乎完全瘫痪，中枢性瘫）" Score="2"/>
        <Option Id="04" Text="完全（单或双侧瘫痪，上下面部缺乏运动，周围性瘫）" Score="3"/>
      </RadioBox>
      <RadioBox Code="NIHSS007" Title="5a 左上肢运动" Desc="上肢伸展：坐位90°，位卧45°。要求坚持10秒；对失语的病人用语言或动作鼓励，不用有害刺激。评定者可以抬起病人的上肢到要求的位置，鼓励病人坚持。">
        <Option Id="01" Text="上肢于要求位置坚持10秒，无下落" Score="0"/>
        <Option Id="02" Text="上肢能抬起，但不能维持10秒，下落时不撞击床或其他支持物" Score="1"/>
        <Option Id="03" Text="能对抗一些重力，但上肢不能达到或维持坐位90°或位卧45°，较快下落到床上" Score="2"/>
        <Option Id="04" Text="不能抗重力，上肢快速下落" Score="3"/>
        <Option Id="05" Text="无运动" Score="4"/>
        <Option Id="06" Text="截肢或关节融合" Score="9"/>
      </RadioBox>
      <RadioBox Code="NIHSS008" Title="5b 右上肢运动" Desc="上肢伸展：坐位90°，位卧45°。要求坚持10秒；对失语的病人用语言或动作鼓励，不用有害刺激。评定者可以抬起病人的上肢到要求的位置，鼓励病人坚持。">
        <Option Id="01" Text="上肢于要求位置坚持10秒，无下落" Score="0"/>
        <Option Id="02" Text="上肢能抬起，但不能维持10秒，下落时不撞击床或其他支持物" Score="1"/>
        <Option Id="03" Text="能对抗一些重力，但上肢不能达到或维持坐位90°或位卧45°，较快下落到床上" Score="2"/>
        <Option Id="04" Text="不能抗重力，上肢快速下落" Score="3"/>
        <Option Id="05" Text="无运动" Score="4"/>
        <Option Id="06" Text="截肢或关节融合" Score="9"/>
      </RadioBox>
      <RadioBox Code="NIHSS009" Title="6a 左下肢运动" Desc="下肢卧位抬高30o，坚持5秒；对失语的病人用语言或动作鼓励，不用有害刺激。评定者可以抬起病人的上肢到要求的位置，鼓励病人坚持。">
        <Option Id="01" Text="于要求位置坚持5秒，不下落" Score="0"/>
        <Option Id="02" Text="在5秒末下落，不撞击床" Score="1"/>
        <Option Id="03" Text="5秒内较快下落到床上，但可抗重力" Score="2"/>
        <Option Id="04" Text="快速落下，不能抗重力" Score="3"/>
        <Option Id="05" Text="无运动" Score="4"/>
        <Option Id="06" Text="截肢或关节融合" Score="9"/>
      </RadioBox>
      <RadioBox Code="NIHSS010" Title="6b 右下肢运动" Desc="下肢卧位抬高30o，坚持5秒；对失语的病人用语言或动作鼓励，不用有害刺激。评定者可以抬起病人的上肢到要求的位置，鼓励病人坚持。">
        <Option Id="01" Text="于要求位置坚持5秒，不下落" Score="0"/>
        <Option Id="02" Text="在5秒末下落，不撞击床" Score="1"/>
        <Option Id="03" Text="5秒内较快下落到床上，但可抗重力" Score="2"/>
        <Option Id="04" Text="快速落下，不能抗重力" Score="3"/>
        <Option Id="05" Text="无运动" Score="4"/>
        <Option Id="06" Text="截肢或关节融合" Score="9"/>
      </RadioBox>
      <RadioBox Code="NIHSS011" Title="7 共济失调" Desc="目的是发现双侧小脑病变的迹象。实验时双眼睁开，若有视觉缺损，应确保实验在无缺损视野内进行。双侧指鼻、跟膝胫试验，共济失调与无力明显不呈比例时记分。如病人不能理解或肢体瘫痪不记分。盲人用伸展的上肢摸鼻。若为截肢或关节融合，记录9分，并解释清楚。">
        <Option Id="01" Text="没有共济失调" Score="0"/>
        <Option Id="02" Text="一个肢体有" Score="1"/>
        <Option Id="03" Text="两个肢体均有" Score="2"/>
      </RadioBox>
      <RadioBox Code="NIHSS012" Title="8 感觉" Desc="用针检查。测试时，用针尖刺激和撤除刺激观察昏迷或失语病人的感觉和表情。只对与卒中有关的感觉缺失评分。偏身感觉丧失者需要精确检查，应测试身体多处部位：上肢（不包括手）、下肢、躯干、面部。严重或完全的感觉缺失，记2分。昏迷或失语者可记1或0分。脑干卒中双侧感觉缺失记2分。无反应及四肢瘫痪者记2分。昏迷病人（1a＝3）记2分。">
        <Option Id="01" Text="正常，没有感觉缺失" Score="0"/>
        <Option Id="02" Text="轻到中度，患侧针刺感不明显或为钝性或仅有触觉" Score="1"/>
        <Option Id="03" Text="严重到完全感觉缺失，面、上肢 下肢无触觉" Score="2"/>
      </RadioBox>
      <RadioBox Code="NIHSS013" Title="9 语言" Desc="命名、阅读测试。要求病人叫出物品名称、读所列的句子。从病人的反应以及一般神经系统检查中对指令的反应判断理解能力。若视觉缺损干扰测试，可让病人识别放在手上的物品，重复和发音。气管插管者手写回答。昏迷病人（1a＝3），3分，给恍惚或不合作者选择一个记分，但3分仅给哑人或一点都不执行指令的人。">
        <Option Id="01" Text="正常，无失语" Score="0"/>
        <Option Id="02" Text="轻到中度：流利程度和理解能力有一些缺损，但表达无明显受限。" Score="1"/>
        <Option Id="03" Text="严重失语，交流是通过病人破碎的语言表达，听者须推理、询问、猜测，能交换的信息范围有限，检查者感交流困难。" Score="2"/>
        <Option Id="04" Text="哑或完全失语，不能讲或不能理解" Score="3"/>
      </RadioBox>
      <RadioBox Code="NIHSS014" Title="10 构音障碍" Desc="不要告诉病人为什么做测试。读或重复附表上的单词。若病人有严重的失语，评估自发语言时发音的清晰度。若病人气管插管或其他物理障碍不能讲话，记9分。同时注明原因和情况。">
        <Option Id="01" Text="正常" Score="0"/>
        <Option Id="02" Text="轻到中度，至少有一些发音不清，虽有困难，但能被理解" Score="1"/>
        <Option Id="03" Text="言语不清，不能被理解" Score="2"/>
        <Option Id="04" Text="气管插管或其他物理障碍" Score="9"/>
      </RadioBox>
      <RadioBox Code="NIHSS015" Title="11 忽视症" Desc="若病人严重视觉缺失影响双侧视觉的同时检查，皮肤刺激正常，则记分为正常。若病人失语，但确实表现为关注双侧，记分正常。通过检验病人对左右侧同时发生的皮肤感觉和视觉刺激的识别能力来判断病人是否有忽视。把标准图显示给病人，要求他来描述。医生鼓励病人仔细看图，识别图中左右侧的特征。如果病人不能识别一侧图的部分内容，则定为异常。然后，医生请病人闭眼，分别测上或下肢针刺觉来检查双侧皮肤感觉。若病人有一侧感觉忽略则为异常。">
        <Option Id="01" Text="没有忽视症" Score="0"/>
        <Option Id="02" Text="视、触、听、空间觉或个人的忽视；或对任何一种感觉的双侧同时刺激消失" Score="1"/>
        <Option Id="03" Text="严重的偏身忽视；超过一种形式的偏身忽视；不认识自己的手，只对一侧空间定位" Score="2"/>
      </RadioBox>
    </Group>
  </Template>
</Config>