    <Item Code="3" Name="症状出现小于4.5h"/>
  </Dictionary>
  <Dictionary Code="CVA.0531" Name="溶栓排除标准" Desc="ThromExclusionCriteria">
    <Item Code="1" Name="近3个月内重大头颅外伤或卒中史"/>
    <Item Code="2" Name="可疑蛛网膜下腔出血"/>
    <Item Code="3" Name="近7天内有在不易压迫止血部位的动脉穿刺"/>
    <Item Code="4" Name="既往史有颅内出血史"/>
    <Item Code="5" Name="有颅内肿瘤、动静脉畸形，动脉瘤"/>
    <Item Code="6" Name="近期颅内或椎管手术"/>
    <Item Code="7" Name="血压升高（收缩压≥180mmHg或舒张压≥100mmHg）"/>
    <Item Code="8" Name="活动性内出血"/>
    <Item Code="9" Name="急性出血倾向，包括血小板计数低于100*109/L或其他情况" />
    <Item Code="10" Name="48小时内接受过肝素治疗（APTT超出正常范围上限）" />
    <Item Code="11" Name="已口服抗凝剂者，INR＞1.7或PT＞15s"/>
    <Item Code="12" Name="目前正常使用凝血酶抑制剂或Xa因子抑制剂，各种敏感的实验室检查异常（APTT、INR、血小板数、ECT、TT、或恰当的Xa活性测定等）"/>
    <Item Code="13" Name="血糖＜2.7mmol/L"/>
    <Item Code="14" Name="CT提示多脑叶梗死（低密度＞1/3大脑半球）"/>
  </Dictionary>
