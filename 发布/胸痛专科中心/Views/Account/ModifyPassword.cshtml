@using DoCare.ToolKit;
@{
    ViewBag.Title = "DoCare心血管数据管理云平台V2.0";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>修改密码</title>
    @*<link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />*@
    <meta name="viewport" content="width=device-width" />
    <link href="~/App_Themes/Default/global.css" rel="stylesheet" type="text/css" />
    <link href="~/App_Themes/Default/frame.css" rel="stylesheet" type="text/css" />
    <link href="~/App_Themes/Default/control.css" rel="stylesheet" type="text/css" />
    <link href="~/App_Themes/Default/page.login.css" rel="stylesheet" type="text/css" />


    <script src="~/Scripts/extension/vue.js"></script>
    <link href="~/Scripts/extension/el/index.css" rel="stylesheet" />
    <script src="~/Scripts/extension/el/index.js"></script>
    <script src="~/Scripts/extension/axios.min.js"></script>
    <script src="~/Scripts/extension/polyfill.min.js"></script>
    <script src="~/Scripts/docare/md5.js"></script>

    <script>
        var Model =  @Html.Raw(JsonKit.Serialize(ViewBag.ModifyPassword));
    </script>
</head>
<body>
    <div id="container">
        <div id="login-panel">
            <div class="sys-name">
                <h2>@Resources.AppName</h2>
                @*<span>版本号:<i>@(Resources.AppVersion)</i></span>*@
                <img src="~/App_Themes/Default/img/login/sys.png" />
            </div>
            <div id="login_form">
                <el-form label-position="top" v-bind:model="loginModel" :rules="rules" ref="ruleForm" :hide-required-asterisk="true">
                    <el-form-item>
                        <h1>密码修改</h1>
                    </el-form-item>
                    <el-form-item label="用户名" prop="Name">
                        <el-input v-model="loginModel.Name" v-on:keyup.13.native="submitForm('ruleForm')" size="mini" v-bind:disabled="true"></el-input>
                    </el-form-item>
                    <el-form-item label="新密码" prop="LoginPassword">
                        <el-input type="password" v-model="loginModel.LoginPassword" autocomplete="off" v-on:keyup.13.native="submitForm('ruleForm')" size="mini"></el-input>
                    </el-form-item>
                    <el-form-item label="确认新密码" prop="ConfirmPassword">
                        <el-input type="password" v-model="loginModel.ConfirmPassword" autocomplete="off" v-on:keyup.13.native="submitForm('ruleForm')" size="mini"></el-input>
                    </el-form-item>
                    <el-form-item>
                        <el-button-group>
                            <el-button type="primary" v-on:click="submitForm('ruleForm')" size="mini" style="width:50%;">保存</el-button>
                            <el-button v-on:click="resetForm('ruleForm')" size="mini" style="width:50%;">重置</el-button>
                        </el-button-group>
                    </el-form-item>
                </el-form>
            </div>
            <p id="copyright">@Resources.CopyRight</p>
        </div>
    </div>
    <script>
        new Vue({
            el: "#login_form",
            data: function() {
                var validatePass = (rule, value, callback) => {
                    if (value === '') {
                        callback(new Error('请输入密码'));
                    } else {
                        if (this.loginModel.LoginPassword !== '') {
                            this.$refs.ruleForm.validateField('checkPass');
                        }
                        callback();
                    }
                };
                var validatePass2 = (rule, value, callback) => {
                    if (value === '') {
                        callback(new Error('请再次输入密码'));
                    } else if (value !== this.loginModel.LoginPassword) {
                        callback(new Error('两次输入密码不一致!'));
                    } else {
                        callback();
                    }
                };
                return {
                    loginModel:Model,
                    rules: {
                        LoginPassword: [
                          { validator: validatePass, trigger: 'blur' }
                        ],
                        ConfirmPassword: [
                          { validator: validatePass2, trigger: 'blur' }
                        ],
                    }
                }
            },
            methods: {
                submitForm: function (formName) {
                    var _this = this;
                    this.$refs[formName].validate(function(valid) {
                        if (valid) {
                            //_this.loginModel.LoginPassword = hex_md5(_this.loginModel.LoginPassword);
                            axios.post("/Account/Change", _this.loginModel).then(function (res) {
                                if (res.data.IsSuccess) {
                                    _this.$message({
                                        type: 'success',
                                        message: '修改成功!'
                                    });
                                } else {
                                    _this.$message.error(res.data.Message);
                                }
                            }).catch(function (error) {
                                console.log(error);
                                _this.$message.error('连接服务器出错');
                            });
                        } else {
                            console.log('error submit!!');
                            return false;
                        }
                    });
                },
                resetForm(formName) {
                    this.$refs[formName].resetFields();
                }
            }
        });
    </script>
</body>
</html>
