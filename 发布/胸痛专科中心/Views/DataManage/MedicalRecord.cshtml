                                <el-form-item label="住院天数">
                                    <span>{{patient.Discharge.Hod}}天</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="总费用">
                                    <span>{{patient.Discharge.TotalCost}} 元</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="患者转归" size="mini">
                                    <span>{{OutcomeCodeDesc}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>

