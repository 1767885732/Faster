                                <el-col v-bind:span="8">
                                    <el-form-item label="药物名称">
                                        <span>{{dapt.Code}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="频次">
                                        <span>{{dapt.RateCount}}{{dapt.RateTime}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="剂量">
                                        <span>{{dapt.Dose}}mg</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>

                            <el-row v-bind:gutter="24" v-if="IsCpc() && IsLeave()">
                                <el-col v-bind:span="8">
                                    <el-form-item label="ACEI/ARB">
                                        <span>{{patient.Discharge.IsAceiOrArb}}</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>
                            <el-row v-bind:gutter="24" v-for="(aceiorarb,index) in patient.DischargeDrugs.Aceiorarb" v-bind:key="'AceiorarbItem-' + index" v-if="IsCpc() && IsLeave() && patient.Discharge.IsAceiOrArb == '是'">
                                <el-col v-bind:span="8">
                                    <el-form-item label="药物名称">
                                        <span>{{aceiorarb.Code}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="频次">
                                        <span>{{aceiorarb.RateCount}}{{aceiorarb.RateTime}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="剂量">
                                        <span>{{aceiorarb.Dose}}mg</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>

                            <el-row v-bind:gutter="24" v-if="IsCpc() && IsLeave()">
                                <el-col v-bind:span="8">
                                    <el-form-item label="调脂药物">
                                        <span>{{patient.Discharge.IsLipidRegulation}}</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>
                            <el-row v-bind:gutter="24" v-for="(statins,index) in patient.DischargeDrugs.Statins" v-bind:key="'StatinsItem-' + index" v-if="IsCpc() && IsLeave() && patient.Discharge.IsLipidRegulation == '是'">
