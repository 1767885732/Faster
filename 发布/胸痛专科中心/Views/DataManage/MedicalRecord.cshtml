                            <el-row v-bind:gutter="24" v-if="IsCpc() && IsLeave()">
                                <el-col v-bind:span="8">
                                    <el-form-item label="抗血小板药物">
                                        <span>{{patient.Discharge.IsAntiplatelet}}</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>
