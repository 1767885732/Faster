                                <el-form-item label="死亡时间">
                                    <span>{{patient.Discharge.DeathTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="死亡原因">
                                    <span>{{patient.Discharge.DeathCause}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="死亡原因描述">
                                    <span>{{patient.Discharge.DeathCauseDesc}}</span>
                                </el-form-item>
