                        <!-- 患者情况备注 -->
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="患者情况备注">
                                    <span>{{patient.Discharge.PatientRemarks}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                </el-form>
            </el-main>
        </el-container>
    </el-container>
</div>
