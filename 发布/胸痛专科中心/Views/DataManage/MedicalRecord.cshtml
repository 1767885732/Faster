@using DoCare.ToolKit;
@using DoCare.Framework.Extension;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutMedicalRecord.cshtml";
}
<script src="~/Views/DataManage/AsideTimeline.js"></script>
<script type="text/javascript" src="~/Scripts/extension/element-china-area-data/app.js"></script>
<script type="text/javascript" src="~/Scripts/extension/html2canvas.js"></script>
<script type="text/javascript" src="~/Scripts/extension/jspdf.debug.js"></script>
<script>
    var model = @Html.Raw(JsonKit.Serialize(ViewBag.Model));
    console.log("model:",model);
</script>
<style>
    [v-cloak] {
        display: none;
    }

    .el-scrollbar__wrap {
        overflow-x: hidden;
    }

    .medicalrecord {
        width: 1024px;
        margin: 10px auto;
    }

        .medicalrecord h1 {
            text-align: center;
            line-height: 50px;
            font-size: 24px;
        }

        .medicalrecord .el-form {
            margin: 5px 10px;
        }

        .medicalrecord .el-form-item {
            margin-bottom: 0px;
        }

        .medicalrecord .el-form-item__label {
            text-align: left !important;
            padding: 0 5px 0 0;
        }

        .medicalrecord .subtitle {
            background-color: #ffffff !important;
            border-width: 0px !important;
            line-height: 40px;
            height: 32px;
        }

        .medicalrecord .operate-panel {
            margin-top: -30px;
            position: relative;
            float: right;
            right: 10px;
        }
</style>
<div id="medicalrecord" v-cloak class="medicalrecord">
    <el-container>
        <el-header height="36px">
            <el-form v-bind:model="emr" label-width="120px" size="small">
                <el-row v-bind:gutter="24">
                    <el-col v-bind:span="24">
                        <h1>{{patient.Regist.HospitalName}}胸痛患者病历</h1>
                        <div class="operate-panel">
                            <el-button type="primary" icon="el-icon-printer" v-on:click="print()" size="mini" id="printButton">打印</el-button>
                        </div>
                    </el-col>
                </el-row>
            </el-form>
        </el-header>
        <el-container>
            <!-- 时间轴 -->
            @*<el-aside width="240px">
                <aside-timeline v-bind:id="registId" ref="timeline"></aside-timeline>
                </el-aside>*@
            <el-main>
                <el-form v-bind:model="patient" label-width="120px" size="small">
                    <el-tag style="width:100%;">基本信息</el-tag>
                    <el-row v-bind:gutter="24">
                        <el-col v-bind:span="8">
                            <el-form-item label="姓名">
                                <span>{{patient.Regist.Name}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="性别">
                                <span>{{patient.Regist.Gender}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="年龄">
                                <span>{{patient.Regist.Age}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="出生日期">
                                <span>{{patient.Regist.Birthday}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="身高">
                                <span>{{patient.Regist.Height}} cm</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="体重">
                                <span>{{patient.Regist.Weight}} kg</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="职业">
                                <span>{{patient.Regist.Job}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="民族">
                                <span>{{patient.Regist.Nationality}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="婚姻状况">
                                <span>{{patient.Regist.Marriage}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="文化程度">
                                <span>{{patient.Regist.CultureDegree}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="联系电话">
                                <span>{{patient.Regist.PhoneNumber}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item v-bind:label="patient.Regist.IdCard">
                                <span>{{patient.Regist.IdCardNo}}</span>
                            </el-form-item>
                        </el-col>
                    </el-row>
                    <el-tag style="width:100%;">急救信息</el-tag>
                    <el-row v-bind:gutter="24">
                        <el-col v-bind:span="8">
                            <el-form-item label="门诊ID">
                                <span>{{patient.Admission.OutpatientNo}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="住院ID">
                                <span>{{patient.Admission.InpatientNo}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="发病时间">
                                <span>{{patient.Admission.AttackTime}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8" v-if="patient.Admission.IsAttackUncertain == '1'">
                            <el-form-item label="发病区间">
                                <span>{{patient.Admission.AttackZone}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="16">
                            <el-form-item label="发病地址">
                                <span>{{patient.Admission.AttackProvince}}{{patient.Admission.AttackCity}}{{patient.Admission.AttackArea}}{{patient.Admission.AttackAddress}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="医保类型">
                                <span>{{patient.Admission.Insurance}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="医保编号">
                                <span>{{patient.Admission.InsuranceNo}}</span>
                            </el-form-item>
                        </el-col>
                        <el-col v-bind:span="8">
                            <el-form-item label="大病医保">
                                <span>{{patient.Admission.IsStrickenInsurance}}</span>
                            </el-form-item>
                        </el-col>
                    </el-row>
                    <!--病情现况-->
                    <div>
                        <el-tag size="mini" class="subtitle">病情现况</el-tag>
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="胸痛评估">
                                    <span>{{patient.Admission.DistressCase}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="16">
                                <el-form-item label="其他症状">
                                    <span>{{patient.Admission.DistressCaseDetail}} </span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--来院方式-->
                    <div>
                        <el-tag size="mini" class="subtitle">来院方式</el-tag>
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="来院方式">
                                    <span>{{patient.Admission.ComingType}} </span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--呼救（120或其他）出车-->
                    <div v-if="patient.Admission.ComingType=='呼救（120或其他）出车'">
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="出车单位">
                                    <span>{{patient.Admission.AmbulanceDepartment}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="呼救时间">
                                    <span>{{patient.Admission.HelpTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="到达本院大门时间">
                                    <span>{{patient.Admission.ArrivedHospitalTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="直接转送上级医院">
                                    <span>{{patient.Admission.IsTransHospital}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="首次医疗接触时间">
                                    <span>{{patient.Admission.FmcTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="首诊医师接诊时间">
                                    <span>{{patient.Admission.AdmissionTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="医护人员">
                                    <span>{{patient.Admission.AdmissionDoctor}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--转院（包含任何机构）-->
                    <div v-if="patient.Admission.ComingType=='转院（包含任何医疗机构）'">
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="转院类型">
                                    <span>{{patient.Admission.ZcyyType}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="医院名称">
                                    <span>{{patient.Admission.ZcyyHospitalName}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="首次医疗接触时间">
                                    <span>{{patient.Admission.FmcTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="转出医院入门时间">
                                    <span>{{patient.Admission.ZcyyVisitTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="决定转院时间">
                                    <span>{{patient.Admission.ZcyyDecisionTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="转出医院出门时间">
                                    <span>{{patient.Admission.ZcyyLeaveTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="到达本院大门时间">
                                    <span>{{patient.Admission.ArrivedHospitalTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="院内接诊时间">
                                    <span>{{patient.Admission.AdmissionTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="医护人员">
                                    <span>{{patient.Admission.AdmissionDoctor}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--自行来院-->
                    <div v-if="patient.Admission.ComingType=='自行来院'">
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="到达本院大门时间">
                                    <span>{{patient.Admission.ArrivedHospitalTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="首次医疗接触时间">
                                    <span>{{patient.Admission.FmcTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="首诊医师接诊时间">
                                    <span>{{patient.Admission.AdmissionTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="医护人员">
                                    <span>{{patient.Admission.AdmissionDoctor}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--院内发病-->
                    <div v-if="patient.Admission.ComingType=='院内发病'">
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="发病科室">
                                    <span>{{patient.Admission.AttackDept}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="首次医疗接触时间">
                                    <span>{{patient.Admission.FmcTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="床位医生接触时间">
                                    <span>{{patient.Admission.AdmissionTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="离开科室时间">
                                    <span>{{patient.Admission.LeaveDeptTime}} </span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="医护人员">
                                    <span>{{patient.Admission.AdmissionDoctor}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--基础生命体征-->
                    <div>
                        <el-tag size="mini" class="subtitle">基础生命体征</el-tag>
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="意识">
                                    <span>{{patient.Admission.ConsciousnessType}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="呼吸">
                                    <span>{{patient.Admission.RespirationRate}} 次/分钟</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="脉搏">
                                    <span>{{patient.Admission.PulseRate}} 次/分钟</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="心率">
                                    <span>{{patient.Admission.HeartRate}} 次/分钟</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="血压">
                                    <span>{{patient.Admission.BloodPressure}} mmHg</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="体温">
                                    <span>{{patient.Admission.Temperature}} ℃</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--院前溶栓-->
                    <div v-if="patient.Admission.ComingType=='呼救（120或其他）出车'||patient.Admission.ComingType=='转院（包含任何医疗机构）'">
                        <el-tag size="mini" class="subtitle">院前溶栓治疗</el-tag>
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="溶栓筛查">
                                    <span>{{patient.Admission.RsScreen}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8" v-if="patient.Admission.RsScreen=='合适'">
                                <el-form-item label="溶栓治疗">
                                    <span>{{patient.Admission.IsRs}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8" v-if="patient.Admission.RsScreen=='不合适'">
                                <el-form-item label="存在禁忌症" prop="Admission.IsRsTaboo">
                                    <span>{{patient.Admission.IsRsTaboo=='1'?'是':'否'}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8" v-if="patient.Admission.RsScreen=='合适' && patient.Admission.IsRs=='有'">
                                <el-form-item label="直达溶栓场所">
                                    <span>{{patient.Admission.IsRsDirect}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                        <el-row v-bind:gutter="24" v-if="patient.Admission.RsScreen=='合适' && patient.Admission.IsRs=='有'">
                            <el-col v-bind:span="8">
                                <el-form-item label="溶栓场所">
                                    <span>{{patient.Admission.RsPlace}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="开始知情同意">
                                    <span>{{patient.Admission.RsStartAgreeTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="签署知情同意书">
                                    <span>{{patient.Admission.RsSignAgreeTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="开始溶栓时间">
                                    <span>{{patient.Admission.RsStartTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="溶栓结束时间">
                                    <span>{{patient.Admission.RsEndTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="药物">
                                    <span>{{patient.Admission.RsDrugType}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="剂量">
                                    <span>{{patient.Admission.RsDrugCode}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="溶栓再通">
                                    <span>{{patient.Admission.IsRsRecanalization}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8" v-if="patient.Admission.IsRsRecanalization=='是'">
                                <el-form-item label="溶栓后造影时间">
                                    <span>{{patient.Admission.RsRadiographyTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8" v-if="patient.Admission.IsRsRecanalization=='否'">
                                <el-form-item label="补救PCI">
                                    <span>{{patient.Admission.IsRemedyPci}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="实际手术时间" size="mini" v-if="patient.Admission.IsRsRecanalization=='否' && patient.Admission.IsRemedyPci=='是'">
                                    <span>{{patient.Admission.ActualPciTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="手术场所" size="mini" v-if="patient.Admission.IsRsRecanalization=='否' && patient.Admission.IsRemedyPci=='是'">
                                    <span>{{patient.Admission.PciPlace}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <el-row v-bind:gutter="24">
                        <el-col v-bind:span="24">
                            <el-form-item label="患者情况备注">
                                <span>{{patient.Admission.PatientRemarks}}</span>
                            </el-form-item>
                        </el-col>
                    </el-row>
                    <!-- 胸痛诊疗 -->
                    <el-tag style="width:100%;">胸痛诊疗</el-tag>
                    <!--心电图-->
                    <div>
                        <el-tag size="mini" class="subtitle">心电图</el-tag>
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="心电图">
                                    <span>{{patient.Diagnosis.IsEcg}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8" v-if="patient.Diagnosis.IsEcg=='否'">
                                <el-form-item label="未获得原因">
                                    <span>{{patient.Diagnosis.NoEcgReason}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                        <el-row v-bind:gutter="24" v-for="(ecg,index) in patient.EcgList" v-bind:key="index" v-if="patient.Diagnosis.IsEcg=='是'">
                            <el-col v-bind:span="8">
                                <el-form-item v-bind:label="index==0?'首份心电图时间':'心电图时间'">
                                    <span>{{ecg.CheckTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="心电图文件">
                                    <span>{{ecg.FileName}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="心电图确诊时间">
                                    <span>{{ecg.DiagnosisTime}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--远程心电图传输-->
                    <div>
                        <el-tag size="mini" class="subtitle">远程心电图传输</el-tag>
                        <el-row v-bind:gutter="24">
                            <el-col v-bind:span="8">
                                <el-form-item label="接收120/网络医院心电图">
                                    <span>{{patient.Diagnosis.EcgTransmission}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8" v-if="patient.Diagnosis.EcgTransmission=='是'">
                                <el-form-item label="接收时间">
                                    <span>{{patient.Diagnosis.EcgTransmissionTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8" v-if="patient.Diagnosis.EcgTransmission=='是'">
                                <el-form-item label="传输方式">
                                    <span>{{patient.Diagnosis.EcgTransmissionType}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                    </div>
                    <!--实验室检查-->
                    <div>
                        <el-tag size="mini" class="subtitle">实验室检查</el-tag>
