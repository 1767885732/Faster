                            <el-row v-bind:gutter="24">
                                <el-col v-bind:span="8">
                                    <el-form-item label="高密度脂蛋白(HDL-C)">
                                        <span>{{patient.Discharge.IsHdlC}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8" v-if="patient.Discharge.IsHdlC == '是'">
                                    <el-form-item label="数值">
                                        <span>{{patient.DischargeTest.HdlC.Result}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="低密度脂蛋白(LDL-C)">
                                        <span>{{patient.Discharge.IsLdlC}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8" v-if="patient.Discharge.IsLdlC == '是'">
                                    <el-form-item label="数值">
                                        <span>{{patient.DischargeTest.LdlC.Result}}</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>
                            <el-row v-bind:gutter="24">
                                <el-col v-bind:span="8">
                                    <el-form-item label="超声心动图">
                                        <span>{{patient.Discharge.IsUcc}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8" v-if="patient.Discharge.IsUcc == '是'">
                                    <el-form-item label="LVEF">
                                        <span>{{patient.Discharge.Lvef}} %(诊疗过程中最低值)</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8" v-if="patient.Discharge.IsUcc == '是'">
                                    <el-form-item label="室壁瘤">
                                        <span>{{patient.Discharge.IsVentricularAneurysm}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8" v-if="patient.Discharge.IsUcc == '1'">
                                    <el-form-item label="局部室壁活动异常">
                                        <span>{{patient.Discharge.IsRwma}}</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>
                        </div>

                        <!--出院信息-->
