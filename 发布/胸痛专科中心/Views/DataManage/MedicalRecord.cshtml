                            <el-col v-bind:span="8" v-if="patient.Discharge.EcgTransmission=='是'">
                                <el-form-item label="传输方式">
                                    <span>{{patient.Discharge.EcgTransmissionType}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                        <!-- 转科 -->
                        <el-row v-bind:gutter="gutter" v-if="IsTransferDept()">
                            <el-col v-bind:span="8">
                                <el-form-item label="转科时间">
                                    <span>{{patient.Discharge.DeptTransferTime}}</span>
                                </el-form-item>
