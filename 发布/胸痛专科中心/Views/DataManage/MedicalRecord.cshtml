                            <el-col v-bind:span="8">
                                <el-form-item label="转科原因描述">
                                    <span>{{patient.Discharge.DeptTransferReason}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                        <!-- 离院宣教 -->
                        <el-row v-bind:gutter="gutter" v-if="IsEducation()">
                            <el-col v-bind:span="24">
                                <el-form-item label="离院宣教">
                                    {{patient.Discharge.Education}}
                                </el-form-item>
                            </el-col>
                        </el-row>
                        <!-- 死亡 -->
                        <el-row v-bind:gutter="gutter" v-if="IsDeath()">
