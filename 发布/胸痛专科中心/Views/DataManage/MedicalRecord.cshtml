                                    <el-form-item label="药物名称">
                                        <span>{{statins.Code}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="频次">
                                        <span>{{statins.RateCount}}{{statins.RateTime}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="剂量">
                                        <span>{{statins.Dose}} mg</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>

                            <el-row v-bind:gutter="24" v-if="IsCpc() && IsLeave()">
                                <el-col v-bind:span="8">
                                    <el-form-item label="β受体阻滞剂">
                                        <span>{{patient.Discharge.IsBetaBlocker}}</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>
                            <el-row v-bind:gutter="24" v-for="(retardant,index) in patient.DischargeDrugs.Retardant" v-bind:key="'RetardantItem-' + index" v-if="IsCpc() && IsLeave() && patient.Discharge.IsBetaBlocker == '是'">
                                <el-col v-bind:span="8">
                                    <el-form-item label="药物名称">
                                        <span>{{retardant.Code}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="频次">
                                        <span>{{retardant.RateCount}}{{retardant.RateTime}}</span>
                                    </el-form-item>
                                </el-col>
                                <el-col v-bind:span="8">
                                    <el-form-item label="剂量">
                                        <span>{{retardant.Dose}} mg</span>
                                    </el-form-item>
                                </el-col>
                            </el-row>
                        </div>
                        <!-- 转院 -->
                        <el-row v-bind:gutter="gutter" v-if="IsTransferHospital()">
                            <el-col v-bind:span="8">
                                <el-form-item label="离开本院大门时间">
                                    <span>{{patient.Discharge.LeaveTime}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="医院名称">
                                    <span>{{patient.Discharge.HospitalName}}</span>
                                </el-form-item>
                            </el-col>
                            <el-col v-bind:span="8">
                                <el-form-item label="是否是网络医院">
                                    <span>{{patient.Discharge.IsNetHospital}}</span>
                                </el-form-item>
                            </el-col>
                        </el-row>
                        <el-row v-bind:gutter="gutter" v-if="IsTransferHospital()">
