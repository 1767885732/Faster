
<div id="Diagnosis">
    <el-form v-bind:model="patient" v-bind:rules="rules" label-width="100px" size="small" label-position="top">
        <el-tag style="width:100%;">心电图</el-tag>
        <el-row v-bind:gutter="20">
            <el-col v-bind:span="6">
                <el-form-item label="心电图" prop="Diagnosis.IsEcg" class="input_required">
                    <el-radio-group v-model="patient.Diagnosis.IsEcg" size="mini">
                        <el-radio-button v-for="(item,index) in HaveOrNotDict" v-bind:label="item.Key" v-bind:key="'StemiIsThrom-'+ index">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>

                </el-form-item>
            </el-col>
            <el-col v-bind:span="6" v-if="patient.Diagnosis.IsEcg == '0'">
                <el-form-item label="未获得原因" prop="Diagnosis.NoEcgReason" class="input_required">
                    <el-input v-model="patient.Diagnosis.NoEcgReason" autocomplete="off" size="mini" maxlength="50"></el-input>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="6" v-if="patient.Diagnosis.IsEcg == '1' && patient.Regist.Id">
                <el-form-item label=" ">
                    <el-button size="mini" type="primary" v-on:click="showSelectEcgView">选取心电图</el-button>
                </el-form-item>
            </el-col>
        </el-row>
        <el-row v-bind:gutter="20" v-for="(ecg,index) in patient.EcgList" v-bind:key="'ecg-'+ index" v-if="patient.Diagnosis.IsEcg == '1'">
            <el-col v-bind:span="6">
                <el-form-item v-bind:label="index==0?'首份心电图时间':'心电图时间'" prop="CheckTime" class="input_required">
                    <el-button type="primary" icon="el-icon-plus" v-if="index==0" v-on:click="addEcg" size="mini"></el-button>
                    <el-button type="primary" icon="el-icon-delete" v-if="patient.EcgList.length>1" v-on:click="removeEcg(index)" size="mini"></el-button>
                    <el-date-picker v-model="ecg.CheckTime" style="width:70%"
                                    type="datetime" v-on:blur="onDateSelected"
                                    format="yyyy-MM-dd HH:mm"
                                    placeholder="选择日期"
                                    size="mini">
                    </el-date-picker>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="6">
                <el-form-item label="心电图文件" prop="File" class="input_required">
                    <el-upload class="ecg-uploader"
                               ref="upload"
                               action=""
                               v-bind:limit="1"
                               v-bind:on-preview="function(file, fileList){handlePreview(file, fileList,index)}"
                               v-bind:on-remove="function(file, fileList){handleRemove(file, fileList,index)}"
                               v-bind:before-remove="beforeRemove"
                               v-bind:file-list="ecg.FileName==null?[]:[ecg]"
                               v-bind:auto-upload="false"
                               v-bind:on-change="function(file, fileList){handleChange(file, fileList,index)}">
                        <el-button slot="trigger" size="mini" type="primary">选取文件</el-button>
                    </el-upload>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="6">
                <el-form-item label="心电图诊断时间" prop="DiagnosisTime" class="input_required">
                    <el-date-picker v-model="ecg.DiagnosisTime"
                                    type="datetime" v-on:blur="onDateSelected"
                                    format="yyyy-MM-dd HH:mm"
                                    placeholder="选择日期"
                                    size="mini">
                    </el-date-picker>
                </el-form-item>
            </el-col>
        </el-row>
        <!--远程心电图传输-->
        <el-tag style="width:100%;">远程心电图传输</el-tag>
        <el-row v-bind:gutter="20">
            <el-col v-bind:span="6">
                <el-form-item label="接收120/网络医院心电图" prop="Diagnosis.EcgTransmission" class="input_required">
                    <el-radio-group v-model="patient.Diagnosis.EcgTransmission" size="mini">
                        <el-radio-button v-for="(item,index) in YesOrNoDict"
                                         v-bind:label="item.Key"
                                         v-bind:key="index">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="6" v-if="patient.Diagnosis.EcgTransmission == '1'">
                <el-form-item label="接收时间" prop="Diagnosis.EcgTransmissionTime" class="input_required">
                    <el-date-picker v-model="patient.Diagnosis.EcgTransmissionTime"
                                    type="datetime" v-on:blur="onDateSelected"
                                    format="yyyy-MM-dd HH:mm"
                                    placeholder="选择日期"
                                    size="mini">
                    </el-date-picker>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="6" v-if="patient.Diagnosis.EcgTransmission == '1'">
                <el-form-item label="传输方式" prop="Diagnosis.EcgTransmissionType" class="input_required">
                    <el-select v-model="patient.Diagnosis.EcgTransmissionType" placeholder="请选择" size="mini">
                        <el-option v-for="(item,index) in RemoteEcgtranWayDict"
                                   v-bind:label="item.Value"
                                   v-bind:value="item.Key"
                                   v-bind:key="index">
                        </el-option>
                    </el-select>
                </el-form-item>
            </el-col>
        </el-row>
        <!--实验室检查-->
        <div id="DiagnosisTest">
            <el-tag style="width:100%;">实验室检查</el-tag>
            <el-row v-bind:gutter="24">
                <el-col v-bind:span="6">
                    <el-form-item label="肌钙蛋白" prop="Diagnosis.IsTroponin" class="input_required">
                        <el-radio-group v-model="patient.Diagnosis.IsTroponin" size="mini">
                            <el-radio-button v-for="(item,index) in YesOrNoDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="index">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="24" v-for="(troponin,index) in patient.DiagnosisTest.TroponinList" v-bind:key="'troponin-'+ index" v-if="patient.Diagnosis.IsTroponin == '1'">
                <el-col v-bind:span="6">
                    <el-form-item v-bind:label="index==0?'首份肌钙蛋白':'肌钙蛋白'" prop="Category" class="input_required">
                        <el-button type="primary" icon="el-icon-plus" v-if="index==0" v-on:click="addTroponin" size="mini"></el-button>
                        <el-button type="primary" icon="el-icon-delete" v-if="index>0" v-on:click="removeTroponin(index)" size="mini"></el-button>
                        <el-radio-group v-model="troponin.Category" size="mini">
                            <el-radio-button v-for="(item,index) in TroponinDict"
                                             v-bind:label="item.Value"
                                             v-bind:key="index">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6">
                    <el-form-item label="数值" prop="Result" class="input_required">
                        <el-input v-model="troponin.Result" size="mini" style="width:30%" maxlength="20" v-labtest>
                        </el-input>
                        <el-select v-model="troponin.Unit" placeholder="请选择" size="mini" style="width:33%">
                            <el-option v-for="(item,index) in CtnUnitDict"
                                       v-bind:label="item.Value"
                                       v-bind:value="item.Value"
                                       v-bind:key="'troponin-'+ index">
                            </el-option>
                        </el-select>
                        <el-select v-model="troponin.Conclusion" placeholder="请选择" size="mini" style="width:33%">
                            <el-option v-for="(item,index) in PositiveOrNotDict"
                                       v-bind:label="item.Value"
                                       v-bind:value="item.Value"
                                       v-bind:key="'Conclusion-'+ index">
                            </el-option>
                        </el-select>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6">
                    <el-form-item label="抽血完成时间" prop="SamplingTime" class="input_required">
                        <el-date-picker v-model="troponin.SamplingTime"
                                        type="datetime" v-on:blur="onDateSelected"
                                        format="yyyy-MM-dd HH:mm"
                                        placeholder="选择日期">
                        </el-date-picker>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6">
                    <el-form-item label="获得报告时间" prop="ReportTime" class="input_required">
                        <el-date-picker v-model="troponin.ReportTime"
                                        type="datetime" v-on:blur="onDateSelected"
                                        format="yyyy-MM-dd HH:mm"
                                        placeholder="选择日期">
                        </el-date-picker>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="24">
                <el-col v-bind:span="6">
                    <el-form-item label="血清肌酐" prop="Diagnosis.IsScr" class="input_required">
                        <el-radio-group v-model="patient.Diagnosis.IsScr" size="mini">
                            <el-radio-button v-for="(item,index) in YesOrNoDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="index">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6" v-if="patient.Diagnosis.IsScr=='1'">
                    <el-form-item label="数值" prop="DiagnosisTest.Scr.Result" class="input_required">
                        <el-input v-model="patient.DiagnosisTest.Scr.Result" size="mini"
                                  style="width:30%" maxlength="20" v-labtest>
                        </el-input>
                        <el-input v-model="patient.DiagnosisTest.Scr.Unit" style="width:33%"
                                  v-bind:disabled="true" maxlength="20" size="mini">
                        </el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="24">
                <el-col v-bind:span="6">
                    <el-form-item label="D-二聚体" prop="Diagnosis.IsDdimer" class="input_required">
                        <el-radio-group v-model="patient.Diagnosis.IsDdimer" size="mini">
                            <el-radio-button v-for="(item,index) in YesOrNoDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="index">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6" v-if="patient.Diagnosis.IsDdimer=='1'">
                    <el-form-item label="数值" prop="Result" class="input_required">
                        <el-input v-model="patient.DiagnosisTest.Ddimer.Result" size="mini"
                                  style="width:30%" maxlength="20" v-labtest>
                        </el-input>
                        <el-select v-model="patient.DiagnosisTest.Ddimer.Unit" placeholder="请选择" size="mini" style="width:33%">
                            <el-option v-for="(item,index) in DdimerUnitDict"
                                       v-bind:label="item.Value"
                                       v-bind:value="item.Value"
                                       v-bind:key="index">
                            </el-option>
                        </el-select>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="24">
                <el-col v-bind:span="6">
                    <el-form-item label="BNP" prop="Diagnosis.IsBnp" class="input_required">
                        <el-radio-group v-model="patient.Diagnosis.IsBnp" size="mini">
                            <el-radio-button v-for="(item,index) in YesOrNoDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="index">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6" v-if="patient.Diagnosis.IsBnp=='1'">
                    <el-form-item label="数值" prop="Result" class="input_required">
                        <el-input v-model="patient.DiagnosisTest.Bnp.Result" size="mini"
                                  style="width:30%" maxlength="20" v-labtest>
                        </el-input>
                        <el-input v-model="patient.DiagnosisTest.Bnp.Unit" style="width:33%"
                                  v-bind:disabled="true" maxlength="20" size="mini">
                        </el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="24">
                <el-col v-bind:span="6">
                    <el-form-item label="NT-proBNP" prop="Diagnosis.IsNtProbnp" class="input_required">
                        <el-radio-group v-model="patient.Diagnosis.IsNtProbnp" size="mini">
                            <el-radio-button v-for="(item,index) in YesOrNoDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="index">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6" v-if="patient.Diagnosis.IsNtProbnp=='1'">
                    <el-form-item label="数值" prop="Result" class="input_required">
                        <el-input v-model="patient.DiagnosisTest.NtProbnp.Result" size="mini"
                                  style="width:30%" maxlength="20" v-labtest>
                        </el-input>
                        <el-input v-model="patient.DiagnosisTest.NtProbnp.Unit" style="width:33%"
                                  v-bind:disabled="true" maxlength="20" size="mini">
                        </el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="24">
                <el-col v-bind:span="6">
                    <el-form-item label="Myo" prop="Diagnosis.IsMyo" class="input_required">
                        <el-radio-group v-model="patient.Diagnosis.IsMyo" size="mini">
                            <el-radio-button v-for="(item,index) in YesOrNoDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="index">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6" v-if="patient.Diagnosis.IsMyo=='1'">
                    <el-form-item label="数值" prop="Result" class="input_required">
                        <el-input v-model="patient.DiagnosisTest.Myo.Result" size="mini"
                                  style="width:30%" maxlength="20" v-labtest>
                        </el-input>
                        <el-select v-model="patient.DiagnosisTest.Myo.Unit" placeholder="请选择" size="mini" style="width:33%">
                            <el-option v-for="(item,index) in MyoUnitDict"
                                       v-bind:label="item.Value"
                                       v-bind:value="item.Value"
                                       v-bind:key="index">
                            </el-option>
                        </el-select>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="24">
                <el-col v-bind:span="6">
                    <el-form-item label="CKMB" prop="Diagnosis.IsCkmb" class="input_required">
                        <el-radio-group v-model="patient.Diagnosis.IsCkmb" size="mini">
                            <el-radio-button v-for="(item,index) in YesOrNoDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="index">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6" v-if="patient.Diagnosis.IsCkmb=='1'">
                    <el-form-item label="数值" prop="Result" class="input_required">
                        <el-input v-model="patient.DiagnosisTest.Ckmb.Result" size="mini"
                                  style="width:30%" maxlength="20" v-labtest>
                        </el-input>
                        <el-select v-model="patient.DiagnosisTest.Ckmb.Unit" placeholder="请选择" size="mini" style="width:33%">
                            <el-option v-for="(item,index) in CkmbUnitDict"
                                       v-bind:label="item.Value"
                                       v-bind:value="item.Value"
                                       v-bind:key="index">
                            </el-option>
                        </el-select>
                    </el-form-item>
                </el-col>
            </el-row>
        </div>
        <!--心内科会诊-->
        <el-tag style="width:100%;">心内科会诊</el-tag>
        <el-row v-bind:gutter="20">
            <el-col v-bind:span="6">
                <el-form-item label="心内科会诊" prop="Diagnosis.IsConsultation" class="input_required">
                    <el-radio-group v-model="patient.Diagnosis.IsConsultation" size="mini">
                        <el-radio-button v-for="(item,index) in YesOrNoDict"
                                         v-bind:label="item.Key"
                                         v-bind:key="index">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="6" v-if="patient.Diagnosis.IsConsultation=='1'">
                <el-form-item label="会诊类型" prop="Diagnosis.ConsultationType" class="input_required">
                    <el-radio-group v-model="patient.Diagnosis.ConsultationType" size="mini">
                        <el-radio-button v-for="(item,index) in ConsultationTypeDict"
                                         v-bind:label="item.Key"
                                         v-bind:key="index">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="6" v-if="patient.Diagnosis.IsConsultation=='1'">
                <el-form-item label="通知会诊时间" prop="Diagnosis.ConsultationNotifyTime" class="input_required">
                    <el-date-picker v-model="patient.Diagnosis.ConsultationNotifyTime"
                                    type="datetime" v-on:blur="onDateSelected"
                                    format="yyyy-MM-dd HH:mm"
                                    placeholder="选择日期"
                                    size="mini">
                    </el-date-picker>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="6" v-if="patient.Diagnosis.IsConsultation=='1'">
                <el-form-item label="会诊时间" prop="Diagnosis.ConsultationTime" class="input_required">
                    <el-date-picker v-model="patient.Diagnosis.ConsultationTime"
                                    type="datetime" v-on:blur="onDateSelected"
                                    format="yyyy-MM-dd HH:mm"
                                    placeholder="选择日期"
                                    size="mini">
                    </el-date-picker>
                </el-form-item>
            </el-col>
        </el-row>
        <!--诊断-->
        <el-tag style="width:100%;">诊断</el-tag>
        <el-row v-bind:gutter="20">
            <el-col v-bind:span="24">
                <el-form-item label="初步诊断" prop="Diagnosis.DiagnosisCode" class="input_required">
                    <el-radio-group v-model="patient.Diagnosis.DiagnosisCode">
                        <el-radio-button v-for="(item,index) in DiagnosisDict" v-bind:label="item.Key" v-bind:key="'DiagnosisCode-'+ index">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
        </el-row>
        <!--初步诊断时间&医生-->
        <div>
            <el-row v-bind:gutter="20">
                <el-col v-bind:span="6">
                    <el-form-item label="初步诊断时间" prop="Diagnosis.DiagnosisTime">
                        <el-date-picker v-model="patient.Diagnosis.DiagnosisTime"
                                        type="datetime" v-on:blur="onDateSelected"
                                        format="yyyy-MM-dd HH:mm"
                                        placeholder="选择日期">
                        </el-date-picker>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6">
                    <el-form-item label="医生" prop="Diagnosis.DiagnosisDoctor">
                        <el-input v-model="patient.Diagnosis.DiagnosisDoctor" autocomplete="off" size="mini" placeholder="请输入医生" maxlength="50"></el-input>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="6">
                    <el-form-item label="病历原件" prop="File">
                        <el-upload class="upload-demo"
                                   ref="upload"
                                   action=""
                                   v-bind:on-preview="filePreview"
                                   v-bind:on-remove="fileRemove"
                                   @*v-bind:before-remove="beforeRemove"*@
                                   v-bind:file-list="fileList"
                                   v-bind:auto-upload="false"
                                   @*v-bind:before-upload="beforeUpload"*@
                                   v-bind:on-change="fileChange">
                            <el-button slot="trigger" size="mini" type="primary">选取文件</el-button>
                        </el-upload>
                    </el-form-item>
                </el-col>
            </el-row>
        </div>
        <!--患者自愿放弃后续治疗-->
        <el-row v-bind:gutter="20">
            <el-col v-bind:span="6">
                <el-form-item label="患者自愿放弃后续治疗" prop="Diagnosis.IsGiveupTreatment" class="input_required">
                    <el-radio-group v-model="patient.Diagnosis.IsGiveupTreatment">
                        <el-radio-button v-for="(item,index) in YesOrNoDict" v-bind:label="item.Key" v-bind:key="'IsGiveupTreatment-'+ index">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
        </el-row>
        <div>
            <!--NACS 非ACS心源性胸痛类型-->
            <div v-if="showNacsType">
                <el-row v-bind:gutter="20">
                    <el-col v-bind:span="24">
                        <el-form-item label="非ACS心源性胸痛类型" prop="Diagnosis.NacsType" class="input_required">
                            <el-checkbox-group v-model="patient.Diagnosis.NacsType" style="width:calc(100vw - 300px)">
                                <el-checkbox v-for="(item,index) in NacsTypeDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="'NacsType-'+ index">{{item.Value}}</el-checkbox>
                            </el-checkbox-group>
                        </el-form-item>
                    </el-col>
                </el-row>
            </div>
            <!--NC 其它非心源性胸痛-->
            <div v-if="showNccpType">
                <el-row v-bind:gutter="20">
                    <el-col v-bind:span="24">
                        <el-form-item label="其它非心源性胸痛" prop="Diagnosis.NccpType" class="input_required">
                            <el-checkbox-group v-model="patient.Diagnosis.NccpType" style="width:calc(100vw - 300px)">
                                <el-checkbox v-for="(item,index) in NccpTypeDict"
                                             v-bind:label="item.Key"
                                             v-bind:key="'NacsType-'+ index">{{item.Value}}</el-checkbox>
                            </el-checkbox-group>
                        </el-form-item>
                    </el-col>
                </el-row>
            </div>
            <!--NACS NC OTHER 处理措施-->
            <div v-if="showHandleWay">
                <el-row v-bind:gutter="24">
                    <el-col v-bind:span="6">
                        <el-form-item label="处理措施" prop="Diagnosis.HandleWay" class="input_required">
                            <el-radio-group v-model="patient.Diagnosis.HandleWay">
                                <el-radio-button v-for="(item,index) in HandleWayDict" v-bind:label="item.Key" v-bind:key="'HandleWay-'+ index">
                                    {{item.Value}}
                                </el-radio-button>
                            </el-radio-group>
                        </el-form-item>
                    </el-col>
                </el-row>
                <el-row v-bind:gutter="24">
                    <el-col v-bind:span="18">
                        <el-form-item label="患者情况备注" prop="Diagnosis.PatientRemarks">
                            <el-input v-model="patient.Diagnosis.PatientRemarks" autocomplete="off" size="mini" maxlength="100"></el-input>
                        </el-form-item>
