                    <el-col v-bind:span="6" v-if="patient.Treatment.EcgTransmission == '1'">
                        <el-form-item label="传输方式" prop="Treatment.EcgTransmissionType">
                            <el-select v-model="patient.Treatment.EcgTransmissionType" placeholder="请选择" size="mini">
                                <el-option v-for="(item,index) in RemoteEcgtranWayDict"
                                           v-bind:label="item.Value"
                                           v-bind:value="item.Key"
                                           v-bind:key="index">
                                </el-option>
                            </el-select>
                        </el-form-item>
                    </el-col>
                </el-row>
            </div>
            <!--导管室-->
            <div v-if="showDGS">
                @Html.Partial("TreatmentPci")
            </div>
        </div>
    </el-form>
    <el-dialog title="选择心电图" :visible.sync="IsShowSelectEcgView" fullscreen>
        <el-row>
            <div style="width:100%;padding:5px 0;display:flex;">
                <div style="flex-grow:2;margin-left:10px;">
                    <el-date-picker v-model="ecgSearchModel.DateRange"
                                    type="daterange"
                                    range-separator="至"
                                    start-placeholder="开始时间"
                                    end-placeholder="结束时间"
                                    size="mini" style="width:50%">
                    </el-date-picker>
                </div>
                <div style="width:120px;flex-grow:0;margin-left:30px;">
                    <el-button size="mini" icon="el-icon-search" circle v-on:click="searchEcgList"></el-button>
                    <el-button size="mini" type="success" icon="el-icon-check" circle v-on:click="doBindEcg" v-if="ecgList && ecgList.length > 0">确认</el-button>
                </div>
            </div>
        </el-row>
        <div v-if="hasData" align="center" style="width:90%;margin:20px auto;">
            <el-carousel height="60vh" indicator-position="outside" trigger="click" v-bind:autoplay="false" v-bind:initial-index="index" v-on:change="currentEcgChanged">
                <el-carousel-item v-for="(ecg,index) in ecgList" v-bind:key="index" v-bind:label="ecg.Name">
                    <div style="height: 100%;overflow: auto;">
                        <el-image v-bind:src="ecg.Url" fit="contain" v-bind:alt="ecg.Name" style="height:100%">
                            <div slot="error" class="image-slot">
                                <i class="el-icon-picture-outline"></i>
                            </div>
                            <div slot="placeholder" class="image-slot">
                                加载中<span class="dot">...</span>
                            </div>
                        </el-image>
                    </div>
                </el-carousel-item>
            </el-carousel>
        </div>
        <div v-if="!hasData" style="overflow:hidden;">
            <el-image src="~/App_Themes/Default/img/ecg.jpg" />
        </div>
    </el-dialog>
</div>