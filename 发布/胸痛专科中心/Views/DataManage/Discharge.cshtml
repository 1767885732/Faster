            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="慢性肾病" prop="Discharge.IsCkd" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsCkd" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Ckd-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="贫血" prop="Discharge.IsAnemia" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsAnemia" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Anemia-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="消化性溃疡" prop="Discharge.IsPepticUlcer" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsPepticUlcer" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'PepticUlcer-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
