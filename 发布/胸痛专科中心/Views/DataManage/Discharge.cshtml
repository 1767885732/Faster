                <el-col v-bind:span="space_quarter">
                    <el-form-item label="甲状腺功能异常" prop="Discharge.IsThyroidDysfunction" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsThyroidDysfunction" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'ThyroidDysfunction-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="gutter">
