<div id="Discharge">
    <el-form v-bind:model="patient" v-bind:rules="rules" label-width="100px" size="small" label-position="top">
        <el-row v-bind:gutter="gutter">
            <el-col v-bind:span="space_three_quater">
                <el-form-item label="出院诊断" prop="Discharge.Diagnosis" class="input_required">
                    <el-radio-group v-model="patient.Discharge.Diagnosis" size="mini">
                        <el-radio-button v-for="item in DischargeDiagnosisDict"
                                         v-bind:label="item.Key" v-bind:key="'Diagnosis-'+item.Key">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
        </el-row>
        <el-row>
            <el-col v-bind:span="space_quarter">
                <el-form-item label="确诊时间" prop="Discharge.DiagnosisTime" class="input_required">
                    <el-date-picker v-model="patient.Discharge.DiagnosisTime"
                                    type="datetime" v-on:blur="onDateSelected"
                                    format="yyyy-MM-dd HH:mm"
                                    placeholder="请选择确诊时间"
                                    size="mini">
                    </el-date-picker>
                </el-form-item>
            </el-col>
        </el-row>
        <el-row>
            <el-col v-bind:span="space_three_quater">
                <el-form-item label="COVID-19" prop="Discharge.COVID19" class="input_required">
                    <el-radio-group v-model="patient.Discharge.COVID19" size="mini">
                        <el-radio-button v-for="item in COVID19Dict"
                                         v-bind:label="item.Key" v-bind:key="'COVID19-'+item.Key">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
        </el-row>
        <!-- 非心源性胸痛 -->
        <el-row v-bind:gutter="gutter" v-if="IsNacs()">
            <el-col v-bind:span="space_full">
                <el-form-item label="非ACS心源性胸痛类型" prop="Discharge.NacsType" class="input_required">
                    <el-checkbox-group v-model="patient.Discharge.NacsType" size="mini">
                        <el-checkbox v-for="item in NacsTypeDict"
                                     v-bind:label="item.Key" v-bind:key="'NacsType-'+item.Key">
                            {{item.Value}}
                        </el-checkbox>
                    </el-checkbox-group>
                </el-form-item>
            </el-col>
        </el-row>
        <el-row v-bind:gutter="gutter" v-if="IsNccp()">
            <el-col v-bind:span="space_full">
                <el-form-item label="其它非心源性胸痛类型" prop="Discharge.NccpType" class="input_required">
                    <el-checkbox-group v-model="patient.Discharge.NccpType" size="mini">
                        <el-checkbox v-for="item in NccpTypeDict"
                                     v-bind:label="item.Key" v-bind:key="'NccpType-'+item.Key">
                            {{item.Value}}
                        </el-checkbox>
                    </el-checkbox-group>
                </el-form-item>
            </el-col>
        </el-row>
        <div v-if="IsCpc()">
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="院内新发心力衰竭" prop="Discharge.IsHeartFailure" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsHeartFailure" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'IsHeartFailure-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter" v-show="patient.Discharge.IsHeartFailure == '1'">
                    <el-form-item label="NYHA分级" prop="Discharge.ChfNyha" class="input_required">
                        <el-radio-group v-model="patient.Discharge.ChfNyha" size="mini">
                            <el-radio-button v-for="item in ChfNyhaDict"
                                             v-bind:label="item.Key" v-bind:key="'ChfNyha-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="ARNI" prop="Discharge.IsARNI" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsARNI" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'IsHeartFailure-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter" v-show="patient.Discharge.IsARNI == '1'">
                    <el-form-item label="服用频次" prop="Discharge.ARNIFrequency" class="input_required">
                        <el-select v-model="patient.Discharge.ARNIFrequency" placeholder="请选择时间" size="mini" style="width:48%;">
                            <el-option v-for="(item,index) in RateTimeDict"
                                       v-bind:label="item.Value"
                                       v-bind:value="item.Key"
                                       v-bind:key="'RateTime-' + index">
                            </el-option>
                        </el-select>
                        <el-select v-model="patient.Discharge.ARNIFrequencyRange" placeholder="请选择频次" size="mini" style="width:48%;">
                            <el-option v-for="(item,index) in RateCountDict"
                                       v-bind:label="item.Value"
                                       v-bind:value="item.Key"
                                       v-bind:key="'RateCount-' + index">
                            </el-option>
                        </el-select>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter" v-show="patient.Discharge.IsARNI == '1'">
                    <el-form-item label="单次剂量" prop="Discharge.ARNIDose" class="input_required">
                        <el-input v-model="patient.Discharge.ARNIDose" size="mini">
                            <template slot="append">
                                mg
                            </template>
                        </el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_full">
                    <el-form-item label="住院期间并发症" prop="Discharge.Complication" class="input_required">
                        <el-checkbox-group v-model="patient.Discharge.Complication" size="mini" v-on:change="ComplicationChange">
                            <el-checkbox v-for="item in DischargeComplicationDict"
                                         v-bind:label="item.Key" v-bind:key="'DischargeComplication-'+item.Key">
                                {{item.Value}}
                            </el-checkbox>
                        </el-checkbox-group>
                    </el-form-item>
                </el-col>
            </el-row>
        </div>
        <el-tag style="width:100%;">住院期间用药</el-tag>
        <el-row>
            <el-col v-bind:span="space_quarter">
                <el-form-item label="降糖药物" prop="Discharge.IsJTYW" class="input_required">
                    <el-radio-group v-model="patient.Discharge.IsJTYW" size="mini">
                        <el-radio-button v-for="item in YesOrNoDict"
                                         v-bind:label="item.Key" v-bind:key="'IsJTYW-'+item.Key">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="space_quarter" v-if="patient.Discharge.IsJTYW == '1'">
                <el-form-item label="药物名称" prop="Discharge.JTYWName" class="input_required">
                    <el-select v-model="patient.Discharge.JTYWName" placeholder="请选择" size="mini" style="width:33%">
                        <el-option v-for="(item,index) in OHANameDict"
                                   v-bind:label="item.Value"
                                   v-bind:value="item.Key"
                                   v-bind:key="'JTYWName-'+ index">
                        </el-option>
                    </el-select>
                </el-form-item>
            </el-col>
        </el-row>
        <el-row>
            <el-col v-bind:span="space_quarter">
                <el-form-item label="口服抗凝药物" prop="Discharge.IsKNYW" class="input_required">
                    <el-radio-group v-model="patient.Discharge.IsKNYW" size="mini">
                        <el-radio-button v-for="item in YesOrNoDict"
                                         v-bind:label="item.Key" v-bind:key="'IsKNYW-'+item.Key">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="space_quarter" v-if="patient.Discharge.IsKNYW == '1'">
                <el-form-item label="药物名称" prop="Discharge.KNYWName" class="input_required">
                    <el-select v-model="patient.Discharge.KNYWName" placeholder="请选择" size="mini" style="width:33%">
                        <el-option v-for="(item,index) in NOACNameDict"
                                   v-bind:label="item.Value"
                                   v-bind:value="item.Key"
                                   v-bind:key="'JTYWName-'+ index">
                        </el-option>
                    </el-select>
                </el-form-item>
            </el-col>
        </el-row>
        <el-row>
            <el-col v-bind:span="space_quarter">
                <el-form-item label="PCSK9" prop="Discharge.IsPCSK9" class="input_required">
                    <el-radio-group v-model="patient.Discharge.IsPCSK9" size="mini">
                        <el-radio-button v-for="item in YesOrNoDict"
                                         v-bind:label="item.Key" v-bind:key="'IsPCSK9-'+item.Key">
                            {{item.Value}}
                        </el-radio-button>
                    </el-radio-group>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="space_quarter" v-if="patient.Discharge.IsPCSK9 == '1'">
                <el-form-item label="药物名称" prop="Discharge.PCSK9Name" class="input_required">
                    <el-select v-model="patient.Discharge.PCSK9Name" placeholder="请选择" size="mini" style="width:33%">
                        <el-option v-for="(item,index) in PCSK9NameDict"
                                   v-bind:label="item.Value"
                                   v-bind:value="item.Key"
                                   v-bind:key="'JTYWName-'+ index">
                        </el-option>
                    </el-select>
                </el-form-item>
            </el-col>
            <el-col v-bind:span="space_quarter" v-if="patient.Discharge.IsPCSK9 == '1'">
                <el-form-item label="单次剂量" prop="Discharge.PCSK9Dose" class="input_required">
                    <el-input v-model="patient.Discharge.PCSK9Dose" size="mini">
                        <template slot="append">
                            mg
                        </template>
                    </el-input>
                </el-form-item>
            </el-col>
        </el-row>
        <div v-if="IsCpc()">
            <el-tag style="width:100%;">危险因素</el-tag>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="高血压" prop="Discharge.IsHypertension" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsHypertension" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Hypertension-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="高脂血症" prop="Discharge.IsHyperlipidemia" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsHyperlipidemia" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Hyperlipidemia-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="糖尿病" prop="Discharge.IsDiabetes" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsDiabetes" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Diabetes-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="肥胖" prop="Discharge.IsObesity" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsObesity" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Obesity-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="早发CVD家族史(男<55岁，女<60岁)" prop="Discharge.IsCvdHr" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsCvdHr" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'CvdHr-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="吸烟" prop="Discharge.IsSmoking" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsSmoking" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Smoking-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter" v-show="patient.Discharge.IsSmoking == '1'">
                    <el-form-item label="吸烟" prop="Discharge.SmokingSituation" class="input_required">
                        <el-radio-group v-model="patient.Discharge.SmokingSituation" size="mini">
                            <el-radio-button v-for="item in SmokingSituationDict"
                                             v-bind:label="item.Key" v-bind:key="'SmokingSituation-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>

            <el-tag style="width:100%;">合并疾病</el-tag>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="冠心病" prop="Discharge.IsChd" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsChd" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Chd-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter" v-show="patient.Discharge.IsChd == '1'">
                    <el-form-item label="血运重建史" prop="Discharge.IsChdHor" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsChdHor" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'ChdHor-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="心房颤动" prop="Discharge.IsAf" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsAf" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Af-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter" v-show="patient.Discharge.IsAf == '1'">
                    <el-form-item label="分型" prop="Discharge.AfType" class="input_required">
                        <el-radio-group v-model="patient.Discharge.AfType" size="mini">
                            <el-radio-button v-for="item in AfTypeDict"
                                             v-bind:label="item.Key" v-bind:key="'AfType-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="慢性心力衰竭" prop="Discharge.IsChf" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsChf" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Chf-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter" v-show="patient.Discharge.IsChf == '1'">
                    <el-form-item label="NYHA分级" prop="Discharge.ChfNyha" class="input_required">
                        <el-radio-group v-model="patient.Discharge.ChfNyha" size="mini">
                            <el-radio-button v-for="item in ChfNyhaDict"
                                             v-bind:label="item.Key" v-bind:key="'ChfNyha-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="脑血管疾病" prop="Discharge.IsCvd" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsCvd" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Cvd-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter" v-show="patient.Discharge.IsCvd == '1'">
                    <el-form-item label="脑血管疾病类型" prop="Discharge.CvdType" class="input_required">
                        <el-radio-group v-model="patient.Discharge.CvdType" size="mini">
                            <el-radio-button v-for="item in CvdTypeDict"
                                             v-bind:label="item.Key" v-bind:key="'CvdType-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row v-bind:gutter="gutter">
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="心脏瓣膜病" prop="Discharge.IsVhd" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsVhd" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Vhd-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="外周动脉疾病" prop="Discharge.IsPad" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsPad" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Pad-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="主动脉瘤" prop="Discharge.IsAneurysm" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsAneurysm" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Aneurysm-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
                        </el-radio-group>
                    </el-form-item>
                </el-col>
                <el-col v-bind:span="space_quarter">
                    <el-form-item label="COPD" prop="Discharge.IsCopd" class="input_required">
                        <el-radio-group v-model="patient.Discharge.IsCopd" size="mini">
                            <el-radio-button v-for="item in YesOrNoDict"
                                             v-bind:label="item.Key" v-bind:key="'Copd-'+item.Key">
                                {{item.Value}}
                            </el-radio-button>
