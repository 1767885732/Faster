<style>
    [v-cloak] {
        display: none;
    }
    /*提醒空白换行*/
    .el-tooltip__popper {
        white-space: pre !important;
    }

    .el-table .cell p.tip_red {
        color: red;
        font-size: 12px;
    }

    .el-table .cell p.tip_green {
        color: green;
        font-size: 12px;
    }

    .main-sidebar {
        background: url("../../App_Themes/Default/img/side.png") repeat-y;
    }

    .main-s1 {
        padding-right: 5px;
    }

    .main-s2 {
        margin-top: 0px;
    }

    .main-s3 {
        font-weight: bold;
        font-size: 15px
    }

    .item1 li {
        padding: 30px;
        background: url('../../App_Themes/Default/imgt//编组 6.png') no-repeat;
    }
</style>
