    </div>

    <div class="container" style="padding-top:10px; background-color:azure">
        <div class="center" style="background-color:azure">
            <div class="operate-bar">
                @*<el-button type="primary" size="medium" icon="el-icon-plus" v-on:click="addPatient" v-if="showAdd()">新增病历</el-button>*@
                <el-button type="primary" size="medium" icon="fa fa-plus main-s1" v-on:click="addPatient" v-if="showAdd()">新增病历</el-button>
                <el-button type="danger" size="medium" icon="el-icon-delete" v-on:click="deletePatients" v-if="showDelete()">删除</el-button>
                <el-button type="warning" size="medium" icon="el-icon-refresh" v-on:click="refreshTimeline" v-if="showRefreshTimeline()">初始化时间轴及完整度</el-button>
                <el-button type="primary" size="medium" icon="el-icon-back" v-on:click="undoCompletedPatients" v-if="showArchive()">撤回</el-button>
                <el-button type="primary" size="medium" icon="el-icon-finished" v-on:click="archivedPatients" v-if="showArchive()">归档</el-button>
                <el-button type="primary" size="medium" icon="el-icon-finished" v-on:click="archivedPatientsAll" v-if="showArchiveAll()">一键归档</el-button>
                <el-button type="primary" size="medium" icon="el-icon-back" v-on:click="undoArchivedPatients" v-if="showRevokeArchive()">撤销归档</el-button>
                <el-button type="primary" size="medium" icon="el-icon-download" v-on:click="exportData" v-if="showExport()">导出</el-button>
                <el-button type="primary" size="medium" icon="el-icon-upload2" v-on:click="uploadToCPA" v-if="showReport()">上报</el-button>
                <el-button type="success" size="medium" icon="el-icon-check" v-on:click="restorePatients" v-if="showRestore()">恢复</el-button>
                <el-button type="danger" size="medium" icon="el-icon-delete" v-on:click="deletePatientsHard" v-if="showDeleteHard()">彻底删除</el-button>
            </div>
            <div class="tab side-tab">
                <el-tabs v-model="searchParams.Type" v-on:tab-click="tabClick">
                    <el-tab-pane name="0">
                        <div slot="label">全部<span class="counter-primary">{{countData.Item1}}</span></div>
                    </el-tab-pane>
                    <el-tab-pane label="填报中" name="1">
                        <div slot="label">填报中<span class="counter-primary">{{countData.Item2}}</span></div>
                    </el-tab-pane>
                    <el-tab-pane label="填报完成" name="2">
                        <div slot="label">已提交<span class="counter-success">{{countData.Item3}}</span></div>
                    </el-tab-pane>
                    <el-tab-pane label="已归档" name="3">
                        <div slot="label">已归档<span class="counter-success">{{countData.Item4}}</span></div>
                    </el-tab-pane>
                    <el-tab-pane label="已上报" name="4">
                        <div slot="label">已上报<span class="counter-success">{{countData.Item5}}</span></div>
                    </el-tab-pane>
                    <el-tab-pane label="已删除" name="5">
                        <div slot="label">已删除<span class="counter-info">{{countData.Item6}}</span></div>
                    </el-tab-pane>
                </el-tabs>
            </div>
            <div class="table-panel">
                <el-table v-bind:data="tableData"
                          v-bind:stripe="true"
                          @*v-bind:height="tableHeight"*@
                          height="100%"
                          ref="patientTable"
                          v-on:selection-change="handleMultipleSelection"
                          size="mini">
                    <el-table-column v-bind:key="Math.random()" type="selection"
                                     width="30">
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="Name"
                                     label="患者姓名" style="font-size:15px"
                                     min-width="80"
                                     align="center">
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="GenderDesc"
                                     label="性别" style="font-size:15px"
                                     min-width="50"
                                     align="center">
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="Age"
                                     label="年龄"
                                     min-width="50"
                                     align="center">
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="ComingTypeDesc"
                                     label="来院方式"
                                     min-width="130"
                                     align="center">
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="ReceptionTime"
                                     label="接诊时间"
                                     min-width="120"
                                     v-bind:formatter="timeFormat"
                                     align="center">
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="ChiefComplaint"
                                     label="主诉"
                                     min-width="130"
                                     align="center" v-if="searchParams.Type == '0' || searchParams.Type == '1'">
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="DiagnosisDesc"
                                     label="诊断"
                                     min-width="120"
                                     align="center">
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="ReportStatusDesc"
                                     label="上报状态"
                                     min-width="80"
                                     align="center" v-if="searchParams.Type == '4' || searchParams.Type == '2'">
                    </el-table-column>
                    @*<el-table-column v-bind:key="Math.random()" prop="InpatientNo"
                                         label="住院号"
                                         min-width="80"
                                         align="center">
                        </el-table-column>
                        <el-table-column v-bind:key="Math.random()" prop="DischargeTime"
                                         label="出院时间"
                                         min-width="120"
                                         v-bind:formatter="timeFormat"
                                         align="center">
                        </el-table-column>*@
                    <el-table-column v-bind:key="Math.random()" prop="Integrity"
                                     label="信息完整度"
                                     min-width="120"
                                     align="center"
                                     v-if="searchParams.Type == '0' || searchParams.Type == '1'">
                        <template slot-scope="scope">
                            <div style="display:flex;">
                                <i class="fa fa-fw fa-info-circle" style="font-size:20px; align-self:center;" v-on:click="validateResult(scope.row.Id)"></i>
                                <el-progress style="flex-grow:1" v-bind:text-inside="true" v-bind:stroke-width="26" v-bind:percentage="scope.row.Integrity?scope.row.Integrity:0" v-bind:status="calcIntegrity(scope.row.Integrity)"></el-progress>
                                @*<i class="el-icon-info" style="font-size:20px; align-self:center;" v-on:click="validateResult(scope.row.Id)"></i>*@

                            </div>
                        </template>
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="CompleteTime"
                                     label="填报完成时间"
                                     min-width="120"
                                     v-bind:formatter="timeFormat"
                                     align="center"
                                     v-if="searchParams.Type == '2'">
                        <template slot-scope="scope">
                            <span>{{formatTime(scope.row.CompleteTime)}}</span>
                        </template>
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="FilingTime"
                                     label="归档时间"
                                     min-width="120"
                                     v-bind:formatter="timeFormat"
                                     align="center"
                                     v-if="searchParams.Type == '3'">
                        <template slot-scope="scope">
                            <span>{{formatTime(scope.row.FilingTime)}}</span>
                        </template>
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="ReportTime"
                                     label="上报时间"
                                     min-width="120"
                                     v-bind:formatter="timeFormat"
                                     align="center"
                                     v-if="searchParams.Type == '4' || searchParams.Type == '2'">
                        <template slot-scope="scope">
                            <span>{{formatTime(scope.row.ReportTime)}}</span>
                        </template>
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" prop="DeleteTime"
                                     label="删除时间"
                                     min-width="120"
                                     v-bind:formatter="timeFormat"
                                     align="center"
                                     v-if="searchParams.Type == '5'">
                        <template slot-scope="scope">
                            <span>{{formatTime(scope.row.DeleteTime)}}</span>
                        </template>
                    </el-table-column>
                    <el-table-column v-bind:key="Math.random()" fixed="right" label="操作" min-width="250" width="250" align="center">
                        <template slot-scope="scope">
                            <el-button size="mini"
                                       v-on:click="handleEdit(scope.$index, scope.row)"
                                       v-if="showView(scope.row)">查看</el-button>
                            <el-button size="mini"
                                       type="warning"
                                       v-on:click="handleEdit(scope.$index, scope.row)"
                                       v-if="showEdit(scope.row)"><i class="fa fa-edit"></i>编辑</el-button>
                            <el-button size="mini"
                                       type="danger"
                                       v-on:click="handleDelete(scope.$index, scope.row)"
                                       v-if="showDelete(scope.row)"><i class="el-icon-delete"></i>删除</el-button>
                            <el-button size="mini" type="primary" v-if="Viewable" v-on:click="handleTimeline(scope.$index, scope.row)"><i class="fa fa-bitbucket"></i>时间轴</el-button>
                        </template>
                    </el-table-column>
                </el-table>

                <el-pagination v-on:size-change="handleSizeChange"
                               v-on:current-change="handleCurrentChange"
                               v-bind:current-page.sync="searchParams.page"
                               v-bind:page-size="searchParams.rows"
                               layout="prev, pager, next, jumper"
                               v-bind:total="dataTotal">
                </el-pagination>
            </div>
            <el-dialog title="新增病例" v-bind:visible.sync="dialogVisible" width="80%">
                <div class="dlg-add-container">
                    <el-row>
                        <el-radio-group v-model="options.From" v-on:change="sourceFromChange">
                            <el-radio-button label="1">急救</el-radio-button>
                            <el-radio-button label="2">急诊</el-radio-button>
                            <el-radio-button label="3">门诊</el-radio-button>
                            <el-radio-button label="0">住院</el-radio-button>
                        </el-radio-group>
                    </el-row>
                    <el-row>
                        <div style="width:100%;padding:5px 0;display:flex;">
                            <div style="flex-grow:1">
                                <el-select v-model="options.OrgCode"
                                           placeholder="请选择医院"
                                           size="mini" style="width:100%;">
                                    <el-option v-for="item in HospitalDict"
                                               v-bind:key="item.Key"
                                               v-bind:label="item.Value"
                                               v-bind:value="item.Key">
                                    </el-option>
                                </el-select>
                            </div>
                            <div style="flex-grow:2;margin-left:10px;">
                                <el-date-picker v-model="options.DateRange"
                                                type="daterange"
                                                range-separator="至"
                                                start-placeholder="开始日期"
                                                end-placeholder="结束日期"
                                                size="mini" style="width:100%">
                                </el-date-picker>
                            </div>
                            <div style="flex-grow:1;margin-left:10px;">
                                <el-input v-model="options.Name"
                                          placeholder="请输入姓名"
                                          size="mini"></el-input>
                            </div>
                            <div style="flex-grow:1;margin-left:10px;" v-if="options.From != '1'&&options.From != '2'&&false">
                                <el-input v-model="options.No"
                                          v-bind:placeholder="showData.noInput"
                                          size="mini"></el-input>
                            </div>
                            <div style="width:220px;flex-grow:0;margin-left:30px;">
                                <el-button size="mini" icon="fa fa-fw fa-star-o" type="primary" v-on:click="newPatient">空白病例</el-button>
                                @*<el-button size="mini" icon="el-icon-search" circle v-on:click="QueryIF"></el-button>*@
                                <el-button size="mini" type="warning" icon="fa fa-fw fa-search" circle v-on:click="QueryIF"></el-button>
                                <el-button size="mini" type="success" icon="el-icon-check" circle v-on:click="doAdd"></el-button>
                            </div>
                        </div>
                    </el-row>
                    <div style="margin-top:10px">
                        <el-table v-bind:data="gridData" ref="gridTable" height="300" size="mini" border highlight-current-row v-on:current-change="handleSelectionChange">
                            <el-table-column type="index"
                                             width="50"
                                             align="center">
                            </el-table-column>
                            <el-table-column v-if="options.From != '1'" property="DisplayNo" v-bind:label="showData.noCol"></el-table-column>
                            <el-table-column property="Name" label="患者姓名"></el-table-column>
                            <el-table-column property="BirthDate" label="出生日期"></el-table-column>
                            <el-table-column property="Gender" label="性别"></el-table-column>
                            <el-table-column property="Time" v-bind:label="showData.timeCol"></el-table-column>
                            <el-table-column property="Complaint" label="主诉（或诊断）"></el-table-column>
                        </el-table>
                    </div>
                </div>
            </el-dialog>
            <el-dialog title="时间轴" class="dialog_timeline" v-bind:visible.sync="timelineVisible" width="70%" hei>
                <div class="patient">
                    <el-row>
                        <el-col v-bind:span="6">
                            <div>患者姓名</div>
                            <span>{{timelineHeader.Name}}</span>
                        </el-col>
                        <el-col v-bind:span="6">
                            <div>患者性别</div>
                            <span>{{timelineHeader.GenderDesc}}</span>
                        </el-col>
                        <el-col v-bind:span="6">
                            <div>患者年龄</div>
                            <span>{{timelineHeader.Age}}</span>
                        </el-col>
                        <el-col v-bind:span="6">
                            <div>联系方式</div>
                            <span>{{timelineHeader.PhoneNumber}}</span>
                        </el-col>
                    </el-row>
                    <el-row>
                        <el-col v-bind:span="6">
                            <div>诊断</div>
                            <span>{{timelineHeaderExt.DiagnosisDesc}}</span>
                        </el-col>
                        <el-col v-bind:span="6">
                            <div>门诊号</div>
                            <span>{{timelineHeader.OutpatientNo}}</span>
                        </el-col>
