<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <driverSettings>
    <!--<WebApi Id="DoCare"
            BaseUrl="http://10.0.103.218:4666/"
            Timeout="1000"
            ContentSize="2560000"
            ClientId="DoCare.WebApi"
            ClientSecurity="1234567890"
            AccountId="superadmin"
            AccountPassword="670B14728AD9902AECBA32E22FA4F6BD"
            TokenPath="Token" RootPath="api" />-->
  </driverSettings>
  <generalSettings>
    <add Id="Test.Ctnt.Name" Value="cTnt"></add>
    <add Id="Test.Ctni.Name" Value="cTni"></add>
    <add Id="Test.Cr.Name" Value="肌酐"></add>
    <add Id="Test.Ddimer.Name" Value="D-二聚体"></add>
    <add Id="Test.Bnp.Name" Value="BNP"></add>
    <add Id="Test.NtProBnp.Name" Value="氨基末端B型钠尿肽前体"></add>
    <add Id="Test.Myo.Name" Value="肌红蛋白"></add>
    <add Id="Test.Ckmb.Name" Value="肌酸激酶同工酶"></add>
    <!--总胆固醇TC-->
    <add Id="Test.TC.Name" Value="总胆固醇"></add>
    <!--甘油三酯TG-->
    <add Id="Test.TG.Name" Value="甘油三酯"></add>
    <!--高密度脂蛋白HDL-C-->
    <add Id="Test.HDLC.Name" Value="高密度脂蛋白胆固醇"></add>
    <!--低密度脂蛋白LDL-C-->
    <add Id="Test.LDLC.Name" Value="低密度脂蛋白胆固醇"></add>

    <add Id="Poct.Ctnt.Name" Value="cTnt"></add>
    <add Id="Poct.Ctni.Name" Value="肌钙蛋白I"></add>
    <add Id="Poct.Cr.Name" Value="肌酐"></add>
    <add Id="Poct.Ddimer.Name" Value="D-二聚体"></add>
    <add Id="Poct.Bnp.Name" Value="BNP"></add>
    <add Id="Poct.NtProBnp.Name" Value="氨基末端B型钠尿肽前体"></add>
    <add Id="Poct.Myo.Name" Value="肌红蛋白"></add>
    <add Id="Poct.Ckmb.Name" Value="肌酸激酶同工酶"></add>

    <add Id="Inpatient.DisplaySN" Value="0"></add>
    <add Id="Outpatient.DisplaySN" Value="0"></add>
    <add Id="Dio.Debug" Value="false"></add>
  </generalSettings>
  <dictionarySettings>
    <Dictionarys Id="Patient" >
      <Dictionary Code="Gender" Default="2">
        <Item Key="男" Value="1" />
        <Item Key="女" Value="2"/>
      </Dictionary>
      <Dictionary Code="ComingType" Default="2">
        <Item Key="1" Value="1" />
        <Item Key="2" Value="2"/>
        <Item Key="3" Value="4"/>
      </Dictionary>
      <Dictionary Code="Sense" Default="">
        <Item Key="0" Value="清晰" />
        <Item Key="1" Value="嗜睡"/>
        <Item Key="2" Value="模糊" />
        <Item Key="3" Value="浅昏迷" />
        <Item Key="4" Value="深昏迷"/>
        <Item Key="5" Value="错乱" />
        <Item Key="6" Value="无" />
      </Dictionary>
      <Dictionary Code="IllnessState" Default="">
        <Item Key="0" Value="濒危" />
        <Item Key="1" Value="危重"/>
        <Item Key="2" Value="急症" />
        <Item Key="3" Value="非急症" />
        <Item Key="4" Value="死亡"/>
      </Dictionary>
      <Dictionary Code="FetalMovement" Default="">
        <Item Key="1" Value="正常"/>
        <Item Key="2" Value="减少" />
        <Item Key="3" Value="消失" />
        <Item Key="4" Value="急剧增加"/>
      </Dictionary>
      <Dictionary Code="OutWay" Default="">
        <Item Key="1" Value="1"/>
        <Item Key="2" Value="1"/>
        <Item Key="3" Value="1"/>
        <Item Key="4" Value="1"/>
        <Item Key="5" Value="1"/>
      </Dictionary>
      <Dictionary Code="OutWaySub" Default="">
        <Item Key="1" Value="11"/>
        <Item Key="2" Value="12"/>
        <Item Key="3" Value="13"/>
        <Item Key="4" Value="14"/>
        <Item Key="5" Value="15"/>
      </Dictionary>
      <Dictionary Code="Job" Default="">
        <Item Key="工、农技术人员" Value="02" />
        <Item Key="行政办事人员" Value="03" />
        <Item Key="其他办事人员" Value="03"/>
        <Item Key="无业" Value="07" />
        <Item Key="退休" Value="08" />
        <Item Key="学生" Value="09"/>
        <Item Key="军人" Value="10"/>
        <Item Key="不便分类其他劳动者" Value="11"/>
      </Dictionary>
    </Dictionarys>        
  </dictionarySettings>
</configuration>
