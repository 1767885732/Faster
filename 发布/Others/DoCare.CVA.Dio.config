        <Item Key="死胎史" Value="PRA001.07"/>
        <Item Key="死产史" Value="PRA001.07"/>
        <Item Key="早新死史" Value="PRA001.07"/>
        <Item Key="出生缺陷" Value="PRA001.08"/>
        <Item Key="异位妊娠史" Value="PRA001.09"/>
