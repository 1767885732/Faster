<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <generalSettings>
    <add Id="BloodRT.Name" Value="血细胞分析,血细胞分析+全血超敏C反应蛋白测定"></add>
    <add Id="BloodRT.PLT.Name" Value="血小板"></add>
    <add Id="BloodRT.WBC.Name" Value="白细胞计数"></add>
    
    <add Id="CoagulationRT.Name" Value="凝血系列,凝血系列组合"></add>
    <add Id="CoagulationRT.INR.Name" Value="国际标准化比值"></add>
    <add Id="CoagulationRT.APTT.Name" Value="活化部分凝血酶原时间"></add>
    <add Id="CoagulationRT.PT.Name" Value="凝血酶原时间PT"></add>
    <add Id="CoagulationRT.FIB.Name" Value="纤维蛋白原FIB"></add>

    <add Id="BloodLipidAnalysis.Name" Value="甘油三酯,极低密度脂蛋白"></add>
    <add Id="BloodLipidAnalysis.LDL.Name" Value="低密度脂蛋白"></add>
    <add Id="BloodLipidAnalysis.HCY.Name" Value="血同型半胱氨酸"></add>
    
    <add Id="LiverFunction.Name" Value="急诊生化全套"></add>
    <add Id="LiverFunction.ALT.Name" Value="谷丙转氨酶"></add>
    <add Id="LiverFunction.AST.Name" Value="谷草转氨酶"></add>
    <add Id="LiverFunction.CR.Name" Value="肌酐"></add>
    <add Id="LiverFunction.BUN.Name" Value="尿素氮"></add>
    <add Id="LiverFunction.BS.Name" Value="葡萄糖"></add>
    
    <add Id="Inpatient.DisplaySN" Value="0"></add>
    <add Id="Outpatient.DisplaySN" Value="0"></add>
    <add Id="Dio.Debug" Value="false"></add>
  </generalSettings>
  <dictionarySettings>
    <Dictionarys Id="Patient" >
      <Dictionary Code="Gender" Default="">
        <Item Key="男" Value="1" />
        <Item Key="女" Value="2"/>
      </Dictionary>
      <Dictionary Code="ComingType" Default="2">
        <Item Key="1" Value="1" />
        <Item Key="2" Value="2"/>
        <Item Key="3" Value="4"/>
      </Dictionary>
      <Dictionary Code="Sense" Default="">
        <Item Key="0" Value="清晰" />
        <Item Key="1" Value="嗜睡"/>
        <Item Key="2" Value="模糊" />
        <Item Key="3" Value="浅昏迷" />
        <Item Key="4" Value="深昏迷"/>
        <Item Key="5" Value="错乱" />
        <Item Key="6" Value="无" />
      </Dictionary>
      <Dictionary Code="IllnessState" Default="">
        <Item Key="0" Value="濒危" />
        <Item Key="1" Value="危重"/>
        <Item Key="2" Value="急症" />
        <Item Key="3" Value="非急症" />
        <Item Key="4" Value="死亡"/>
      </Dictionary>
      <Dictionary Code="FetalMovement" Default="">
        <Item Key="1" Value="正常"/>
        <Item Key="2" Value="减少" />
        <Item Key="3" Value="消失" />
        <Item Key="4" Value="急剧增加"/>
      </Dictionary>
      <Dictionary Code="OutWay" Default="">
        <Item Key="1" Value="1"/>
        <Item Key="2" Value="1"/>
        <Item Key="3" Value="1"/>
        <Item Key="4" Value="1"/>
        <Item Key="5" Value="1"/>
      </Dictionary>
      <Dictionary Code="OutWaySub" Default="">
        <Item Key="1" Value="11"/>
        <Item Key="2" Value="12"/>
        <Item Key="3" Value="13"/>
        <Item Key="4" Value="14"/>
        <Item Key="5" Value="15"/>
      </Dictionary>
      <Dictionary Code="OutDiagnosis" Default="99">
        <Item Key="凶险型前置胎盘" Value="01"/>
        <Item Key="胎盘早剥" Value="02" />
        <Item Key="产后出血" Value="03" />
        <Item Key="羊水栓塞" Value="04"/>
        <Item Key="子宫破裂" Value="05"/>
        <Item Key="妊娠合并心脏病" Value="06"/>
        <Item Key="妊娠合并肝病" Value="07" />
        <Item Key="妊娠期糖尿病" Value="08" />
        <Item Key="妊娠高血压" Value="09"/>
        <Item Key="早发型重度子癫前期" Value="10" />
      </Dictionary>
    </Dictionarys>

